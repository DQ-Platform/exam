/* ===== aps-js ===== */
var APS_LOGIC=(function(){var L5=["A","B","C","D","E"],LG={L5};LG.ISSUES={no_text:{l:"Sual mətni yoxdur",s:"Mətn yox",w:40,sev:"err"},img_only:{l:"Sual yalnız şəkil kimidir",s:"Yalnız şəkil",w:6,sev:"info"},short_text:{l:"Sual mətni çox qısadır",s:"Qısa mətn",w:10,sev:"warn"},few_opts:{l:"Variantlar çatışmır (A–D)",s:"Variant az",w:25,sev:"err"},dup_opts:{l:"Təkrarlanan variantlar",s:"Eyni variant",w:15,sev:"warn"},no_correct:{l:"Düzgün cavab təyin edilməyib",s:"Cavab yox",w:25,sev:"err"},bad_correct:{l:"Düzgün cavab boş variantdır",s:"Cavab boşdur",w:30,sev:"err"},low_conf:{l:"AI əminliyi aşağıdır",s:"Aşağı əminlik",w:10,sev:"warn"},ai_only:{l:"Cavab yalnız AI təklifidir",s:"AI cavabı",w:8,sev:"info"},mismatch:{l:"AI cavabı mənbə cavabı ilə uyğun deyil",s:"Cavab uyğunsuz",w:25,sev:"err"},dup_q:{l:"Təkrar sual",s:"Təkrar",w:15,sev:"warn"},fig_missing:{l:"Şəkil/cədvəl lazım ola bilər",s:"Şəkil yoxdur?",w:15,sev:"warn"},garbage:{l:"OCR zibili (qeyri-adi simvollar)",s:"OCR səhv",w:15,sev:"warn"}};var FIG_RX=/(şəkil|diaqram|fiqur|qrafik|sxem|cədvəl|xəritə)/i,UNREAD_RX=/^\s*\[[^\]]*oxunmad[^\]]*\]\s*$/i,ODD_RX=/[^\p{L}\p{N}\s.,;:!?()\[\]{}\-+*\/=<>%'"°^_√π∞≤≥≠±×÷–—…«»„“”’|\\&@#$]/gu;return LG.clean=function(s){return String(s??"").normalize("NFC").replace(/\u00ad/g,"").replace(/[ \t\u00a0]+/g," ").split(`
