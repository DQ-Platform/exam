(${i})">👁 Bax</button> <button class="v2-b o s" onclick="V2.printQs(V2.tpls[${i}].questions,V2.tpls[${i}].name)">📄</button> <button class="v2-b o s" onclick="V2.loadTpl(${i})">✏️</button> <button class="v2-b r s" onclick="V2.del('templates',${r._id})">🗑️</button></td></tr>`).join("")}</tbody></table>`:'<div class="v2-empty"><i class="fa-solid fa-award"></i>Hələ şablon yoxdur. Sual bankında suallar seçib «Şablon kimi saxla» basın.</div>'}</div>`}},viewTpl(i){const t=V2.tpls[i],d=document.createElement("div");d.className="v2-modal",d.onclick=e=>{e.target===d&&d.remove()},d.innerHTML=`<div><h3 style="text-align:left">${V2.esc(t.name)} — ${t.questions.length} sual</h3>${t.questions.map((q,k)=>`<div class="v2-var"><b>${k+1}. ${V2.esc(q.text||"🖼️ Şəkilli sual")}</b>${q.qimg?`<br><img class="v2-thumb" src="${q.qimg}">`:""}<div style="font-size:13px;margin-top:4px">${q.type==="open"?"Cavab: "+V2.esc(q.correct):q.opts.map((o,j)=>`<span style="margin-right:10px;${j===q.correct?"color:#059669;font-weight:800":""}">${"ABCDE"[j]}) ${V2.esc(o.text)}${o.img?"🖼️":""}</span>`).join("")}</div></div>`).join("")}<button class="v2-b" onclick="this.closest('.v2-modal').remove()">Bağla</button></div>`,document.body.appendChild(d)},loadTpl(i){confirm("Şablon sual bankı siyahısına yüklənsin? (Cari siyahı əvəz olunacaq)")&&(V2.sel=JSON.parse(JSON.stringify(V2.tpls[i].questions)),V2.saveSel(),V2.go("bank"))},genCode(){const c="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";let s="";for(let i=0;i<5;i++)s+=c[Math.floor(Math.random()*c.length)];return"EX-"+s},async p_start(){const[tpls,ses,stu]=await Promise.all([V2.list("templates"),V2.list("sessions"),_supabase.from("allowed_students").select("student_name,fin")]);return V2.tpls=tpls,V2.chosen=V2.chosen||[],V2.nextCode=V2.nextCode||V2.genCode(),V2.manual=V2.manual||!1,{title:"İmtahan Sessiyası Başlat",sub:"Seçilmiş tələbələr üçün xüsusi imtahan sessiyası başladın. Yalnız seçilən tələbələr bu imtahana daxil ola bilər.",html:`<div class="v2-card" style="max-width:640px"><h3 style="font-size:20px">Yeni İmtahan</h3>
                    <div class="v2-f"><label>İmtahanın Adı (İxtiyari)</label><input class="v2-in" id="x-name" placeholder="Məsələn: Xüsusi Sınaq 1 (BB)"></div>
                    <div class="v2-f mt-3"><label>Təsnifat / Kateqoriya <a href="#" style="float:right;font-size:12px" onclick="V2.manual=!V2.manual;V2.go('start');return false">${V2.manual?"Siyahıdan seç":"Əl ilə yaz (Manuel)"}</a></label>${V2.manual?'<input class="v2-in" id="x-cat" placeholder="Təsnifat">':`<select class="v2-in" id="x-cat">${["BB","BA","AC","BDU"].map(c=>`<option value="${c}">${c} Təsnifatı</option>`).join("")}</select>`}</div>
                    <div class="v2-f mt-3"><label>İmtahan Tipi</label><select class="v2-in" id="x-type"><option>Qəbul tipli imtahan (Seçim)</option><option>Məşq imtahanı</option><option>Yoxlama testi</option></select></div>
                    <div class="v2-f mt-3"><label>İmtahan Şablonları (Ardıcıllıqla Seçin)</label><select class="v2-in" onchange="V2.addChosen(this.value)"><option value="">-- Şablon Əlavə Et --</option>${tpls.map((t,i)=>`<option value="${i}">${V2.esc(t.name)} (${t.questions.length})</option>`).join("")}</select><div class="mt-2">${V2.chosen.map((c,i)=>`<span class="v2-chip">${i+1}. ${V2.esc(c.name)} <a href="#" onclick="V2.chosen.splice(${i},1);V2.go('start');return false">✕</a></span>`).join("")}</div></div>
                    <label class="mt-3" style="display:flex;gap:10px;font-weight:700;font-size:14px"><input type="checkbox" id="x-res" onchange="V2.$('x-stu').style.display=this.checked?'block':'none'"> Yalnız seçilmiş tələbələrin girişinə icazə ver</label>
                    <small class="v2-sub">Bu seçilmədikdə, kripto kodu bilən hər kəs Ad, Soyad və Telefon nömrəsi ilə imtahana girə bilər.</small>
                    <select multiple id="x-stu" class="v2-in" style="display:none;height:120px">${(stu.data||[]).map(s=>`<option value="${V2.esc(s.fin)}">${V2.esc(s.student_name)} (${V2.esc(s.fin)})</option>`).join("")}</select>
                    <div class="v2-f mt-3"><label>İmtahan Müddəti (Dəqiqə)</label><input class="v2-in" id="x-dur" type="number" value="90"><small class="v2-sub">Tələbənin ekranında geri sayan timer bu müddətdən başlayacaq.</small></div>
                    <div class="v2-f mt-3"><label>İmtahana Giriş Növü</label><label style="margin-right:18px"><input type="radio" name="x-entry" value="Kripto kod" checked> Giriş kodu ilə (Kripto kod)</label><label><input type="radio" name="x-entry" value="Şəxsi iş nömrəsi"> Şəxsi iş nömrəsi ilə</label></div>
                    <div class="v2-f mt-3"><label>İmtahan Giriş Kodu (Kripto Kod) <a href="#" style="float:right;font-size:12px" onclick="V2.nextCode=V2.genCode();V2.$('x-code').value=V2.nextCode;return false">Kod Generasiya Et</a></label><input class="v2-in" id="x-code" value="${V2.nextCode}"><small class="v2-sub">Tələbələr bu kodu daxil edərək imtahana girə bilərlər.</small></div>
