                    <div class="v2-main"><h1>${cfg.title||m[2]}</h1>${cfg.sub?`<div class="v2-sub">${cfg.sub}</div>`:""}${V2.mode==="local"?'<div class="v2-sub" style="color:#b45309">⚠️ Lokal rejim: məlumatlar bu brauzerdə saxlanılır. Buluda keçmək üçün <a href="#" onclick="V2.showSql();return false;">SQL quraşdırma</a>.</div>':""}${cfg.html}</div>`,cfg.after&&cfg.after()},showSql(){const d=document.createElement("div");d.className="v2-modal",d.onclick=e=>{e.target===d&&d.remove()},d.innerHTML=`<div><h3 style="text-align:left">Supabase SQL Editor-də icra edin</h3><textarea class="v2-in" rows="7" readonly>${V2.sql}</textarea><p class="v2-sub mt-2">İcradan sonra səhifəni yeniləyin — panel avtomatik buluda keçəcək.</p><button class="v2-b" onclick="this.closest('.v2-modal').remove()">Bağla</button></div>`,document.body.appendChild(d)},fld(f,v){const id="v2f-"+f.k,val=V2.esc(v??""),inp=f.t==="area"?`<textarea class="v2-in" id="${id}" rows="${f.k==="body"?8:3}">${val}</textarea>`:f.t==="sel"?`<select class="v2-in" id="${id}">${f.o.map(o=>`<option ${o===v?"selected":""}>${o}</option>`).join("")}</select>`:f.t==="img"?`<input type="file" accept="image/*" class="v2-in" id="${id}">`:`<input class="v2-in" id="${id}" type="${f.t||"text"}" value="${val}">`;return`<div class="v2-f ${f.full?"v2-full":""}"><label>${f.l}</label>${inp}</div>`},async crud(coll,fields,cols,cfg={}){const rows=await V2.list(coll),cur=V2.editId?rows.find(r=>r._id==V2.editId)||{}:{};return V2.cache={...V2.cache||{},[coll]:rows},`<div class="v2-card"><h3>${V2.editId?"Redaktə":cfg.add||"Yeni qeyd"}</h3><div class="v2-grid">${fields.map(f=>V2.fld(f,cur[f.k])).join("")}</div>
                    <div class="mt-3"><button class="v2-b" onclick="V2.saveCrud('${coll}')"><i class="fa-solid fa-floppy-disk"></i> Yadda saxla</button> ${V2.editId?`<button class="v2-b o" onclick="V2.go('${V2.page}')">Ləğv et</button>`:""}</div></div>
                    <div class="v2-card"><h3>${cfg.list||"Siyahı"} (${rows.length})</h3>${rows.length?`<div class="v2-wrap"><table class="v2-tbl"><thead><tr>${cols.map(c=>`<th>${c[1]}</th>`).join("")}<th></th></tr></thead><tbody>${rows.map(r=>`<tr>${cols.map(c=>`<td>${c[2]?c[2](r[c[0]],r):V2.esc(r[c[0]])}</td>`).join("")}<td style="white-space:nowrap"><button class="v2-b o s" onclick="V2.editId=${r._id};V2.go('${V2.page}')">✏️</button> <button class="v2-b r s" onclick="V2.del('${coll}',${r._id})">🗑️</button></td></tr>`).join("")}</tbody></table></div>`:'<div class="v2-empty"><i class="fa-regular fa-folder-open"></i>Hələ qeyd yoxdur</div>'}</div>`},async saveCrud(coll){const spec=V2.specs[coll],obj={},old=V2.editId?(V2.cache[coll]||[]).find(r=>r._id==V2.editId):null;for(const f of spec)if(f.t==="img"){const el=V2.$("v2f-"+f.k);obj[f.k]=el.files[0]?await readUniversalFile(el.files[0]):old?old[f.k]:null}else obj[f.k]=V2.val("v2f-"+f.k);const need=spec.find(f=>f.req&&!obj[f.k]);if(need){alert(`"${need.l}" xanası məcburidir.`);return}old?obj.date=old.date:obj.date=V2.date(),await V2.put(coll,obj,V2.editId),V2.toast("Yadda saxlanıldı ✅"),V2.editId=null,V2.go(V2.page)},statusTag:s=>`<span class="v2-tag" style="background:${{Gözləyir:"#fef3c7",Hazırlanır:"#dbeafe",Göndərildi:"#e0e7ff",Çatdırıldı:"#dcfce7",Ləğv:"#fee2e2"}[s]||"#eee"}">${V2.esc(s)}</span>`,async pageHtml(p){return V2.specs={news:[{k:"title",l:"Başlıq",req:1,full:1},{k:"kind",l:"Növ",t:"sel",o:["Xəbər","Elan","İmtahan elanı"]},{k:"pub",l:"Tarix",t:"date"},{k:"body",l:"Mətn",t:"area",full:1,req:1},{k:"img",l:"Şəkil (istəyə görə)",t:"img"}]},await V2["p_"+p]()},async p_dash(){const cnt=async t=>(await _supabase.from(t).select("id",{count:"exact",head:!0})).count||0,[q,u,r,fb,stu]=await Promise.all([cnt("exam_questions"),cnt("allowed_students"),cnt("exam_results"),V2.list("feedback"),_supabase.from("allowed_students").select("student_name,fin").order("id",{ascending:!1}).limit(10)]),shown=fb.filter(x=>x.show).length,st=(t,n,s,c)=>`<div class="v2-card v2-stat"><span>${t}</span><b>${n}</b><small style="color:${c}">${s}</small></div>`,rows=stu.data||[];return{title:"İdarəetmə Paneli",html:`<div class="v2-stats">${st("Ümumi İştirakçı",u,"Qeydiyyatdan keçən","#10b981")}${st("İmtahan Sualları",q,"Suallar bazası","#1e1b4b")}${st("İştirakçı Rəyləri",fb.length,shown+" qeydiyyat ekranında","#d97706")}${st("İmtahan Sessiyası",r,"Ümumi cəhdlər","#a16207")}</div>
                    <h3 style="text-align:left;margin-bottom:12px;font-size:20px">Qeydiyyatdan Keçən İştirakçılar</h3><div class="v2-card v2-wrap"><table class="v2-tbl"><thead><tr><th>Ad Soyad</th><th>FİN Kod</th></tr></thead><tbody>${rows.map(o=>`<tr><td>${V2.esc(o.student_name)}</td><td><b>${V2.esc(o.fin)}</b></td></tr>`).join("")||'<tr><td colspan="2" class="v2-empty">İştirakçı yoxdur</td></tr>'}</tbody></table>${u>10?`<div class="mt-2"><a href="#" onclick="V2.go('users');return false">Hamısına bax (${u}) →</a></div>`:""}</div>`}},async p_users(){const{data}=await _supabase.from("allowed_students").select("*").order("id",{ascending:!1}),rows=data||[];return{title:"İstifadəçilər",sub:"İmtahana icazə verilmiş tələbələr (mövcud baza ilə eyni cədvəl).",html:`<div class="v2-card"><h3>Yeni icazə</h3><div class="v2-grid"><div class="v2-f"><label>Ad, Soyad</label><input class="v2-in" id="u-name"></div><div class="v2-f"><label>FİN / İş nömrəsi</label><input class="v2-in" id="u-fin"></div><div class="v2-f"><label>Sınaq №</label><input class="v2-in" id="u-exam" type="number" value="1"></div><div class="v2-f"><label>Kateqoriyalar</label><div style="padding:10px 0">${["BA","BB","AC"].map(c=>`<label style="margin-right:12px"><input type="checkbox" class="u-cat" value="${c}"> ${c}</label>`).join("")}</div></div></div><div class="mt-3"><button class="v2-b" onclick="V2.addUser()">➕ Əlavə et</button></div></div>
                    <div class="v2-card"><h3>Siyahı (${rows.length})</h3><input class="v2-in mb-3" placeholder="🔍 Axtar..." oninput="document.querySelectorAll('#u-body tr').forEach(r=>r.style.display=r.innerText.toLowerCase().includes(this.value.toLowerCase())?'':'none')"><div class="v2-wrap"><table class="v2-tbl"><thead><tr><th>Ad</th><th>FİN</th><th>Sınaq</th><th>Kateqoriya</th><th></th></tr></thead><tbody id="u-body">${rows.map(r=>`<tr><td>${V2.esc(r.student_name)}</td><td>${V2.esc(r.fin)}</td><td>${V2.esc(r.exam_no)}</td><td>${(r.categories||[]).map(c=>`<span class="v2-tag">${c}</span>`).join(" ")}</td><td><button class="v2-b r s" onclick="V2.delUser(${r.id})">🗑️</button></td></tr>`).join("")}</tbody></table></div></div>`}},async addUser(){const cats=[...document.querySelectorAll(".u-cat:checked")].map(c=>c.value),name=V2.val("u-name"),fin=V2.val("u-fin").toUpperCase();if(!name||fin.length<5||!cats.length){alert("Bütün xanaları doldurun, kateqoriya seçin.");return}const{error}=await _supabase.from("allowed_students").insert([{student_name:name,fin,exam_no:V2.val("u-exam"),categories:cats}]);error?alert(error.message):(V2.toast("Əlavə olundu ✅"),V2.go("users"),window.DQSHARE&&DQSHARE.open({name:name,fin:fin,exams:[{no:V2.val("u-exam")||"1",cats:cats}]}))},async delUser(id){confirm("Silinsin?")&&(await _supabase.from("allowed_students").delete().eq("id",id),V2.go("users"))},async p_news(){return{title:"Xəbər / Elan Əlavə Et",html:await V2.crud("news",V2.specs.news,[["title","Başlıq"],["kind","Növ",v=>`<span class="v2-tag">${v}</span>`],["pub","Tarix"],["img","Şəkil",v=>v?`<img class="v2-thumb" style="max-height:40px" src="${v}">`:"—"]],{add:"Yeni xəbər / elan",list:"Dərc olunanlar"})}},async p_res(){const[fb,{data:rs}]=await Promise.all([V2.list("feedback"),_supabase.from("exam_results").select("student_name,fin,exam_no,category,score,correct_count,wrong_count,created_at").order("created_at",{ascending:!1}).limit(200)]);V2.fbs=fb;const rows=rs||[],stars=n=>"★".repeat(n||0)+"☆".repeat(5-(n||0));return{title:"İştirakçı Nəticələri və Rəylər",sub:"İmtahanı bitirən iştirakçıların nəticələri və təəssüratları. Xoşunuza gələn rəyləri «Qeydiyyat ekranında göstər» ilə əlavə edin, istəsəniz mətni annotasiya kimi redaktə edin.",html:`
                    <div class="v2-card"><h3>Təəssürat / Rəylər (${fb.length})</h3>${fb.length?fb.map((f,i)=>`<div class="v2-var"><div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap"><b>${V2.esc(f.name)} <span class="v2-tag">${V2.esc(f.category||"")}</span> ${f.score!=null?`<span class="v2-tag">${V2.esc(f.score)} bal</span>`:""}</b><span style="color:#d97706;letter-spacing:2px">${stars(f.rating)}</span></div>
                        <textarea class="v2-in mt-2" id="fb-t-${i}" rows="2">${V2.esc(f.shown_text??f.text)}</textarea>
                        <small class="v2-sub">İştirakçının orijinal yazısı: ${V2.esc(f.text||"—")}</small>
                        <div class="mt-2" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center"><label style="font-weight:700;font-size:13px"><input type="checkbox" id="fb-s-${i}" ${f.show?"checked":""}> Qeydiyyat ekranında göstər</label><button class="v2-b s" onclick="V2.saveFb(${i})">💾 Yadda saxla</button><button class="v2-b r s" onclick="V2.del('feedback',${f._id})">🗑️</button></div></div>`).join(""):'<div class="v2-empty"><i class="fa-regular fa-comments"></i>Hələ rəy yoxdur</div>'}
                        <h3 style="margin-top:18px">Əl ilə təəssürat əlavə et</h3><div class="v2-grid"><div class="v2-f"><label>Ad</label><input class="v2-in" id="fbm-name"></div><div class="v2-f"><label>Qiymət (1-5)</label><input class="v2-in" id="fbm-rate" type="number" min="1" max="5" value="5"></div><div class="v2-f v2-full"><label>Təəssürat</label><textarea class="v2-in" id="fbm-text" rows="2"></textarea></div></div><div class="mt-2"><button class="v2-b" onclick="V2.addFb()">➕ Əlavə et və göstər</button></div></div>
                    <div class="v2-card"><h3>İştirakçı Nəticələri (${rows.length})</h3>${rows.length?`<div class="v2-wrap"><table class="v2-tbl"><thead><tr><th>Ad Soyad</th><th>FİN</th><th>Sınaq</th><th>Kateqoriya</th><th>Doğru</th><th>Yanlış</th><th>Bal</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${V2.esc(r.student_name)}</td><td>${V2.esc(r.fin)}</td><td>Sınaq ${V2.esc(r.exam_no)}</td><td><span class="v2-tag">${V2.esc(r.category||"BA")}</span></td><td style="color:#059669;font-weight:800">${r.correct_count}</td><td style="color:#dc2626;font-weight:800">${r.wrong_count}</td><td><b>${r.score}</b></td></tr>`).join("")}</tbody></table></div>`:'<div class="v2-empty"><i class="fa-regular fa-folder-open"></i>Hələ nəticə yoxdur</div>'}</div>`}},async saveFb(i){const f=V2.fbs[i];f.shown_text=V2.val("fb-t-"+i),f.show=V2.$("fb-s-"+i).checked,await V2.put("feedback",f,f._id),V2.toast("Saxlanıldı ✅"),V2.go("res")},async addFb(){const t=V2.val("fbm-text"),n=V2.val("fbm-name");if(!t||!n){alert("Ad və təəssürat yazın.");return}await V2.put("feedback",{name:n,rating:Math.min(5,Math.max(1,parseInt(V2.val("fbm-rate"))||5)),text:t,show:!0,date:V2.date()}),V2.toast("Əlavə olundu ✅"),V2.go("res")},async p_set(){const d=(await V2.list("settings"))[0]||{};V2.editId=d._id||null;const F=[["title","Sayt Başlığı (Title)"],["email","Əlaqə Emaili"],["phone","Əlaqə Telefonu"],["wa","WhatsApp Əlaqə (nömrə və ya wa.me linki)"],["wach","WhatsApp Kanal Linki"],["addr","Xəritə/Ünvan Mətni",1],["ig","Instagram Linki"],["tg","Telegram Linki"]],f=x=>`<div class="v2-f ${x[2]?"v2-full":""}"><label>${x[1]}</label><input class="v2-in" id="s-${x[0]}" value="${V2.esc(d[x[0]])}"></div>`;return{title:"Sayt Tənzimləmələri",html:`<div class="v2-card"><div class="v2-grid">${F.slice(0,6).map(f).join("")}<h3 class="v2-full" style="margin-top:10px">Sosial Şəbəkələr</h3>${F.slice(6).map(f).join("")}</div><button class="v2-b mt-4" style="width:100%" onclick="V2.saveSet()"><i class="fa-solid fa-floppy-disk"></i> Tənzimləmələri Yadda Saxla</button></div>`}},async saveSet(){const o={};["title","email","phone","wa","wach","addr","ig","tg"].forEach(k=>o[k]=V2.val("s-"+k).replace(/[`'"]/g,"").trim()),await V2.put("settings",o,V2.editId),V2.toast("Tənzimləmələr saxlanıldı ✅")},saveSel(){try{localStorage.setItem("dq_v2_sel",JSON.stringify(V2.sel))}catch{alert("Yaddaş dolub — şablon kimi saxlayıb siyahını təmizləyin.")}},selList(){const n=V2.sel.length;return`<div class="v2-card"><h3>Şablon Üçün Seçilmiş Suallar (${n})</h3>${n?V2.sel.map((q,i)=>`<div class="v2-var"><div style="display:flex;justify-content:space-between;gap:8px"><b>${i+1}. ${V2.esc(q.text||(q.qimg?"🖼️ Şəkilli sual":""))}</b><span class="v2-tag">${q.cat}</span></div>${q.qimg?`<img class="v2-thumb" src="${q.qimg}">`:""}<div style="font-size:13px;margin-top:6px">${q.type==="open"?"Cavab: <b>"+V2.esc(q.correct)+"</b>":q.opts.map((o,k)=>`<span style="margin-right:12px;${k===q.correct?"color:#059669;font-weight:800":""}">${"ABCDE"[k]}) ${o.img?"🖼️":""} ${V2.esc(o.text)}</span>`).join("")}</div><div class="mt-2"><button class="v2-b o s" onclick="V2.editSel(${i})">✏️</button> <button class="v2-b o s" onclick="V2.moveSel(${i},-1)">↑</button> <button class="v2-b o s" onclick="V2.moveSel(${i},1)">↓</button> <button class="v2-b r s" onclick="V2.delSel(${i})">🗑️</button></div></div>`).join("")+'<div class="v2-grid mt-3"><input class="v2-in" id="tpl-name" placeholder="Şablon adı"><button class="v2-b g" onclick="V2.saveTpl()">📋 Şablon kimi saxla</button></div>':'<div class="v2-empty"><i class="fa-regular fa-file-lines"></i>Hələ ki, heç bir sual əlavə edilməyib.<br><small>PDF-dən kəsərək siyahıya sual daxil edin.</small></div>'}</div>`},toolbar:()=>`<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px"><button class="v2-b o" onclick="V2.exportJson()">📤 Sualları JSON kimi ixrac et</button><button class="v2-b o" onclick="V2.printQs(V2.sel,'Sual Bankı')">📄 Sualları PDF kimi ixrac et</button><button class="v2-b" onclick="V2.$('v2-imp').click()">📥 Sualları İdxal Et (JSON)</button><input type="file" id="v2-imp" accept=".json" style="display:none" onchange="V2.importJson(this)"></div>`,exportJson(){const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([JSON.stringify(V2.sel,null,2)],{type:"application/json"})),a.download="sual-banki.json",a.click()},importJson(inp){const f=inp.files[0];if(!f)return;const r=new FileReader;r.onload=()=>{try{const d=JSON.parse(r.result);if(!Array.isArray(d))throw 0;V2.sel=V2.sel.concat(d),V2.saveSel(),V2.toast(d.length+" sual idxal olundu ✅"),V2.go(V2.page)}catch{alert("JSON faylı yararsızdır.")}},r.readAsText(f)},printQs(list,title){if(!list.length){alert("Sual yoxdur.");return}const w=window.open("","_blank");if(!w){alert("Pop-up bloklanıb.");return}w.document.write(`<html><head><meta charset="utf-8"><title>${V2.esc(title)}</title><style>body{font-family:Arial;padding:24px}img{max-width:100%;max-height:200px}.q{margin-bottom:18px;page-break-inside:avoid}</style></head><body><h2>${V2.esc(title)}</h2>${list.map((q,i)=>`<div class="q"><b>${i+1}. ${V2.esc(q.text)}</b><br>${q.qimg?`<img src="${q.qimg}"><br>`:""}${q.type==="open"?"":q.opts.map((o,k)=>`${"ABCDE"[k]}) ${V2.esc(o.text)} ${o.img?`<img src="${o.img}">`:""}<br>`).join("")}<small>Düzgün cavab: ${q.type==="open"?V2.esc(q.correct):"ABCDE"[q.correct]}${q.note?" — "+V2.esc(q.note):""}</small></div>`).join("")}</body></html>`),w.document.close(),setTimeout(()=>w.print(),500)},moveSel(i,d){const j=i+d;j<0||j>=V2.sel.length||([V2.sel[i],V2.sel[j]]=[V2.sel[j],V2.sel[i]],V2.saveSel(),V2.go(V2.page))},delSel(i){V2.sel.splice(i,1),V2.saveSel(),V2.go(V2.page)},editSel(i){V2.edit=i;const q=V2.sel[i];q.b2?(V2.b2=JSON.parse(JSON.stringify(q.b2)),V2.go("bank2")):V2.go("bank")},async saveTpl(){const name=V2.val("tpl-name");if(!name){alert("Şablon adını yazın.");return}const cats=[...new Set(V2.sel.map(q=>q.cat))];await V2.put("templates",{name,cat:cats.join("/"),questions:V2.sel,date:V2.date()}),V2.toast("Şablon yaradıldı ✅")},async p_bank(){const q=V2.edit>-1?V2.sel[V2.edit]:null;q&&(V2.qType=q.type,V2.hasE=q.opts&&q.opts.length>4);const t=V2.qType,opt=i=>`<div class="v2-f"><label>Variant ${"ABCDE"[i]}</label><textarea class="v2-in b-opt" rows="2" placeholder="Variant ${"ABCDE"[i]} mətni">${q&&q.opts&&q.opts[i]?V2.esc(q.opts[i].text):""}</textarea></div>`;return{title:"Sual Bankı (PDF ilə yükləmə)",html:V2.toolbar()+`<div class="v2-card"><h3>PDF Sual Bankı Oxuyucu (OCR)</h3><div class="v2-drop" onclick="V2.$('b-file').click()"><i class="fa-solid fa-upload"></i><div><b>İmtahan PDF faylını yükləyin</b></div><small id="b-ocr" style="color:#64748b">Faylı seçmək üçün bura klikləyin (Avtomatik OCR oxunacaq)</small></div><input type="file" id="b-file" accept="application/pdf,image/*" style="display:none" onchange="V2.ocr(this)"></div>
                    <div class="v2-card"><h3>Sual Detalları Redaktoru</h3><div class="v2-tabs"><div class="${t==="mcq"?"on":""}" onclick="V2.qType='mcq';V2.go('bank')">Çoxvariantlı (A–E)</div><div class="${t==="open"?"on":""}" onclick="V2.qType='open';V2.go('bank')">Açıq Sual (1–6)</div></div>
                    <div class="v2-f"><label>Oxunan Sual Mətni</label><textarea class="v2-in" id="b-text" rows="5" placeholder="PDF-dən oxunan sual mətni bura düşəcək...">${q?V2.esc(q.text):""}</textarea><small class="v2-sub">Sual mətni abzas kimi yazılsın. Variantlar ayrı sətirdə (məsələn A) B) C) D)) olsun.</small></div>
                    ${t==="mcq"?`<div class="v2-grid mt-3">${[0,1,2,3].map(opt).join("")}${V2.hasE?opt(4):""}</div>${V2.hasE?"":`<button class="v2-b o s mt-2" onclick="V2.hasE=true;V2.keepText();V2.go('bank')">+ E Variantı Əlavə Et</button>`}
                    <div class="v2-grid mt-3"><div class="v2-f"><label>Düzgün Cavab</label><select class="v2-in" id="b-corr"><option value="">Seçin...</option>${"ABCDE".slice(0,V2.hasE?5:4).split("").map((c,i)=>`<option value="${i}" ${q&&q.correct===i?"selected":""}>${c}</option>`).join("")}</select></div>`:`<div class="v2-grid mt-3"><div class="v2-f"><label>Düzgün Cavab (mətn/rəqəm)</label><input class="v2-in" id="b-corr" value="${q?V2.esc(q.correct):""}"></div>`}
                    <div class="v2-f"><label>Təsnifat</label><select class="v2-in" id="b-cat">${["BB","BA","AC","BDU"].map(c=>`<option ${q&&q.cat===c?"selected":""}>${c}</option>`).join("")}</select></div></div>
                    <div class="v2-f mt-3"><label>Qanunvericilik İzahı (Şərh)</label><textarea class="v2-in" id="b-note" rows="3" placeholder="Bu sualın düzgün cavabının hüquqi əsaslandırması (maddə və şərh)...">${q?V2.esc(q.note||""):""}</textarea></div>
                    <div class="mt-4" style="display:flex;gap:10px"><button class="v2-b" style="flex:1" onclick="V2.addQ()">➕ Suala Düzəliş Et və Siyahıya Sal</button><button class="v2-b o" onclick="V2.edit=-1;V2.hasE=false;V2.go('bank')">Təmizlə</button></div></div>`+V2.selList()}},keepText(){V2._t=V2.val("b-text")},addQ(){const text=V2.val("b-text"),t=V2.qType,corr=V2.val("b-corr"),old=V2.edit>-1?V2.sel[V2.edit]:{};if(!text){alert("Sual mətnini daxil edin.");return}if(corr===""){alert("Düzgün cavabı seçin.");return}const q={type:t,text,cat:V2.val("b-cat"),note:V2.val("b-note"),qimg:old.qimg||null};if(t==="mcq"){if(q.opts=[...document.querySelectorAll(".b-opt")].map((e,i)=>({text:e.value.trim(),img:old.opts&&old.opts[i]?old.opts[i].img:null})),q.opts.some(o=>!o.text)){alert("Bütün variantları doldurun.");return}q.correct=parseInt(corr)}else q.correct=corr.toUpperCase();V2.edit>-1?V2.sel[V2.edit]=q:V2.sel.push(q),V2.edit=-1,V2.hasE=!1,V2.saveSel(),V2.toast("Siyahıya əlavə olundu ✅"),V2.go("bank")},async ocr(inp){const f=inp.files[0];if(!f)return;const s=V2.$("b-ocr");s.innerText="Fayl oxunur...";try{const img=await readUniversalFile(f),lines=(await Tesseract.recognize(img,"aze",{logger:m=>{m.status==="recognizing text"&&(s.innerText="OCR: "+Math.round(m.progress*100)+"%")}})).data.text.split(`
