 /* ---------- İCMAL ---------- */
 p_home(){var D=Y.D,mem=D.ysl2_group.reduce(function(a,g){return a+(g.members||[]).length},0);
  return '<h1>Xoş gəldiniz!</h1><p class="y2-sub">Suallarınızı, quizlərinizi və nəticələri idarə edin.</p><div class="y2-st">'+st("Sual bankı",D.ysl2_q.length,"sual")+st("Quizlər",D.ysl2_quiz.length,"quiz")+st("İmtahanlar",D.ysl2_exam.length,"imtahan")+st("Tələbələr",mem,"tələbə")+'</div><div class="y2-row"><h2>Sürətli əməliyyatlar</h2><div class="y2-act"><button class="y2-b" onclick="Y2.quizForm()">+ Yeni quiz</button><button class="y2-b o" onclick="Y2.qForm()">+ Yeni sual</button><button class="y2-b o" onclick="Y2.go(\'pdf\')">✦ PDF-dən sual idxalı</button></div></div><h2>Son quizlər</h2>'+Y.quizTbl(D.ysl2_quiz.slice(0,5),false)},
 /* ---------- SUAL BANKI ---------- */
 p_bank(){var D=Y.D,t=Y.tab,h='<h1>Sual Bankı</h1><p class="y2-sub">Təyin olunmuş fənlər üzrə sualların siyahısı və axtarışı.</p><div class="y2-act"><button class="y2-b o" onclick="Y2.go(\'pdf\')">✦ PDF-dən sual idxalı</button><button class="y2-b o" onclick="Y2.qForm()">+ Yeni sual</button><button class="y2-b o" onclick="Y2.pkgForm()">Paket yarat</button><button class="y2-b o" onclick="Y2.psel=!Y2.psel;Y2.pids={};Y2.tab=\'pk\';Y2.draw()">'+(Y.psel?"✓ Seçimi bitir":"☑ Paket seç")+'</button></div>';
  h+='<div class="y2-tabs">'+[["pk","Sual Paketləri ("+D.ysl2_pkg.length+")"],["qs","Suallar ("+D.ysl2_q.length+")"],["lib","Kitabxana"]].map(function(x){return '<button class="'+(t===x[0]?"on":"")+'" onclick="Y2.tab=\''+x[0]+'\';Y2.draw()">'+x[1]+'</button>'}).join("")+'</div>';
  if(t==="pk")h+=(Y.psel&&Object.keys(Y.pids).length?'<div class="y2-act"><button class="y2-b r s" onclick="Y2.pkDel()">Seçilənləri sil ('+Object.keys(Y.pids).length+')</button></div>':'')+(D.ysl2_pkg.length?D.ysl2_pkg.map(function(p){var k=Y.psel?' onclick="Y2.pkTog('+JSON.stringify(p._id)+')" style="cursor:pointer"':"";return '<div class="y2-card y2-row'+(Y.pids[String(p._id)]?" y2-sel":"")+'"'+k+'><div>'+(Y.psel?'<input type="checkbox" '+(Y.pids[String(p._id)]?"checked":"")+' style="margin-right:8px">':"")+'<b>'+e(p.name)+'</b><div class="y2-mut">'+p.qs.length+' sual · '+fd(p.ts)+(p.qs.length===100?' · <span class="y2-chip s-ready">100 aktiv</span>':'')+'</div></div>'+(Y.psel?'':'<button class="y2-b r s" onclick="Y2.del(\'ysl2_pkg\','+JSON.stringify(p._id)+')">Sil</button>')+'</div>'}).join(""):'<div class="y2-empty"><b>Hələ sual paketi yoxdur.</b><p>PDF və ya DOCX idxal etdikdən sonra təsdiqlənmiş suallardan paket yaradın.</p><button class="y2-b" onclick="Y2.go(\'pdf\')">PDF-dən sual idxalı</button></div>');
  if(t==="qs")h+='<input class="y2-in" placeholder="Sual axtar..." oninput="Y2.filt(this,\'.y2-bq\')">'+(D.ysl2_q.length?D.ysl2_q.map(function(q){return '<div class="y2-card y2-bq"><div class="y2-tags"><span class="y2-chip b">'+e(q.subj)+'</span>'+(q.topic&&q.topic!==q.subj?'<span class="y2-chip">'+e(q.topic)+'</span>':'')+'</div><p class="y2-qt">'+e(q.q)+'</p>'+(q.img?'<img src="'+q.img+'" alt="" style="max-width:100%;max-height:260px">':"")+(q.type==="open"?'<div class="y2-opt c"><b>Cavab</b> '+e(q.ans||"—")+'</div>':'<div class="y2-opts">'+q.opts.map(function(o,j){return '<div class="y2-opt '+(q.correct===j?"c":"")+'"><b>'+L[j]+'</b> '+e(o)+'</div>'}).join("")+'</div>')+'<div class="y2-act"><button class="y2-b o s" onclick="Y2.edBank('+JSON.stringify(q._id)+')">Redaktə et</button><button class="y2-b r s" onclick="Y2.del(\'ysl2_q\','+JSON.stringify(q._id)+')">Sil</button></div></div>'}).join(""):'<div class="y2-empty">Bankda sual yoxdur.</div>');
  if(t==="lib"){var vis=D.ysl2_topic.filter(function(p){return Y.showH||!p.hidden}),hc=D.ysl2_topic.filter(function(p){return p.hidden}).length;
   h+='<input class="y2-in" placeholder="Kitabxanada quiz axtar..." oninput="Y2.filt(this,\'.y2-tp\')"><p class="y2-mut">'+(D.ysl2_quiz.length?"":"Kitabxanada hələ quiz yoxdur. Quizlər bölməsində mövzu seçərək quiz yaradın.")+'</p><div class="y2-card"><span class="y2-chip b">KURS KİTABXANASI</span><h2>Quizlərinizi mövzulara ayırın</h2><div class="y2-row"><div><span class="y2-mut">Mövzu</span> <b style="font-size:26px">'+D.ysl2_topic.filter(function(p){return !p.hidden}).length+'</b> &nbsp; <span class="y2-mut">Quiz</span> <b style="font-size:26px">'+D.ysl2_quiz.length+'</b></div><button class="y2-b" onclick="Y2.topicForm()">+ Yeni mövzu</button></div></div><div class="y2-info">Quiz yaradanda mövzu seçin, o dərhal burada görünür.</div><h2 style="cursor:pointer" onclick="Y2.mg=!Y2.mg;Y2.draw()">'+(Y.mg?"▾":"▸")+' Mövzuları idarə et</h2>';
   if(Y.mg){h+='<div class="y2-act" style="margin:0 0 10px"><button class="y2-b o s" onclick="Y2.topicForm()">+ Yeni mövzu</button>'+(hc?'<button class="y2-b o s" onclick="Y2.showH=!Y2.showH;Y2.draw()">'+(Y.showH?"Gizlədilənləri gizlət":"Gizlədilənlər ("+hc+")")+'</button>':"")+'</div>';
    h+=vis.length?vis.map(function(p){var n=D.ysl2_quiz.filter(function(q){return q.topic===p.name}).length,id=JSON.stringify(p._id),ask=String(Y.tAsk)===String(p._id);return '<div class="y2-card y2-tp'+(p.hidden?" y2-hid":"")+'"><div class="y2-row"><div><b>'+e(p.name)+'</b><div class="y2-mut">'+e(p.subj)+' · '+(n?n+" quiz":"Quiz yoxdur")+(p.hidden?" · gizlidir":"")+'</div></div>'+(p.hidden?'<button class="y2-b o s" onclick="Y2.tShow('+id+')">Bərpa et</button>':ask?'<div class="y2-act" style="margin:0"><span class="y2-mut">Mövzu gizlədilsin?</span><button class="y2-b r s" onclick="Y2.tHide('+id+')">Gizlət</button><button class="y2-b o s" onclick="Y2.tAsk=null;Y2.draw()">Ləğv et</button></div>':'<div class="y2-act" style="margin:0"><button class="y2-b o s" aria-label="Adı dəyiş" onclick="Y2.renTopic('+id+')"><i class="fa-solid fa-pen"></i></button><button class="y2-b o s" aria-label="Gizlət" onclick="Y2.tAsk='+id+';Y2.draw()"><i class="fa-solid fa-trash"></i></button></div>')+'</div>'+(n?"":'<div class="y2-mut" style="margin-top:8px">Bu mövzuda hələ quiz yoxdur.</div>')+'<a class="y2-lk" onclick="Y2.go(\'quiz\')">Quizlərə keç →</a></div>'}).join(""):'<div class="y2-empty">Hələ mövzu yoxdur.</div>'}}
  return h},
 topicForm(){Y.modal('<h3>Yeni Mövzu Əlavə Et</h3><label>Aid olduğu fənn</label><select id="y2-ts" class="y2-in">'+SUBJ.map(function(s){return "<option>"+s+"</option>"}).join("")+'</select><label>Mövzu adı</label><input id="y2-tn" class="y2-in" placeholder="Məs. Azərbaycan Respublikasının Konstitusiyası"><div class="y2-act"><button class="y2-b o" onclick="Y2.cm()">İmtina</button><button class="y2-b" onclick="Y2.topicSave()">Mövzunu yarat</button></div>')},
 async topicSave(){var n=$("y2-tn").value.trim();if(!n)return alert("Mövzu adı yazın.");if(Y.D.ysl2_topic.some(function(p){return p.name.toLowerCase()===n.toLowerCase()&&p.subj===$("y2-ts").value}))return alert("Bu fənn üzrə həmin adlı mövzu artıq var.");await V2.put("ysl2_topic",{name:n,subj:$("y2-ts").value});V2.toast("Mövzu uğurla yaradıldı ✅");Y.cm();Y.tab="lib";Y.go("bank")},
 async renTopic(id){var p=Y.D.ysl2_topic.find(function(x){return String(x._id)===String(id)}),n=prompt("Yeni ad:",p.name);if(!n||!n.trim())return;Y.D.ysl2_quiz.filter(function(q){return q.topic===p.name}).forEach(function(q){V2.put("ysl2_quiz",Object.assign({},q,{topic:n.trim()}),q._id)});await V2.put("ysl2_topic",Object.assign({},p,{name:n.trim()}),id);Y.go("bank")},
 /* ---------- SUAL FORMASI ---------- */
 qModal(q,cb,title,need){Y._cb=cb;Y._need=need;var o=q.opts||[];Y.modal('<h3>'+title+'</h3><label>Fənn</label><select id="y2-qs" class="y2-in">'+SUBJ.map(function(s){return "<option "+(s===q.subj?"selected":"")+">"+s+"</option>"}).join("")+'</select><label>Sual mətni</label><textarea id="y2-qt" class="y2-in" rows="4">'+e(q.q||"")+'</textarea><label>Variantlar (düzgün olanı seçin)</label>'+[0,1,2,3,4].map(function(j){return '<div class="y2-orow"><input type="radio" name="y2-cr" value="'+j+'" '+(q.correct===j?"checked":"")+'><b>'+L[j]+'</b><input class="y2-in" id="y2-o'+j+'" value="'+e(o[j]||"")+'" placeholder="Variant '+L[j]+(j===4?" (ixtiyari)":"")+'"></div>'}).join("")+'<div class="y2-act"><button class="y2-b" onclick="Y2.qSave()">Yadda saxla</button><button class="y2-b o" onclick="Y2.cm()">İmtina</button></div>')},
 qSave(){var o=[0,1,2,3,4].map(function(j){return $("y2-o"+j).value.trim()});while(o.length&&!o[o.length-1])o.pop();var q=$("y2-qt").value.trim(),r=document.querySelector("input[name=y2-cr]:checked"),c=r?+r.value:-1;
  if(!q||o.length<2)return alert("Sual mətni və ən azı 2 variant lazımdır.");if(c>=o.length)return alert("Düzgün cavab boş variantdır.");if(Y._need&&c<0)return alert("Düzgün cavabı seçin.");
  var cb=Y._cb,s=$("y2-qs").value;Y.cm();cb({q:q,opts:o,correct:c,subj:s})},
 qForm(){Y.qModal({subj:SUBJ[0],opts:["","","",""],correct:-1},async function(u){await V2.put("ysl2_q",Object.assign({},u,{topic:u.subj,imp:"əl ilə"}));V2.toast("Sual əlavə olundu ✅");Y.page="bank";Y.tab="qs";Y.go("bank")},"Yeni sual",true)},
 edBank(id){var r=Y.D.ysl2_q.find(function(x){return String(x._id)===String(id)});if(r.type==="open"){var a=prompt("Düzgün cavab:",r.ans||"");if(a===null||!a.trim())return;return V2.put("ysl2_q",Object.assign({},r,{ans:a.trim()}),id).then(function(){Y.go("bank")})}Y.qModal(r,async function(u){await V2.put("ysl2_q",Object.assign({},r,u),id);Y.go("bank")},"Sualı redaktə et",true)},
 pick(qs,n){return '<div class="y2-pick">'+(qs.map(function(q,i){return '<label><input type="checkbox" name="'+n+'" value="'+i+'"><span><b>'+e(q.subj||"")+'</b> '+e(String(q.q).slice(0,90))+'</span></label>'}).join("")||'<p class="y2-mut">Bankda təsdiqlənmiş sual yoxdur.</p>')+'</div>'},
 picked(qs,n){return Array.prototype.map.call(document.querySelectorAll("input[name="+n+"]:checked"),function(i){return qs[+i.value]}).map(cp)},
 pkgForm(){Y.modal('<h3>Yeni sual paketi</h3><label>Paket adı</label><input id="y2-pn" class="y2-in" placeholder="Məs. Sınaq 1 (100 sual)"><label>Suallar</label>'+Y.pick(Y.D.ysl2_q,"y2-pp")+'<div class="y2-act"><button class="y2-b" onclick="Y2.pkgSave()">Paketi yarat</button><button class="y2-b o" onclick="Y2.cm()">İmtina</button></div>')},
 async pkgSave(){var n=$("y2-pn").value.trim(),qs=Y.picked(Y.D.ysl2_q,"y2-pp");if(!n||!qs.length)return alert("Ad yazın və sual seçin.");await V2.put("ysl2_pkg",{name:n,qs:qs,ts:new Date().toISOString()});Y.cm();V2.toast("Paket yaradıldı ✅");Y.tab="pk";Y.go("bank")},
 /* ---------- PDF İDXALI (AI) ---------- */
 p_pdf(){if(Y.view==="rev"&&Y.imp)return Y.review();var I=Y.D.ysl2_imp,tot=I.reduce(function(a,x){return a+x.qs.length},0),ap=I.reduce(function(a,x){return a+x.qs.filter(function(q){return q.st==="ok"}).length},0),m=localStorage.getItem("ysl2_model")||"gemini-2.5-flash";
  return '<span class="y2-chip b">SÜNİ İNTELLEKT</span> <span class="y2-mut">Google '+e(m)+'</span><h1>PDF-dən Sual İdxalı</h1><p class="y2-sub">Test kitabçalarından və imtahan vərəqlərindən sualları, variantları və düzgün cavabları avtomatik tanıyıb sual bankına köçürün.</p><div class="y2-st">'+st("Cəmi idxal sənədləri",I.length,"sənəd")+st("Aşkarlanan suallar",tot,"sual")+st("Təsdiqlənmiş suallar",ap,"sual")+st("AI təhlil modeli","",e(m))+'</div><h2>Yeni PDF və ya Word (.docx) Faylı Yüklə</h2><p class="y2-mut">Bu ay "+I.filter(function(x){var d=new Date(x.ts),n=new Date;return d.getMonth()===n.getMonth()&&d.getFullYear()===n.getFullYear()}).length+" sənəd yüklənib.</p><label class="y2-drop"><input type="file" accept="application/pdf,.pdf,.docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden onchange="Y2.pickF(this)"><i class="fa-solid fa-upload"></i><b>PDF və ya Word (.docx) sənədini seçin</b><span>Maksimum 10 MB. Süni intellekt sualları, variantları, düzgün cavabları və şəkilləri ayıracaq.</span></label><div id="y2-file">'+Y.fileRow()+'</div><div class="y2-row"><h2>İdxal Tarixçəsi <span class="y2-chip b">'+I.length+' sənəd</span></h2>'+(I.length?'<button class="y2-b r s" onclick="Y2.clearImp()">Tarixçəni təmizlə</button>':'')+'</div>'+(I.length?'<div class="y2-w"><table class="y2-tbl"><tr><th>Sənəd adı</th><th>Səhifə</th><th>Çıxarılan suallar</th><th>Təsdiqli</th><th>Tarix</th><th></th></tr>'+I.map(function(x){return '<tr><td>'+e(x.name)+'</td><td>'+(x.pages||"—")+'</td><td>'+x.qs.length+'</td><td>'+x.qs.filter(function(q){return q.st==="ok"}).length+'</td><td>'+fd(x.ts)+'</td><td><button class="y2-b o s" onclick="Y2.openImp('+JSON.stringify(x._id)+')">Aç</button> <button class="y2-b r s" onclick="Y2.del(\'ysl2_imp\','+JSON.stringify(x._id)+')">Sil</button></td></tr>'}).join("")+'</table></div>':'<div class="y2-empty"><b>Hələ heç bir PDF idxal edilməyib.</b></div>')},
 fileRow(){var f=Y.file;return f?'<div class="y2-card y2-row"><div><b>'+e(f.name)+'</b><div class="y2-mut">'+(f.size/1024).toFixed(1)+' KB · yükləməyə hazırdır</div></div><div class="y2-act"><button class="y2-b" onclick="Y2.analyze()">Yüklə və Təhlil Et</button><button class="y2-b o" onclick="Y2.file=null;Y2.draw()">✕</button></div></div>':""},
 pickF(i){var f=i.files[0];if(!f)return;if(!/\.(pdf|docx)$/i.test(f.name))return alert("Yalnız PDF və ya Word (.docx) faylı seçin.");if(f.size>10*1048576)return alert("Fayl 10 MB-dan böyükdür.");Y.file=f;$("y2-file").innerHTML=Y.fileRow()},
 openImp(id){Y.imp=Y.D.ysl2_imp.find(function(x){return String(x._id)===String(id)});Y.view="rev";Y.flt="all";Y.draw()},
 async clearImp(){if(!await Y.ask("İdxal Tarixçəsini Təmizlə","Bütün arxivləşdirilmiş PDF idxal sessiyaları silinəcək. Artıq Sual Bankına əlavə edilmiş suallar toxunulmaz qalacaq.","Bəli, Təmizlə"))return;await V2.probe();if(V2.mode==="cloud")await _supabase.from("dq_v2_store").delete().eq("collection","ysl2_imp");else localStorage.removeItem("dq_v2_ysl2_imp");Y.go("pdf")},
 async analyze(){var f=Y.file;if(!f||Y.busy)return;var key=localStorage.getItem("ysl2_key");
  if(!key){alert("Əvvəlcə Profil bölməsində Gemini API açarını daxil edin.");return Y.go("prof")}
  Y.busy=true;Y.abort=false;Y.pgImg={};var all=[],pages=null,PR='Bu test sənədindən sualları çıxar. Yalnız TAM görünən (mətni və variantları kəsilməmiş) sualları daxil et. Yalnız JSON massivi qaytar: [{"q":"sual mətni (nömrəsiz)","type":"mcq" və ya "open","opts":["variant mətni"],"correct":düzgün variantın indeksi (0-dan) və ya cavab açarı yoxdursa -1,"ans":"açıq sualın cavabı və ya boş","subj":"Azərbaycan dili|Qanunvericilik|İnformatika|Məntiq","diff":"Asan|Orta|Çətin","page":səhifə nömrəsi,"fig":[ymin,xmin,ymax,xmax] və ya null,"exp":"qısa izah"}]. Variantlardan A), B) prefikslərini sil. Sualda şəkil, cədvəl və ya diaqram varsa fig-ə yalnız həmin şəklin sərhədlərini 0-1000 miqyasında ver (sualın mətnini daxil etmə), yoxdursa null. Variantı olmayan suallar "open" olsun. Heç nə uydurma.';
  try{Y.prog(1,"Sənəd hazırlanır…");
   if(/\.pdf$/i.test(f.name)){var lib=await Y.pdfjs(),pdf=await lib.getDocument({data:await f.arrayBuffer()}).promise,N=pdf.numPages;pages=N;
    for(var s=1;s<=N;s+=3){var e2=Math.min(N,s+2),parts=[{text:PR}],cv={};
     Y.prog((s-1)/N*100,"Səhifə "+s+(e2>s?"-"+e2:"")+" / "+N+" oxunur və suallar aşkarlanır…");
     for(var p=s;p<=e2;p++){cv[p]=await Y.renderPage(pdf,p);Y.pgImg[p]=cv[p].toDataURL("image/jpeg",.6);parts.push({text:"Səhifə "+p+":"},{inline_data:{mime_type:"image/jpeg",data:cv[p].toDataURL("image/jpeg",.8).split(",")[1]}})}
     Y.parseJ(await Y.gem(parts)).forEach(function(x){if(!x||!x.q)return;var pn=+x.page;if(!cv[pn])pn=s;var q=Y.norm(x,pn);if(Array.isArray(x.fig)&&x.fig.length===4&&cv[pn])q.img=Y.crop(cv[pn],x.fig.map(Number));all.push(q)})}
   }else{
    if(!window.mammoth)await Y.lib("https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js");
    var imgs=[],h=(await mammoth.convertToHtml({arrayBuffer:await f.arrayBuffer()},{convertImage:mammoth.images.imgElement(function(im){return im.read("base64").then(function(b){imgs.push("data:"+im.contentType+";base64,"+b);return{src:"IMG"+imgs.length}})})})).value,d=new DOMParser().parseFromString(h,"text/html");
    d.querySelectorAll("img").forEach(function(i){i.replaceWith(" ⟦IMG"+i.getAttribute("src").slice(3)+"⟧ ")});
    d.querySelectorAll("p,li,tr,h1,h2,h3,h4,br").forEach(function(n){n.append("\n")});d.querySelectorAll("td,th").forEach(function(n){n.append(" | ")});
    var lines=d.body.textContent.split("\n").map(function(x){return x.trim()}).filter(Boolean),ch=[],cur="";lines.forEach(function(l){if(cur.length+l.length>9000){ch.push(cur);cur=""}cur+=l+"\n"});if(cur)ch.push(cur);
    if(!ch.length)throw new Error("Sənəddə mətn tapılmadı.");
    for(var k=0;k<ch.length;k++){Y.prog(k/ch.length*100,"Hissə "+(k+1)+" / "+ch.length+" oxunur və suallar aşkarlanır…");
     Y.parseJ(await Y.gem([{text:PR+" Mətndə ⟦IMGn⟧ işarəsi şəkli bildirir: onu aid olduğu sualın mətnində olduğu kimi saxla. fig həmişə null olsun, page null.\n\n"+ch[k]}])).forEach(function(x){if(!x||!x.q)return;var q=Y.norm(x,null),m=(q.q+" "+q.opts.join(" ")).match(/⟦IMG(\d+)⟧/);if(m&&imgs[+m[1]-1])q.img=imgs[+m[1]-1];q.q=q.q.replace(/\s*⟦IMG\d+⟧\s*/g," ").trim();q.opts=q.opts.map(function(o){return o.replace(/\s*⟦IMG\d+⟧\s*/g," ").trim()});all.push(q)})}
   }
   var seen={};all=all.filter(function(q){var k=(q.q+"|"+q.opts.join("|")).toLowerCase().replace(/\W+/g,"").slice(0,160);if(!q.q||seen[k])return false;seen[k]=1;return true});
   if(!all.length)throw new Error("Sənəddə sual tapılmadı.");
   var o={name:f.name,ts:new Date().toISOString(),qs:all,count:all.length,pages:pages,status:"Tamamlandı"};
   try{await V2.put("ysl2_imp",o)}catch(x){all.forEach(function(q){q.img=null});await V2.put("ysl2_imp",o);V2.toast("Yaddaş dolduğu üçün şəkillər saxlanmadı")}
   await Y.load();Y.imp=Y.D.ysl2_imp.find(function(x){return x.ts===o.ts});Y.lastFile=f;Y.file=null;Y.view="rev";Y.flt="all";Y.cm();Y.busy=false;Y.draw();V2.toast(all.length+" sual aşkarlandı ✅")
  }catch(err){Y.busy=false;Y.cm();alert("Təhlil alınmadı: "+err.message)}},
 review(){var I=Y.imp,qs=I.qs,n=function(k){return qs.filter(function(q){return q.st===k}).length},f=Y.flt;
  var chip=function(k,l,c){return '<button class="'+(f===k?"on":"")+'" onclick="Y2.flt=\''+k+'\';Y2.draw()">'+l+' '+c+'</button>'};
  return '<div class="y2-card" style="border-left:4px solid #16a34a">Sənəd uğurla təhlil edildi. '+qs.length+' sual aşkarlandı. Zəhmət olmasa nəticələri nəzərdən keçirin.</div><div class="y2-act"><button class="y2-b o s" onclick="Y2.view=\'\';Y2.draw()">← İdxal siyahısına qayıt</button><span class="y2-chip">'+e(I.name)+(I.pages?' ('+I.pages+' səhifə)':'')+'</span></div><h1>PDF-dən Sual Yoxlanışı və Təsdiqi</h1><div class="y2-act"><button class="y2-b o" onclick="Y2.reAI()">↻ Yenidən AI ilə Təhlil et</button><button class="y2-b" onclick="Y2.bulk()">✓ Düzgünləri Toplu Təsdiqlə</button></div><div class="y2-st">'+st("Aşkar edildi",qs.length,"sual")+st("Hazırdır (Təsdiq...)",n("ready"),"hazır")+st("Yoxlanmalıdır",n("check"),"sual")+st("Rədd edildi",n("rej"),"sual")+'</div><div class="y2-chips">'+chip("all","Hamısı",qs.length)+chip("check","Yoxlanılmalıdır",n("check"))+chip("ready","Hazırdır",n("ready"))+chip("ok","Təsdiqli",n("ok"))+chip("rej","Rədd edilib",n("rej"))+'</div><input class="y2-in" placeholder="Sual mətni üzrə axtarış..." oninput="Y2.filt(this,\'.y2-qc\')">'+qs.map(function(q,i){return f==="all"||q.st===f?Y.qcard(q,i):""}).join("")+'<div class="y2-foot"><b>Təsdiqlənmiş Suallar: '+n("ok")+' / '+qs.length+'</b><button class="y2-b" onclick="Y2.mkPkg()">Bu sualları Sual Paketi et ('+n("ok")+')</button></div>'},
 reAI(){if(Y.lastFile){Y.file=Y.lastFile;Y.view="";Y.analyze()}else{alert("Faylı yenidən seçib «Yüklə və Təhlil Et» düyməsini basın.");Y.view="";Y.draw()}},
 qcard(q,i){var op=q.type==="open",fig=q.img?'<div class="y2-fig"><div class="y2-row"><span class="y2-mut">Sənəddən kəsilmiş sual fiquru / diaqram:</span><span><button class="y2-b o s" onclick="Y2.refig('+i+')">Şəkli yenidən kəs</button> <button class="y2-b r s" onclick="Y2.delFig('+i+')">Şəkli sil</button></span></div><img src="'+q.img+'" alt=""></div>':'<div class="y2-fig y2-row"><span class="y2-mut">Şəkil əlavə edilməyib</span><button class="y2-b o s" onclick="Y2.fig('+i+')">✂ Şəkil əlavə et</button></div>';
  return '<div class="y2-card y2-qc"><div class="y2-tags"><span class="y2-chip b">Sual #'+(i+1)+'</span><span class="y2-chip">Səhifə '+(q.page||"—")+'</span><span class="y2-chip s-'+q.st+'">'+LBL[q.st]+'</span><span class="y2-mut" style="margin-left:auto">Fənn: '+e(q.subj)+' · Çətinlik: '+e(q.diff||"Orta")+'</span></div><p class="y2-qt">'+e(q.q)+'</p>'+fig+(op?'<div class="y2-info" style="border-color:#f59e0b"><b>Açıq sual</b><label>Düzgün cavab</label><input id="y2-ans'+i+'" class="y2-in" placeholder="Düzgün cavabı yazın" value="'+e(q.ans||"")+'"><button class="y2-b s" onclick="Y2.setAns('+i+')">Cavabı təsdiqlə</button></div>':(q.correct<0?'<div class="y2-info" style="border-color:#f59e0b">Düzgün cavab avtomatik müəyyən edilmədi — variantlardan birinə klikləyərək təyin edin. <button class="y2-b o s" onclick="Y2.toOpen('+i+')">Açıq suala çevir</button></div>':'')+'<div class="y2-mut" style="font-size:12px">VARİANTLAR (düzgün cavabı dəyişmək üçün klikləyin)</div><div class="y2-opts">'+q.opts.map(function(o,j){return '<div class="y2-opt '+(q.correct===j?"c":"")+'" onclick="Y2.setC('+i+','+j+')"><b>'+L[j]+'</b> '+e(o)+(q.correct===j?'<em>✓ DÜZGÜN</em>':'')+'</div>'}).join("")+'</div>')+'<div class="y2-act"><button class="y2-b" onclick="Y2.appr('+i+')">✓ Təsdiqlə</button><button class="y2-b o" onclick="Y2.edQ('+i+')">Redaktə et</button><button class="y2-b o" onclick="Y2.rejQ('+i+')">× Rədd et</button></div></div>'},
 async sync(){await V2.put("ysl2_imp",Y.imp,Y.imp._id);await Y.load();Y.imp=Y.D.ysl2_imp.find(function(x){return String(x._id)===String(Y.imp._id)})||Y.imp;Y.draw()},
 setC(i,j){var q=Y.imp.qs[i];if(q.st==="ok")return V2.toast("Təsdiqlənmiş sualı Sual bankından redaktə edin");q.correct=j;if(q.st==="check"||q.st==="rej")q.st="ready";Y.sync()},
 async approve(q){await V2.put("ysl2_q",Object.assign(cp(q),{topic:q.subj,imp:Y.imp.name}));q.st="ok"},
 async appr(i){var q=Y.imp.qs[i];if(q.st==="ok")return;if(!Y.rdy(q))return alert(q.type==="open"?"Əvvəlcə düzgün cavabı yazın.":"Əvvəlcə düzgün cavabı seçin.");await Y.approve(q);Y.sync()},
 async bulk(){var l=Y.imp.qs.filter(function(q){return q.st==="ready"&&Y.rdy(q)});if(!l.length)return alert("Təsdiqə hazır sual yoxdur.");for(var k=0;k<l.length;k++)await Y.approve(l[k]);V2.toast(l.length+" sual təsdiqləndi ✅");Y.sync()},
 rejQ(i){Y.imp.qs[i].st="rej";Y.sync()},
 edQ(i){var q=Y.imp.qs[i];if(q.type==="open"){var t=prompt("Sual mətni:",q.q);if(t===null||!t.trim())return;q.q=t.trim();if(q.st==="ok")q.st="ready";return Y.sync()}Y.qModal(q,function(u){Object.assign(q,u);if(q.st!=="ok")q.st=Y.rdy(q)?"ready":"check";Y.sync()},"Sualı redaktə et",false)},
 async mkPkg(){var ok=Y.imp.qs.filter(function(q){return q.st==="ok"});if(!ok.length)return alert("Əvvəlcə sualları təsdiqləyin.");var n=prompt("Paket adı:",Y.imp.name.replace(/\.pdf$/i,""));if(!n)return;await V2.put("ysl2_pkg",{name:n.trim(),qs:ok.map(cp),ts:new Date().toISOString()});V2.toast("Sual paketi yaradıldı ✅");Y.tab="pk";Y.go("bank")},
 /* ---------- QUİZLƏR ---------- */
 quizTbl(l,act){return l.length?'<div class="y2-w"><table class="y2-tbl"><tr><th>Quiz başlığı</th><th>Tarix</th><th>Müddət</th><th>Suallar</th><th>Status</th>'+(act?'<th></th>':'')+'</tr>'+l.map(function(x){return '<tr class="y2-qz"><td><b>'+e(x.title)+'</b><div class="y2-mut">'+e(x.topic||"")+'</div></td><td>'+fd(x.ts)+'</td><td>'+x.dur+' dəq</td><td>'+x.qs.length+'</td><td>'+(act?'<select class="y2-in" style="margin:0" onchange="Y2.quizSt('+JSON.stringify(x._id)+',this.value)">'+QST.map(function(s){return "<option "+(s===x.status?"selected":"")+">"+s+"</option>"}).join("")+'</select>':'<span class="y2-chip">'+e(x.status)+'</span>')+'</td>'+(act?'<td><button class="y2-b r s" onclick="Y2.del(\'ysl2_quiz\','+JSON.stringify(x._id)+')">Sil</button></td>':'')+'</tr>'}).join("")+'</table></div>':'<div class="y2-empty"><b>Hələ quiz yaradılmayıb.</b><p>Sualları seçərək ilk quizinizi yaradın.</p><button class="y2-b" onclick="Y2.quizForm()">+ Yeni quiz</button></div>'},
 p_quiz(){var l=Y.D.ysl2_quiz.filter(function(x){return Y.qf==="all"||x.status===Y.qf});return '<h1>Quizlər <span class="y2-chip b">MÜƏLLİM SINAQLARI</span></h1><p class="y2-sub">Müəllim sınaqları: tələbələr və qruplar üçün xüsusi hazırlanmış sınaq testləri.</p><div class="y2-act"><button class="y2-b o" onclick="Y2.go(\'exam\')">İmtahanlar</button><button class="y2-b" onclick="Y2.quizForm()">+ Yeni quiz</button></div><div class="y2-row" style="margin:14px 0"><input class="y2-in" style="max-width:340px;margin:0" placeholder="Quiz başlığında axtarış..." oninput="Y2.filt(this,\'.y2-qz\')"><select class="y2-in" style="max-width:200px;margin:0" onchange="Y2.qf=this.value;Y2.draw()"><option value="all">Bütün statuslar</option>'+QST.map(function(s){return "<option "+(Y.qf===s?"selected":"")+">"+s+"</option>"}).join("")+'</select><span class="y2-chip">'+l.length+' quiz</span></div>'+Y.quizTbl(l,true)},
 quizForm(){var D=Y.D;Y.modal('<h3>Yeni quiz</h3><label>Başlıq</label><input id="y2-qn" class="y2-in"><div class="y2-g3"><div><label>Mövzu</label><select id="y2-qtp" class="y2-in"><option value="">—</option>'+D.ysl2_topic.filter(function(t){return !t.hidden}).map(function(t){return "<option>"+e(t.name)+"</option>"}).join("")+'</select></div><div><label>Müddət (dəq)</label><input id="y2-qd" type="number" class="y2-in" value="30"></div><div><label>Status</label><select id="y2-qst" class="y2-in">'+QST.map(function(s){return "<option>"+s+"</option>"}).join("")+'</select></div></div><label>Suallar</label>'+Y.pick(D.ysl2_q,"y2-qp")+'<div class="y2-act"><button class="y2-b" onclick="Y2.quizSave()">Quizi yarat</button><button class="y2-b o" onclick="Y2.cm()">İmtina</button></div>')},
 async quizSave(){var t=$("y2-qn").value.trim(),qs=Y.picked(Y.D.ysl2_q,"y2-qp");if(!t||!qs.length)return alert("Başlıq yazın və sual seçin.");await V2.put("ysl2_quiz",{title:t,topic:$("y2-qtp").value,dur:+$("y2-qd").value||30,status:$("y2-qst").value,qs:qs,ts:new Date().toISOString()});Y.cm();V2.toast("Quiz yaradıldı ✅");Y.go("quiz")},
 async quizSt(id,v){var r=Y.D.ysl2_quiz.find(function(x){return String(x._id)===String(id)});await V2.put("ysl2_quiz",Object.assign({},r,{status:v}),id);V2.toast("Status dəyişdi")},
 /* ---------- İMTAHANLAR ---------- */
 p_exam(){var l=Y.D.ysl2_exam;return '<div class="y2-row"><div><h1>İmtahanlar <span class="y2-chip b">MÜƏLLİM İMTAHANLARI</span></h1><p class="y2-sub">100 sualliq imtahanlarınızı idarə edin və tələbələrlə paylaşın.</p></div><div class="y2-act"><button class="y2-b o" onclick="Y2.go(\'quiz\')">Quizlər</button><button class="y2-b" onclick="Y2.ex=null;Y2.exStep1()">+ Yeni imtahan</button></div></div><input class="y2-in" placeholder="İmtahan başlığında axtarış..." oninput="Y2.filt(this,\'.y2-ex\')">'+(l.length?'<div class="y2-w"><table class="y2-tbl"><tr><th>İmtahan başlığı</th><th>Tarix</th><th>Müddət</th><th>Suallar</th><th>Giriş kodu</th><th></th></tr>'+l.map(function(x){return '<tr class="y2-ex"><td><b>'+e(x.name)+'</b><div class="y2-mut">'+e(x.pkg)+'</div></td><td>'+fd(x.start)+'<div class="y2-mut">→ '+fd(x.end)+'</div></td><td>'+x.dur+' dəq</td><td>'+x.count+'</td><td><b>'+e(x.code)+'</b></td><td><button class="y2-b r s" onclick="Y2.del(\'ysl2_exam\','+JSON.stringify(x._id)+')">Sil</button></td></tr>'}).join("")+'</table></div>':'<div class="y2-empty">Hələ imtahan yaratmamısınız. 100 sualliq paketdən ilk imtahanınızı yaradın.</div>')},
 exStep1(){var x=Y.ex=Y.ex||{};if(!x.start){var n=new Date;x.start=Y.dtl(n);x.end=Y.dtl(new Date(n.getTime()+7*864e5))}Y.modal('<h3>Yeni İmtahan Yarat</h3><p class="y2-mut">İmtahanınızı 2 addımda qurun və tələbələrlə paylaşın.</p><div class="y2-steps"><b class="on">1 İmtahan Məlumatları</b><b>2 Sualların Seçimi</b></div><label>İmtahan Adı *</label><input id="y2-en" class="y2-in" value="'+e(x.name||"")+'" placeholder="Məs. Ümumi sınaq imtahanı"><div class="y2-g3"><div><label>Müddət (dəqiqə)</label><input id="y2-ed" type="number" class="y2-in" value="'+(x.dur||180)+'"></div><div><label>Başlama vaxtı</label><input id="y2-es" type="datetime-local" class="y2-in" value="'+(x.start||"")+'"></div><div><label>Bitmə vaxtı</label><input id="y2-ee" type="datetime-local" class="y2-in" value="'+(x.end||"")+'"></div></div><div class="y2-info">Növbəti addımda imtahan üçün 100 sualliq paket seçəcəksiniz.</div><div class="y2-act"><button class="y2-b o" onclick="Y2.cm()">İmtina</button><button class="y2-b" onclick="Y2.exStep2()">Növbəti addım →</button></div>')},
 exStep2(){var x=Y.ex;if($("y2-en")){x.name=$("y2-en").value.trim();x.dur=+$("y2-ed").value||180;x.start=$("y2-es").value;x.end=$("y2-ee").value;if(!x.name)return alert("İmtahan adını yazın.");if(!x.start||!x.end||new Date(x.end)<=new Date(x.start))return alert("Bitmə vaxtı başlama vaxtından sonra olmalıdır.");if(x.dur<1)return alert("Müddət düzgün deyil.")}
  var P=Y.D.ysl2_pkg.filter(function(p){return p.qs.length===100&&!p.qs.some(function(q){return q.type==="open"})});
  Y.modal('<h3>Yeni İmtahan Yarat</h3><div class="y2-steps"><b>1 İmtahan Məlumatları</b><b class="on">2 Sualların Seçimi</b></div><div class="y2-info"><b>Məlumat:</b> İmtahan üçün 100 aktiv sualdan ibarət bir <b>Sual Paketi</b> seçin.</div>'+(P.length?'<div class="y2-pick">'+P.map(function(p,i){return '<label><input type="radio" name="y2-ep" value="'+i+'"'+(i===0?" checked":"")+'><span><b>'+e(p.name)+'</b> · 100 sual</span></label>'}).join("")+'</div>':'<div class="y2-empty"><b>100 aktiv sualliq paket tapılmadı</b><p>İmtahanda yalnız 100 sualdan ibarət paketlər istifadə oluna bilər.</p><button class="y2-b o" onclick="Y2.cm();Y2.go(\'pdf\')">PDF-dən sual paketi yarat</button></div>')+'<div class="y2-act"><button class="y2-b o" onclick="Y2.exStep1()">← Geri</button><button class="y2-b o" onclick="Y2.cm()">İmtina</button>'+(P.length?'<button class="y2-b" onclick="Y2.exSave()">İmtahanı yarat və dərc et</button>':'')+'</div>')},
 async exSave(){var P=Y.D.ysl2_pkg.filter(function(p){return p.qs.length===100&&!p.qs.some(function(q){return q.type==="open"})}),r=document.querySelector("input[name=y2-ep]:checked");if(!r)return;var p=P[+r.value],x=Y.ex,code=V2.genCode();while(Y.D.ysl2_exam.some(function(z){return z.code===code}))code=V2.genCode();var ORD=["Azərbaycan dili","Qanunvericilik","İnformatika","Məntiq"],srt=p.qs.map(function(q,i){return{q:q,i:i}}).sort(function(a,b){return (ORD.indexOf(a.q.subj)+1||9)-(ORD.indexOf(b.q.subj)+1||9)||a.i-b.i}).map(function(z){return z.q});p=Object.assign({},p,{qs:srt});
  await V2.put("ysl2_exam",{name:x.name,dur:x.dur,start:x.start,end:x.end,pkg:p.name,count:100,code:code,qs:p.qs,status:"Aktiv",ts:new Date().toISOString()});
  await V2.put("sessions",{name:x.name,cat:"BA",type:"Qəbul tipli imtahan",templates:[p.name],questions:p.qs.map(function(q){return{type:"mcq",text:q.q,qimg:q.img||null,cat:"BA",note:q.exp||"",correct:q.correct,opts:q.opts.map(function(t){return{text:t,img:null}})}}),count:100,restricted:false,students:[],dur:x.dur,entry:"code",code:code,status:"Aktiv",date:V2.date()});
  Y.cm();Y.ex=null;V2.toast("İmtahan dərc olundu. Kod: "+code);Y.go("exam")},
 /* ---------- QRUPLAR ---------- */
 p_group(){var l=Y.D.ysl2_group;return '<div class="y2-row"><div><h1>Qruplar</h1><p class="y2-sub">Tələbə qruplarını idarə edin.</p></div><button class="y2-b" onclick="Y2.grForm()">+ Yeni qrup</button></div>'+(l.length?l.map(function(g){return '<div class="y2-card y2-row"><div><b>'+e(g.name)+'</b><div class="y2-mut">'+(g.members||[]).length+' tələbə</div><div style="font-size:13px;margin-top:4px">'+(g.members||[]).map(e).join(", ")+'</div></div><button class="y2-b r s" onclick="Y2.del(\'ysl2_group\','+JSON.stringify(g._id)+')">Sil</button></div>'}).join(""):'<div class="y2-empty">Hələ qrup yoxdur.</div>')},
 grForm(){Y.modal('<h3>Yeni qrup</h3><label>Qrup adı</label><input id="y2-gn" class="y2-in"><label>Tələbələr (hər sətirdə bir ad)</label><textarea id="y2-gm" class="y2-in" rows="6"></textarea><div class="y2-act"><button class="y2-b" onclick="Y2.grSave()">Yarat</button><button class="y2-b o" onclick="Y2.cm()">İmtina</button></div>')},
 async grSave(){var n=$("y2-gn").value.trim();if(!n)return alert("Qrup adı yazın.");await V2.put("ysl2_group",{name:n,members:$("y2-gm").value.split("\n").map(function(s){return s.trim()}).filter(Boolean),ts:new Date().toISOString()});Y.cm();Y.go("group")},
 /* ---------- NƏTİCƏLƏR ---------- */
 p_res(){var R=Y.R;return '<h1>Nəticələr</h1><p class="y2-sub">İştirakçıların imtahan nəticələri.</p><input class="y2-in" placeholder="FİN və ya imtahan üzrə axtarış..." oninput="Y2.filt(this,\'.y2-rs\')">'+(R.length?'<div class="y2-w"><table class="y2-tbl"><tr><th>İştirakçı</th><th>İmtahan</th><th>Kateqoriya</th><th>Bal</th><th>✅ / ❌</th><th>Tarix</th></tr>'+R.map(function(r){return '<tr class="y2-rs"><td>'+e(r.student_name||r.name||"")+' <span class="y2-mut">'+e(r.fin||"")+'</span></td><td>№'+e(r.exam_no)+'</td><td>'+e(r.category)+'</td><td><b>'+e(r.score)+'</b></td><td>'+e(r.correct_count)+' / '+e(r.wrong_count)+'</td><td>'+fd(r.created_at)+'</td></tr>'}).join("")+'</table></div>':'<div class="y2-empty">Heç bir iştirakçı yoxdur.</div>')},
 /* ---------- PROFİL / AI ---------- */
 p_prof(){var m=localStorage.getItem("ysl2_model")||"gemini-2.5-flash";return '<h1>Profil</h1><p class="y2-sub">Süni intellekt (Gemini) ayarları.</p><div class="y2-card"><h3>Gemini API açarı</h3><div class="y2-info">Açarı <b>aistudio.google.com/apikey</b> ünvanından pulsuz alın və bura yapışdırın. Açar yalnız bu cihazın brauzerində saxlanılır.</div><label>API açarı</label><input id="y2-k" type="password" class="y2-in" autocomplete="off" value="'+e(localStorage.getItem("ysl2_key")||"")+'" placeholder="AIza..."><label>Model</label><select id="y2-m" class="y2-in">'+["gemini-2.5-flash","gemini-3.8-flash","gemini-3.1-pro-preview"].map(function(x){return "<option "+(x===m?"selected":"")+">"+x+"</option>"}).join("")+'</select><div class="y2-act"><button class="y2-b" onclick="Y2.saveK()">Yadda saxla</button><button class="y2-b o" onclick="Y2.testK()">Bağlantını yoxla</button></div></div>'},
 saveK(){localStorage.setItem("ysl2_key",$("y2-k").value.trim());localStorage.setItem("ysl2_model",$("y2-m").value);V2.toast("Saxlanıldı ✅")},
 async testK(){Y.saveK();try{var r=await fetch("https://generativelanguage.googleapis.com/v1beta/models?key="+encodeURIComponent(localStorage.getItem("ysl2_key")||""));V2.toast(r.ok?"AI bağlantısı işləyir ✅":"Açar yanlışdır ❌")}catch(x){V2.toast("Şəbəkə xətası ❌")}}
};
})();
;

/* ===== dq-nav2-js ===== */
(function(){
"use strict";
var KEY="dq_nav2_unlock",D=document,$=function(i){return D.getElementById(i)},T=null,tt=null;
var SHIELD='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><path d="M12 8v4M12 15.5v.01"/></svg>';

function toast(m){
  try{if(typeof V2!=="undefined"&&V2.toast)return V2.toast(m)}catch(e){}
  var o=$("dq2-toast");o&&o.remove();o=D.createElement("div");o.id="dq2-toast";o.setAttribute("role","status");o.textContent=m;D.body.appendChild(o);
  clearTimeout(tt);tt=setTimeout(function(){o.remove()},2600);
}
function unlocked(){
  try{if(sessionStorage.getItem(KEY)==="1")return true}catch(e){}
  return !!D.querySelector(".dq-adm-nav");      /* Supabase admin girişi */
}

/* ---------- Əməliyyatlar ---------- */
function run(label,fn){
  try{
    var r=fn();
    if(r&&r.catch)r.catch(function(){toast(label+" açıla bilmədi")});
  }catch(e){toast(label+" yüklənmədi — səhifəni yeniləyin")}
}
var A={
  mod:function(){run("Mərkəzi modullar",function(){
    try{localStorage.setItem("dq_admin_logged","true")}catch(e){}
    showScreen("admin-panel");switchAdminTab("suallar");loadAdminPanelData();scrollTo(0,0)})},
  ysl:function(){run("ysl",function(){return DQ_YSL.open()})},
  y2:function(){run("ysl2",function(){return Y2.open()})},
  by:function(){dqAdminAsk().then(function(ok){if(ok)A.mod()})},
  v2:function(){run("77",function(){return DQ_YSL.plain()})},
  v3:function(){run("İdarəçi V3",function(){return V3.open()})},
  yq:function(){run("Təsdiq paneli",function(){return YQ.openAdmin()})},
  yx:function(){run("Yoxlama rejimi",function(){return YX.open()})},
  tm:function(){run("Testlər idarəsi",function(){return TM.open()})},
  cab:function(){dqAdminAsk().then(function(ok){if(ok&&window.DQStudio)window.DQStudio.liveEdit()})}
};
function has(f){try{return !!f()}catch(e){return false}}
var AVAIL={
  v3:function(){return typeof V3!=="undefined"&&V3.open},
  yq:function(){return typeof YQ!=="undefined"&&YQ.openAdmin},
  yx:function(){return typeof YX!=="undefined"&&YX.open},
  tm:function(){return typeof TM!=="undefined"&&TM.open}
};

/* ---------- Kilid ---------- */
function unlock(){
  try{sessionStorage.setItem(KEY,"1")}catch(e){}
  window.__dqSecretAdmin=true;
  refresh();toast("Admin qısayolları aktivləşdi ✅");
}
function lock(){
  try{sessionStorage.removeItem(KEY)}catch(e){}
  window.__dqSecretAdmin=false;closeMenu();refresh();
}

/* ---------- Açılan menyu ---------- */
function closeMenu(){var m=$("dq2-menu");m&&m.remove();var b=$("dq2-adm");b&&b.setAttribute("aria-expanded","false")}
function openMenu(btn){
  if($("dq2-menu"))return closeMenu();
  var m=D.createElement("div");m.id="dq2-menu";m.setAttribute("role","menu");
  var rows=[["ysl","🧭","İdarəetmə paneli (ysl)"],["mod","🗂️","Mərkəzi modullar (Suallar, PDF, OCR…)"],["v2","🛡️","İdarəçi V2 (77)"],["y2","🧠","ysl2 studiyası"],["v3","🧩","İdarəçi V3","v3"],["yq","✅","Təsdiq, PDF & Elan","yq"],["yx","🔍","Yoxlama rejimi","yx"],["tm","🗂️","Testlər idarəsi","tm"]];
  m.innerHTML='<h6>Admin panel</h6>'+rows.map(function(r){
    var off=r[3]&&!has(AVAIL[r[3]]);
    return '<button type="button" role="menuitem" data-a="'+r[0]+'"'+(off?" disabled":"")+'><i>'+r[1]+'</i>'+r[2]+'</button>'}).join("")+
    '<hr><button type="button" role="menuitem" data-a="lock" class="out"><i>🔒</i>Qısayolları gizlət</button>';
  D.body.appendChild(m);
  var r=btn.getBoundingClientRect(),w=m.offsetWidth;
  m.style.top=Math.round(r.bottom+6)+"px";
  m.style.left=Math.max(10,Math.min(innerWidth-w-10,r.right-w))+"px";
  btn.setAttribute("aria-expanded","true");
  m.addEventListener("click",function(e){
    var b=e.target.closest("button[data-a]");if(!b)return;
    var k=b.dataset.a;closeMenu();k==="lock"?lock():A[k]&&A[k]();
  });
  var f=m.querySelector("button:not([disabled])");f&&f.focus();
}
D.addEventListener("click",function(e){if(!e.target.closest("#dq2-menu,#dq2-adm"))closeMenu()},true);
D.addEventListener("keydown",function(e){
  if(e.key==="Escape")closeMenu();
  var m=$("dq2-menu");if(!m||(e.key!=="ArrowDown"&&e.key!=="ArrowUp"))return;
  var b=[].slice.call(m.querySelectorAll("button:not([disabled])")),i=b.indexOf(D.activeElement);
  e.preventDefault();b[(i+(e.key==="ArrowDown"?1:-1)+b.length)%b.length].focus();
});
addEventListener("resize",closeMenu);

/* ---------- Naviqasiyaya yerləşdirmə ---------- */
function build(nav){
  var g=D.createElement("div");g.className="dq2-r";
  g.innerHTML=
   '<button type="button" class="dq2-adm" id="dq2-adm" data-u aria-haspopup="menu" aria-expanded="false" title="Admin panel">'+SHIELD+'<span>Admin panel</span></button>'+
   '<button type="button" class="dq2-c" data-u data-k="y2" title="ysl2 — studiya">ysl2</button>'+
   '<button type="button" class="dq2-c" data-u data-k="ysl" title="ysl — idarəetmə paneli">ysl</button>'+
   '<button type="button" class="dq2-c" data-u data-k="77" title="77 — İdarəçi V2">77</button>'+    '<button type="button" class="dq2-c" data-u data-k="by" title="Mərkəzi admin panel (şifrə ilə)">by</button>'+
   '<button type="button" class="dq2-c" data-u data-k="cab" title="Canlı sual redaktoru (şifrə ilə)">📝 Suallar</button>'+
   '<button type="button" class="dq2-lk" data-u data-k="lock" title="Qısayolları gizlət" aria-label="Qısayolları gizlət">🔒</button>';
  g.addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.id==="dq2-adm")return openMenu(b);
    var k=b.dataset.k;
    if(k==="lock")return lock();
    var fn={y2:A.y2,ysl:A.ysl,"77":A.v2,by:A.by,cab:A.cab}[k];if(!fn)return;
    b.classList.add("busy");setTimeout(function(){b.classList.remove("busy")},700);fn();
  });
  nav.appendChild(g);return g;
}
function refresh(){
  var nav=D.querySelector("#v3-home .v3-nav");if(!nav)return;
  if(nav.lang!=="az")nav.lang="az";               /* i → İ düzgün böyüsün */
  var g=nav.querySelector(".dq2-r")||build(nav),u=unlocked();
  [].forEach.call(g.querySelectorAll("[data-u]"),function(el){el.hidden=!u});
  if(!u)closeMenu();
}
var host=$("v3-home");
if(host)new MutationObserver(function(){clearTimeout(T);T=setTimeout(refresh,40)}).observe(host,{childList:true,subtree:true});
if(D.readyState!=="loading")refresh();else D.addEventListener("DOMContentLoaded",refresh);
setTimeout(refresh,600);

/* ysl2 içindəki "Çıxış" qısayolları da gizlətsin */
(function wrap(n){
  if(window.Y2&&Y2.logout&&!Y2.__n2){var o=Y2.logout;Y2.logout=function(){lock();return o.apply(this,arguments)};Y2.__n2=1;return}
  if(n<40)setTimeout(function(){wrap(n+1)},250);
})(0);

window.DQ_NAV2={unlock:unlock,lock:lock,refresh:refresh,open:A};
})();
;

/* ===== ys-skin-js ===== */
(function(){
"use strict";
var D=document,$=function(i){return D.getElementById(i)};
window.__ysSkin=false;
function ic(p,extra){return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+p+(extra||"")+'</svg>'}
var P={
 shield:'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4M12 16h.01"/>',
 user:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
 bag:'<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/>',
 file:'<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>',
 award:'<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>',
 play:'<polygon points="6 3 20 12 6 21 6 3"/>',
 pen:'<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/>',
 ok:'<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
 gear:'<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
 me:'<circle cx="12" cy="8" r="3.6"/><path d="M5 20c.8-3.6 3.6-5.4 7-5.4s6.2 1.8 7 5.4"/>'
};
var ICON={dash:P.user,users:P.user,books:P.bag,bank:P.file,bank2:P.file,tpl:P.award,start:P.play,news:P.pen,res:P.ok,set:P.gear};
var LABEL={res:"Uğurlarımız"};

/* --- "Kitab Sifarişləri" səhifəsi --- */
function ready(f){if(typeof V2!=="undefined"&&V2.menu&&V2.list)return f();setTimeout(function(){ready(f)},150)}
ready(function(){
  if(!V2.menu.some(function(m){return m[0]==="books"}))V2.menu.splice(2,0,["books","fa-bag-shopping","Kitab Sifarişləri"]);
  var e=V2.esc,ST=["Gözləyir","Təsdiqləndi","Çatdırıldı"];
  V2.p_books=async function(){
    var r=await V2.list("bookorders");
    var n=function(s){return r.filter(function(x){return x.st===s}).length};
    var card=function(t,v,c){return '<div class="v2-card v2-stat"><span>'+t+'</span><b>'+v+'</b><small style="color:'+c+'">sifariş</small></div>'};
    return {title:"Kitab Sifarişləri",sub:"Kitab sifarişlərinə baxın, statusu dəyişin və ya silin.",
     html:'<div class="v2-stats">'+card("Ümumi",r.length,"#1e1b4b")+card("Gözləyən",n("Gözləyir")+r.filter(function(x){return !x.st}).length,"#d97706")+card("Çatdırılan",n("Çatdırıldı"),"#10b981")+'</div>'+
     '<div class="v2-card v2-wrap"><table class="v2-tbl"><thead><tr><th>Tələbə</th><th>Telefon</th><th>Ünvan</th><th>Kitab</th><th>Status</th><th></th></tr></thead><tbody>'+
     (r.length?r.map(function(x,i){return '<tr><td>'+e(x.name||x.student||"—")+'</td><td>'+e(x.phone||"—")+'</td><td>'+e(x.addr||x.address||"—")+'</td><td>'+e(x.book||"—")+'</td><td><button class="v2-b o s" onclick="DQ_YSL.nextStatus('+i+')">'+e(x.st||ST[0])+'</button></td><td><button class="v2-b r s" onclick="V2.del(\'bookorders\','+JSON.stringify(x._id)+')">Sil</button></td></tr>'}).join(""):'<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:28px">Hələ sifariş yoxdur.</td></tr>')+
     '</tbody></table></div>',after:function(){YS.rows=r}};
  };
  /* V2.go-nu sarıyırıq: skin rejimində üst panel + ikonlar */
  var og=V2.go,oo=V2.open,oc=V2.close;
  V2.open=function(){
    var r=$("v2-root");if(!r){r=D.createElement("div");r.id="v2-root";D.body.appendChild(r)}
    r.classList.toggle("ys-skin",!!window.__ysSkin);
    return oo.apply(this,arguments);
  };
  V2.close=function(){window.__ysSkin=false;var r=$("v2-root");r&&r.classList.remove("ys-skin");return oc.apply(this,arguments)};
  V2.go=async function(){
    var r=$("v2-root");r&&r.classList.toggle("ys-skin",!!window.__ysSkin);
    var x=await og.apply(this,arguments);
    if(window.__ysSkin)decorate();
    return x;
  };
});

function leave(fn){return function(){try{V2.close()}catch(e){}try{fn()}catch(e){try{showScreen("v3-home")}catch(x){}}}}
var TOP=[
 ["ANA SƏHİFƏ",leave(function(){showScreen("v3-home");scrollTo(0,0)})],
 ["İMTAHAN",leave(function(){V3.go("n2")})],
 ["KABİNET",leave(function(){DQ.openCabinet()})],
 ["XƏBƏRLƏR",leave(function(){V3.go("n4")})],
 ["ƏLAQƏ",leave(function(){V3.go("inf")})]
];
function decorate(){
  var r=$("v2-root");if(!r||!r.classList.contains("ys-skin"))return;
  if(!r.querySelector(".ys-top")){
    var t=D.createElement("div");t.className="ys-top";t.setAttribute("role","navigation");t.lang="az";
    TOP.forEach(function(x){var b=D.createElement("button");b.type="button";b.textContent=x[0];b.onclick=x[1];t.appendChild(b)});
    var a=D.createElement("button");a.type="button";a.className="adm";a.innerHTML=ic(P.shield).replace('width="18" height="18"','width="14" height="14"')+"ADMİN PANEL";a.onclick=function(){V2.go("dash")};t.appendChild(a);
    var sp=D.createElement("span");sp.className="sp";t.appendChild(sp);
    var me=D.createElement("button");me.type="button";me.className="me";me.title="Paneli bağla";me.innerHTML='<i>'+ic(P.me).replace('width="18" height="18"','width="15" height="15"').replace('currentColor','#fff')+'</i>Yunis';
    me.onclick=leave(function(){showScreen("v3-home");scrollTo(0,0)});t.appendChild(me);
    r.insertBefore(t,r.firstChild);
  }
  var av=r.querySelector(".v2-av");if(av&&!av.dataset.s){av.dataset.s=1;av.innerHTML=ic(P.shield).replace('width="18" height="18"','width="30" height="30"')}
  [].forEach.call(r.querySelectorAll(".v2-nav"),function(n){
    var m=/V2\.go\('([^']+)'\)/.exec(n.getAttribute("onclick")||"");
    if(!m){if(/V2\.close/.test(n.getAttribute("onclick")||""))n.style.display="none";return}           /* "Əsas Admin Panelə Keç" gizlədilir — üst paneldə çıxış var */
    var k=m[1];if(n.dataset.s)return;n.dataset.s=1;
    var txt=LABEL[k]||n.textContent.trim();n.innerHTML=ic(ICON[k]||P.file)+txt;
  });
}
var YS=window.DQ_YSL={rows:[],
  open:function(){window.__ysSkin=true;V2.open()},
  plain:function(){window.__ysSkin=false;V2.open()},
  async nextStatus(i){var x=YS.rows[i];if(!x)return;var ST=["Gözləyir","Təsdiqləndi","Çatdırıldı"],c=ST.indexOf(x.st||ST[0]);
    var o=Object.assign({},x);delete o._id;o.st=ST[(c+1)%3];await V2.put("bookorders",o,x._id);V2.go("books")}
};
})();
;

/* ===== dq-push-patch ===== */
/* DQ PATCH — bildirişlər */
(function(){'use strict';
var VAPID_PUBLIC='BDtYn14Q2yQe5x4zgSLRf8Mh6aSiVjagyfbUhUDllpTt2AYfnWE8jMbichN3C3NsyxyZaV1ffzsy3toSp_CL1aI';
var $=function(i){return document.getElementById(i)},p2=function(n){return String(n).padStart(2,'0')},
hm=function(d){return p2(d.getHours())+':'+p2(d.getMinutes())},
dmy=function(d){return p2(d.getDate())+'.'+p2(d.getMonth()+1)+'.'+d.getFullYear()},
say=function(t){typeof dqToast==='function'?dqToast(t):alert(t)};

/* ---------- CSS ---------- */
var st=document.createElement('style');st.textContent=`
.lx-cv{position:relative;overflow:hidden}
.dqv{position:absolute;inset:0;background:linear-gradient(120deg,#071f52,#0a2f7a,#2f63bd,#0a2f7a);background-size:300% 300%;animation:dqvBg 9s ease infinite}
.dqv:before{content:"";position:absolute;inset:0;opacity:.6;background:repeating-linear-gradient(0deg,#ffffff0d 0 1px,transparent 1px 32px),repeating-linear-gradient(90deg,#ffffff0d 0 1px,transparent 1px 32px);-webkit-mask-image:radial-gradient(circle at 50% 50%,#000,transparent 75%);mask-image:radial-gradient(circle at 50% 50%,#000,transparent 75%)}
.dqv:after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,#ffffff40 50%,transparent 60%);transform:translateX(-120%);animation:dqvShine 4.5s ease-in-out infinite}
.dqv .sq{position:absolute;border-radius:22%;transform:rotate(45deg);background:linear-gradient(135deg,#bcd2f5b3,#3f74c940);animation:dqvF 7s ease-in-out infinite}
.dqv .sq.g{background:linear-gradient(135deg,#d9a441cc,#d9a44122)}
.dqv .ring{position:absolute;left:50%;top:50%;width:158px;height:158px;margin:-79px 0 0 -79px;border:2px dashed #d9a441a6;border-radius:50%;animation:dqvR 16s linear infinite}
.dqv .ring i{position:absolute;font-style:normal;font-size:20px;width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;background:#ffffff26;backdrop-filter:blur(4px);display:grid;place-items:center;animation:dqvR 16s linear infinite reverse}
.dqv .pulse{position:absolute;left:50%;top:50%;width:110px;height:110px;margin:-55px 0 0 -55px;border-radius:50%;border:2px solid #fff9;animation:dqvP 2.6s ease-out infinite}
.dqv .pulse.b{animation-delay:1.3s}
.dqv .cap{position:absolute;left:50%;top:50%;font-size:64px;line-height:1;transform:translate(-50%,-50%);animation:dqvCap 3.6s ease-in-out infinite;filter:drop-shadow(0 12px 18px #0006)}
.dqv .cl{position:absolute;left:0;right:0;bottom:10px;height:20px;text-align:center}
.dqv .cl span{position:absolute;left:0;right:0;font:800 12px/20px system-ui,Arial;letter-spacing:2px;text-transform:uppercase;color:#fff;opacity:0;animation:dqvT 9s infinite}
.dqv .cl span:nth-child(2){animation-delay:3s}.dqv .cl span:nth-child(3){animation-delay:6s}
@keyframes dqvBg{50%{background-position:100% 100%}}
@keyframes dqvShine{0%,55%{transform:translateX(-120%)}to{transform:translateX(120%)}}
@keyframes dqvF{50%{transform:rotate(60deg) translate(10px,-18px)}}
@keyframes dqvR{to{transform:rotate(360deg)}}
@keyframes dqvP{0%{transform:scale(.7);opacity:.9}to{transform:scale(2);opacity:0}}
@keyframes dqvCap{0%,100%{transform:translate(-50%,-50%) rotate(-8deg)}30%{transform:translate(-50%,-78%) rotate(10deg) scale(1.06)}60%{transform:translate(-50%,-50%) rotate(-4deg)}}
@keyframes dqvT{0%{opacity:0;transform:translateY(8px)}8%,28%{opacity:1;transform:none}36%,100%{opacity:0;transform:translateY(-8px)}}
#dq-bell{position:fixed;left:14px;bottom:16px;z-index:900;width:46px;height:46px;border:0;border-radius:50%;background:linear-gradient(135deg,#0a2f7a,#2f63bd);color:#fff;font-size:20px;cursor:pointer;box-shadow:0 8px 20px #0a2f7a66}
#dq-bell.on{background:linear-gradient(135deg,#16a34a,#0f7a37)}
#dq-bell:not(.on){animation:dqvRing 2.4s ease-in-out infinite}
@keyframes dqvRing{0%,60%,100%{transform:rotate(0)}65%{transform:rotate(14deg)}75%{transform:rotate(-12deg)}85%{transform:rotate(8deg)}}
#dq-ask{position:fixed;left:12px;right:12px;bottom:74px;z-index:901;max-width:420px;background:#fff;border-radius:18px;padding:16px;box-shadow:0 18px 44px #0f172a59;border-top:4px solid #d9a441;font-family:inherit;animation:dqPop .4s both}
#dq-ask b{display:block;font-size:15px;color:#0a2f7a;margin-bottom:4px}#dq-ask p{margin:0 0 12px;font-size:13px;color:#475569;line-height:1.5}
#dq-ask div{display:flex;gap:8px}#dq-ask button{flex:1;border:0;border-radius:12px;padding:11px;font-weight:800;font-size:14px;cursor:pointer;font-family:inherit}
#dq-ask .y{background:#0a2f7a;color:#fff}#dq-ask .n{background:#eef3fc;color:#0a2f7a}`;
document.head.appendChild(st);

/* ---------- 1. Animasiyalı qapaq (şəkil yoxdursa) ---------- */
var SCENE='<div class="dqv"><i class="sq" style="width:76px;height:76px;left:-18px;top:10%"></i><i class="sq g" style="width:44px;height:44px;right:12%;top:8%;animation-delay:-2s"></i><i class="sq" style="width:96px;height:96px;right:-26px;bottom:6%;animation-delay:-4s"></i><i class="sq g" style="width:34px;height:34px;left:14%;bottom:14%;animation-delay:-1s"></i><div class="ring"><i style="top:0;left:50%">📝</i><i style="top:50%;left:100%">✅</i><i style="top:100%;left:50%">⏱️</i><i style="top:50%;left:0">🏆</i></div><div class="pulse"></div><div class="pulse b"></div><div class="cap">🎓</div><div class="cl"><span>Hazırlaş</span><span>Qeydiyyatdan keç</span><span>Uğur qazan</span></div></div>';
function paint(){document.querySelectorAll('.lx-cv').forEach(function(cv){var bg=cv.style.backgroundImage;if(bg&&bg!=='none'||cv.querySelector('.dqv'))return;cv.textContent='';cv.insertAdjacentHTML('beforeend',SCENE)})}

/* ---------- 2. Admin: paylaşımda görünən kateqoriya ---------- */
function adminFields(){var n=$('lx-name');if(!n||$('lx-catline'))return;
n.closest('.v2-f').insertAdjacentHTML('afterend','<div class="v2-f mt-3"><label>Paylaşımda görünən kateqoriya (təsdiq edin)</label><input class="v2-in" id="lx-catline" placeholder="Məs: BB(Ba,Ac)"><small class="v2-sub">Paylaşım: «Sınaq kateqoriyaları …». Boş qalsa seçilmiş kateqoriya yazılır.</small></div>');
var c=$('lx-cat');if(c){$('lx-catline').value=c.value;c.addEventListener('change',function(){$('lx-catline').value=c.value})}}

/* ---------- 3. Paylaşım mətni (link /qeydiyyat — qapaq şəkli ilə önizləmə) ---------- */
function shareText(x){var s=new Date(x.start),e=LX.endOf(x),same=dmy(s)===dmy(e);
return '📢 '+(x.type||'Qəbul tipli sınaq')+' — Sınaq kateqoriyaları '+(x.catline||x.cat)+
'\n📅 İmtahan günü: '+dmy(s)+(same?'':' – '+dmy(e))+'\n⏰ İştirak vaxtı: '+hm(s)+'–'+hm(e)+' aralığında («İştirak et» paneli bu saatlarda aktiv olur)'+
'\n🔒 Yalnız qeydiyyatdan keçmiş tələbələr · FİN kod ilə yaxud təsdiqlənmiş iştirak kodu ilə.'+
'\n📝 Qeydiyyat üçün:\n🌐 https://exam.dqplatform.workers.dev/qeydiyyat'}
function hook(){if(window.LX&&LX.endOf&&!(LX.shareText&&LX.shareText.__dq)){LX.shareText=shareText;shareText.__dq=1}}

/* ---------- 4. Bildirişlər ---------- */
function u8(u){var b=atob((u+'='.repeat((4-u.length%4)%4)).replace(/-/g,'+').replace(/_/g,'/')),o=new Uint8Array(b.length);for(var i=0;i<b.length;i++)o[i]=b.charCodeAt(i);return o}
function keyOk(k){try{var u=u8(String(k||''));return u.length===65&&u[0]===4}catch(e){return false}}
function sameKey(a,b){if(!a||a.length!==b.length)return false;for(var i=0;i<a.length;i++)if(a[i]!==b[i])return false;return true}
function pushErr(e){var n=e&&e.name,m=String(e&&e.message||e);
if(n==='NotAllowedError')return 'Bildiriş icazəsi bloklanıb. Brauzer ayarlarından bu sayta bildirişə icazə verin.';
if(n==='InvalidAccessError'||/applicationServerKey/i.test(m))return 'Bildiriş açarı (VAPID) düzgün deyil. Administrator ilə əlaqə saxlayın.';
if(n==='AbortError'||/push service|network/i.test(m))return 'Bildiriş xidmətinə qoşulmaq alınmadı. İnterneti yoxlayıb yenidən cəhd edin.';
if(m==='sw-timeout')return 'Xidmət işçisi (service-worker.js) tapılmadı və ya işə düşmədi. Saytı yeniləyib yenidən cəhd edin.';
return 'Bildiriş açılmadı. Bir az sonra yenidən cəhd edin.'}
async function enable(){
if(!('serviceWorker' in navigator)||!('PushManager' in window)||!('Notification' in window)){say('iPhone-da əvvəlcə Safari → Paylaş → «Ana ekrana əlavə et», sonra bildirişi açın.');return}
if(!keyOk(VAPID_PUBLIC)){say('Bildiriş açarı təyin olunmayıb. Administrator ilə əlaqə saxlayın.');return}
if(Notification.permission==='denied'){say('Bildiriş bloklanıb. Brauzer ayarlarından bu sayta icazə verin.');return}
if(await Notification.requestPermission()!=='granted'){say('Bildiriş icazəsi verilmədi');return}
try{var reg=await Promise.race([navigator.serviceWorker.ready,new Promise(function(_,rj){setTimeout(function(){rj(new Error('sw-timeout'))},8000)})]),key=u8(VAPID_PUBLIC),sub=await reg.pushManager.getSubscription();
if(sub){var cur=sub.options&&sub.options.applicationServerKey;if(cur&&!sameKey(new Uint8Array(cur),key)){await sub.unsubscribe();sub=null;try{localStorage.removeItem('dq_push_ep')}catch(x){}}}
sub=sub||await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:key});
var j=sub.toJSON();if(!j||!j.keys)throw new Error('Abunə məlumatı natamamdır');
if(localStorage.getItem('dq_push_ep')!==j.endpoint){await V2.put('push_subs',{endpoint:j.endpoint,p256dh:j.keys.p256dh,auth:j.keys.auth,date:new Date().toISOString()});localStorage.setItem('dq_push_ep',j.endpoint)}
say('🔔 Bildirişlər açıldı');}catch(e){console.warn('[push]',e);say(pushErr(e))}ui()}
function ui(){var on='Notification' in window&&Notification.permission==='granted'&&localStorage.getItem('dq_push_ep'),b=$('dq-bell');
if(!b){b=document.createElement('button');b.id='dq-bell';b.title='Bildirişlər';b.textContent='🔔';b.onclick=function(){on_()?say('Bildirişlər artıq açıqdır ✅'):enable()};document.body.appendChild(b)}
b.classList.toggle('on',!!on);var a=$('dq-ask');a&&on&&a.remove()}
function on_(){return 'Notification' in window&&Notification.permission==='granted'&&localStorage.getItem('dq_push_ep')}
function ask(){if(on_()||!('Notification' in window)||Notification.permission==='denied'||localStorage.getItem('dq_ask_no')||$('dq-ask'))return;
var d=document.createElement('div');d.id='dq-ask';d.innerHTML='<b>🔔 Bildirişləri aç</b><p>Yeni sınaq, test, xəbər və elanlar paylaşılanda dərhal xəbərdar olun.</p><div><button class="n">Sonra</button><button class="y">Aç</button></div>';
d.querySelector('.y').onclick=function(){d.remove();enable()};d.querySelector('.n').onclick=function(){localStorage.setItem('dq_ask_no','1');d.remove()};document.body.appendChild(d)}

/* Admin yeni elan/sınaq yaradanda bildiriş göndər */
function wrapPut(){if(!window.V2||V2.put.__dq)return;var o=V2.put;
V2.put=async function(c,obj,id){
if(c==='liveexams'&&!id){var cl=$('lx-catline');cl&&cl.value.trim()&&(obj.catline=cl.value.trim())}
var r=await o.apply(this,arguments);
if(!id&&(c==='news'||c==='liveexams'))setTimeout(function(){push(c,obj)},400);return r};V2.put.__dq=1}
async function push(c,o){if(!confirm('Bildiriş abunəçilərinə göndərilsin?'))return;
var m=c==='liveexams'?{title:'📢 Yeni sınaq elan olundu',body:o.title+' ('+(o.catline||o.cat)+') — '+dmy(new Date(o.start))+' '+hm(new Date(o.start)),url:'/qeydiyyat',image:'/cover/latest.jpg'}
:{title:'📰 '+(o.kind||'Elan')+': '+o.title,body:String(o.sum||o.body||'').replace(/\s+/g,' ').trim().slice(0,120),url:'/?news='+encodeURIComponent(o.slug||'1'),image:o.slug?'/news-img?id='+encodeURIComponent(o.slug):''};
m.ts=Date.now();
try{await o_put('push_msg',m);var r=await fetch((/workers\.dev$/.test(location.hostname)?'':'https://exam.dqplatform.workers.dev')+'/push/notify',{method:'POST',headers:{'x-admin-key':ADMIN_PASS}});var j=await r.json();say('Bildiriş göndərildi: '+(j.sent||0)+' nəfər')}catch(e){say('Bildiriş göndərilmədi: '+e.message)}}
function o_put(c,o){return V2.put.__raw?V2.put.__raw.call(V2,c,o):V2.put(c,o)}

/* ---------- işə sal ---------- */
var t;new MutationObserver(function(){clearTimeout(t);t=setTimeout(function(){paint();adminFields();hook()},120)}).observe(document.body,{childList:true,subtree:true});
setInterval(function(){hook();wrapPut()},1500);paint();hook();wrapPut();ui();setTimeout(ask,9000);
if(/[?&]reg=1/.test(location.search))setTimeout(function(){try{LXP.open()}catch(e){}},2500);
})();
;

/* ===== dcf-js ===== */
(function(){
"use strict";
var KEY="dq_dt_view",RM=matchMedia("(prefers-reduced-motion: reduce)").matches;
var $=function(i){return document.getElementById(i)};
var esc=function(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})};
var hue=function(s){for(var h=0,i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))%360;return h};
var CID=null;
function mode(){try{return localStorage.getItem(KEY)==="grid"?"grid":"flow"}catch(e){return"flow"}}
function cache(m){try{localStorage.setItem(KEY,m)}catch(e){}}
async function loadMode(){
  try{var r=(await V2.list("dtview"))[0];CID=r?r._id:null;var m=r&&r.mode==="grid"?"grid":"flow";
    if(m!==mode()){cache(m);var s=$("v3-tests");if(s&&s.classList.contains("active")&&s.querySelector(".dt-g, .dcf")&&typeof DT!=="undefined")DT.paint()}}catch(e){}
}

/* Mövcud kartlardan fənn qruplarını çıxarır (şəkillər və sıra eyni qalır) */
function groups(root){
  var by={},order=[],tests=(typeof V3!=="undefined"&&V3.tests)||[];
  root.querySelectorAll(".dt-c").forEach(function(c){
    var m=/openTest\((\d+)\)/.exec(c.getAttribute("onclick")||"");if(!m)return;
    var i=+m[1],t=tests[i];if(!t)return;
    var im=c.querySelector("img"),s=t.subject||"Digər";
    if(!by[s]){by[s]=[];order.push(s)}
    by[s].push({i:i,title:t.title||"Test",q:(t.ans||"").length,src:im?im.src:""});
  });
  return order.map(function(s){return{name:s,items:by[s]}});
}

function carousel(card,g){
  var stage=card.querySelector(".dcf-s"),ring=card.querySelector(".dcf-r"),n=g.items.length;
  var lab=card.querySelector(".dcf-l"),cnt=card.querySelector(".dcf-cur"),bar=card.querySelector(".dcf-p i"),dots=card.querySelector(".dcf-d");
  var active=0,timer=0,st={hover:false,focus:false,vis:true};
  var covers=g.items.map(function(it,k){
    var b=document.createElement("button");b.type="button";b.className="dcf-v";
    b.setAttribute("aria-label",it.title);if(it.src)b.style.backgroundImage='url("'+it.src+'")';
    b.addEventListener("click",function(){k===active?V3.openTest(it.i):(go(k),sync())});
    ring.appendChild(b);return b});
  var dEls=g.items.map(function(it,k){
    var b=document.createElement("button");b.type="button";b.setAttribute("aria-label",it.title);
    b.addEventListener("click",function(){go(k);sync()});dots.appendChild(b);return b});
  function layout(){
    var cw=stage.clientWidth<300?150:200,ch=Math.round(cw*9/16),h=Math.floor(n/2);
    covers.forEach(function(el,i){
      var off=i-active;if(off>h)off-=n;if(off<-h)off+=n;var a=Math.abs(off);
      el.style.width=cw+"px";el.style.height=ch+"px";el.style.margin=(-ch/2)+"px 0 0 "+(-cw/2)+"px";
      el.style.transform="translateX("+off*Math.round(cw*.38)+"px) translateZ("+(-a*120)+"px) rotateY("+(-off*36)+"deg) scale("+(1-a*.13)+")";
      el.style.zIndex=20-a;el.style.opacity=a>2?"0":"1";el.style.filter=a?"brightness("+(1-a*.25)+")":"none";
      el.tabIndex=a?-1:0;el.classList.toggle("on",!off)});
  }
  function go(i){
    active=((i%n)+n)%n;layout();var it=g.items[active];
    lab.innerHTML=esc(it.title)+"<small>• "+it.q+" sual</small>";
    cnt.textContent=String(active+1).padStart(2,"0");
    dEls.forEach(function(d,k){d.setAttribute("aria-current",k===active)});
  }
  function stop(){clearInterval(timer);timer=0;bar.style.transition="none";bar.style.width="0%"}
  function sync(){
    stop();
    if(RM||n<2||st.hover||st.focus||!st.vis||document.hidden)return;
    void bar.offsetWidth;bar.style.transition="width 3200ms linear";bar.style.width="100%";
    timer=setInterval(function(){if(!card.isConnected){stop();return}go(active+1)},3200);
  }
  card.addEventListener("mouseenter",function(){st.hover=true;sync()});
  card.addEventListener("mouseleave",function(){st.hover=false;sync()});
  card.addEventListener("focusin",function(){st.focus=true;sync()});
  card.addEventListener("focusout",function(){st.focus=false;sync()});
  stage.addEventListener("keydown",function(e){
    if(e.key==="ArrowRight"){e.preventDefault();go(active+1)}else if(e.key==="ArrowLeft"){e.preventDefault();go(active-1)}});
  var sx=null;
  stage.addEventListener("pointerdown",function(e){if(e.pointerType!=="mouse")sx=e.clientX});
  stage.addEventListener("pointerup",function(e){
    if(sx===null)return;var dx=e.clientX-sx;sx=null;if(Math.abs(dx)>40){go(active+(dx<0?1:-1));sync()}});
  card.querySelector(".dcf-b").addEventListener("click",function(){V3.openTest(g.items[active].i)});
  var io=new IntersectionObserver(function(es){st.vis=es[0].isIntersecting;sync()});io.observe(card);
  document.addEventListener("visibilitychange",function vc(){
    if(!card.isConnected){document.removeEventListener("visibilitychange",vc);io.disconnect();return}sync()});
  go(0);sync();
}

function enhance(){
  var root=$("v3-tests");if(!root)return;
  var grid=root.querySelector(".dt-g"),sec=root.querySelector(".dt-sec");if(!grid||!sec)return;
  var m=mode();
  if(m!=="flow")return;
  var gs=groups(root);if(!gs.length)return;
  var wrap=document.createElement("div");wrap.className="dcf";
  gs.forEach(function(g){
    var h=hue(g.name),tot=g.items.reduce(function(a,x){return a+x.q},0),card=document.createElement("article");
    card.className="dcf-c";
    card.innerHTML='<div class="dcf-h"><div class="dcf-i" style="background:linear-gradient(135deg,hsl('+h+',62%,38%),hsl('+((h+45)%360)+',70%,52%))" aria-hidden="true">'+esc(g.name.charAt(0).toUpperCase())+'</div><div class="dcf-t"><b>'+esc(g.name)+'</b><small>'+g.items.length+' test • '+tot+' sual</small></div><div class="dcf-n" aria-hidden="true"><span class="dcf-cur">01</span> <em>/ '+String(g.items.length).padStart(2,"0")+'</em></div></div>'
      +'<div class="dcf-s" role="group" aria-roledescription="karusel" aria-label="'+esc(g.name)+' testləri" tabindex="0"><div class="dcf-r"></div></div>'
      +'<div class="dcf-l" aria-live="polite"></div><div class="dcf-d"></div><div class="dcf-p" aria-hidden="true"><i></i></div>'
      +'<button type="button" class="dcf-b">Testə başla</button>';
    wrap.appendChild(card);carousel(card,g);
  });
  grid.style.display="none";grid.parentNode.insertBefore(wrap,grid);
}

function hook(){
  if(!window.DT||typeof DT.paint!=="function"||typeof V3==="undefined")return false;
  if(DT.__dcf)return true;DT.__dcf=1;
  if(typeof V3.tTxt==="function"&&!V3.__dcfT){V3.__dcfT=1;var oT=V3.tTxt;V3.tTxt=function(){oT.apply(this,arguments);try{adminCard()}catch(e){console.error("[dcf]",e)}}}
  loadMode();
  var o=DT.paint;
  DT.paint=function(){var r=o.apply(this,arguments);try{enhance()}catch(e){console.error("[dcf]",e)}return r};
  var s=$("v3-tests");if(s&&s.classList.contains("active")&&s.querySelector(".dt-g")&&!s.querySelector(".dcf-tg"))DT.paint();
  return true;
}
if(!hook()){var n=0,iv=setInterval(function(){(hook()||++n>400)&&clearInterval(iv)},100)}
})();
;

/* ===== tm-js ===== */
(function () {
"use strict";
/* ===== TM — Testlər idarəsi =====
   Sahələr (v3tests): title, subject, img, ans, qcount, mins, notify, status("hidden").
   • ans boşdur  → "Tezliklə" (sual əlavə olunmayıb) — iştirakçılar yalnız bildiriş görür
   • ans dolu    → aktiv test
   • status=hidden → admin-dən başqa heç kim görmür
   Köhnə testlər (qcount/mins/status yoxdur) dəyişmədən aktiv qalır. */
var COLL = "v3tests", CFGC = "tmcfg", VIEWC = "dtview", SEEN = "tm_seen_soon", VKEY = "dq_dt_view";
var D = document, raw = 0, rawList = null, cfg = { notify: true }, cfgId = null, viewId = null, view = "flow";
var ST = { tab: "list", q: "", f: "all", list: null, ed: null, busy: false, host: null, loading: false };

function $(i) { return D.getElementById(i); }
function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
function num(v, d, lo, hi) { var n = parseInt(v, 10); if (!(n >= lo)) return d; return Math.min(n, hi); }
function isShell(t) { return !(t && t.ans && t.ans.length); }
function isHidden(t) { return !!t && t.status === "hidden"; }
function isLive(t) { return !!t && !isShell(t) && !isHidden(t); }
function qn(t) { return isShell(t) ? num(t.qcount, 0, 0, 500) : t.ans.length; }
function mins(t) { return num(t.mins, 10, 1, 300); }
function wantsNotify(t) { return t.notify !== false && t.notify !== "false"; }
function toast(m, err) {
  var o = D.createElement("div"); o.className = "tm-toast" + (err ? " err" : ""); o.setAttribute("role", "status"); o.textContent = m;
  D.body.appendChild(o); setTimeout(function () { o.remove(); }, 2800);
}

/* ---------- Məlumat qatı ---------- */
async function all() { raw++; try { return await rawList.call(V2, COLL); } finally { raw--; } }
async function save(obj, id) {
  await V2.put(COLL, obj, id || undefined); liteAt = 0;
}
async function removeRow(id) {
  await V2.probe();
  if (V2.mode === "cloud") {
    var r = await _supabase.from("dq_v2_store").delete().eq("id", id);
    if (r.error) throw r.error;
  } else {
    var l = await all();
    localStorage.setItem("dq_v2_" + COLL, JSON.stringify(l.filter(function (x) { return x._id != id; })));
  }
  liteAt = 0;
}
async function loadCfg() {
  try {
    var c = (await V2.list(CFGC))[0]; if (c) { cfgId = c._id; cfg.notify = c.notify !== false; }
    var v = (await V2.list(VIEWC))[0]; if (v) { viewId = v._id; view = v.mode === "grid" ? "grid" : "flow"; }
    else { try { view = localStorage.getItem(VKEY) === "grid" ? "grid" : "flow"; } catch (e) { } }
  } catch (e) { console.warn("[tm] ayarlar oxunmadı", e); }
}

/* "Tezliklə" siyahısı (yüngül sorğu — şəkilləri yükləmir) */
var liteAt = 0, liteCache = [];
async function soonLite(force) {
  if (!force && Date.now() - liteAt < 30000) return liteCache;
  var rows = [];
  try {
    await V2.probe();
    if (V2.mode === "cloud") {
      var r = await _supabase.from("dq_v2_store")
        .select("id,title:data->>title,subject:data->>subject,ans:data->>ans,status:data->>status,qcount:data->>qcount,mins:data->>mins,notify:data->>notify")
        .eq("collection", COLL).order("id", { ascending: false });
      if (r.error) throw r.error;
      rows = (r.data || []).map(function (x) { x._id = x.id; return x; });
    } else rows = await all();
  } catch (e) { console.warn("[tm]", e); return liteCache; }
  liteCache = rows.filter(function (t) { return t.title && isShell(t) && !isHidden(t); });
  liteAt = Date.now(); return liteCache;
}

/* ---------- Dialoqlar ---------- */
function dialog(html, onMount) {
  var ov = D.createElement("div"); ov.className = "tm-ov";
  ov.innerHTML = '<div class="tm-dlg" role="dialog" aria-modal="true">' + html + "</div>";
  var prev = D.activeElement;
  function close() { ov.remove(); D.removeEventListener("keydown", key, true); prev && prev.focus && prev.focus(); }
  function key(e) { if (e.key === "Escape") { e.stopPropagation(); close(); } }
  D.addEventListener("keydown", key, true); D.body.appendChild(ov);
  onMount && onMount(ov, close);
  var f = ov.querySelector("[data-focus]") || ov.querySelector("button"); f && f.focus();
  return close;
}
function ask(title, text, okLabel, danger) {
  return new Promise(function (res) {
    dialog('<h3>' + esc(title) + '</h3><p>' + esc(text) + '</p><div class="row"><button class="tm-b o" data-r="0">Ləğv et</button><button class="tm-b ' + (danger ? "x" : "") + '" data-r="1" data-focus>' + esc(okLabel || "Təsdiq") + "</button></div>",
      function (ov, close) {
        ov.addEventListener("click", function (e) { var b = e.target.closest("[data-r]"); if (b) { close(); res(b.dataset.r === "1"); } else if (e.target === ov) { close(); res(false); } });
      });
  });
}

/* ---------- Admin paneli ---------- */
function blankEd() { return { id: null, title: "", subject: "", qcount: 10, mins: 10, notify: true, hidden: false, img: "", ans: [], keep: null }; }
function padAns(a, n) { a = a.slice(0, n); while (a.length < n) a.push(""); return a; }
function edFrom(t) {
  var n = qn(t) || 10, a = isShell(t) ? [] : t.ans.split("").map(function (x) { return x === "-" ? "" : x; });
  return { id: t._id, title: t.title || "", subject: t.subject || "", qcount: n, mins: mins(t), notify: wantsNotify(t), hidden: isHidden(t), img: t.img || "", ans: padAns(a, n), keep: t };
}
function status(t) { return isHidden(t) ? ["hid", "🙈 Gizli"] : isShell(t) ? ["soon", "⏳ Tezliklə"] : ["live", "🟢 Aktiv"]; }

async function refresh() {
  ST.loading = true; draw();
  try { ST.list = await all(); } catch (e) { ST.list = []; toast("Testlər yüklənmədi: " + (e && e.message || e), true); }
  ST.loading = false; draw();
}
function mount(host) {
  ST.host = host; ST.tab = ST.tab === "edit" && !ST.ed ? "list" : ST.tab;
  if (!host.__tm) {
    host.__tm = 1;
    host.addEventListener("click", onClick); host.addEventListener("input", onInput); host.addEventListener("change", onInput);
  }
  loadCfg().then(function () { ST.list ? draw() : refresh(); });
  ST.list ? draw() : refresh();
}
function open() {
  var r = $("tm-root");
  if (!r) { r = D.createElement("div"); r.id = "tm-root"; r.setAttribute("role", "region"); r.setAttribute("aria-label", "Testlər idarəsi"); D.body.appendChild(r); }
  r.classList.add("open"); D.body.style.overflow = "hidden"; r.scrollTop = 0; ST.tab = "list"; ST.ed = null; ST.list = null;
  mount(r);
}
function close() { var r = $("tm-root"); if (r) r.classList.remove("open"); D.body.style.overflow = ""; }

function tabsHtml() {
  var T = [["list", "📋 Testlər"], ["edit", ST.ed && ST.ed.id ? "✏️ Redaktə" : "➕ Yeni test"], ["set", "⚙️ Ayarlar"]];
  return '<div class="tm-tabs" role="tablist">' + T.map(function (t) { return '<button role="tab" data-act="tab" data-v="' + t[0] + '" aria-selected="' + (ST.tab === t[0]) + '">' + t[1] + "</button>"; }).join("") + "</div>";
}
function draw() {
  var h = ST.host; if (!h) return;
  var st = D.activeElement && D.activeElement.dataset && D.activeElement.dataset.f;
  var isRoot = h.id === "tm-root";
  h.innerHTML = '<div class="tm"><div class="tm-top"><div><h2>🗂️ Testlər idarəsi</h2><small>Test yarat, sual sayını təyin et, sualları sonra əlavə et</small></div>' +
    (isRoot ? '<button class="tm-b o" data-act="close">✕ Bağla</button>' : "") + "</div>" + tabsHtml() +
    (ST.tab === "list" ? listHtml() : ST.tab === "edit" ? editHtml() : setHtml()) + "</div>";
  if (ST.tab === "edit") gridDraw();
  if (st) { var el = h.querySelector('[data-f="' + st + '"]'); if (el && el.focus) { el.focus(); try { var l = el.value.length; el.setSelectionRange(l, l); } catch (e) { } } }
}
function listHtml() {
  if (ST.loading && !ST.list) return '<div class="tm-empty">Yüklənir…</div>';
  var L = ST.list || [], c = { live: 0, soon: 0, hid: 0 };
  L.forEach(function (t) { c[status(t)[0]]++; });
  var q = ST.q.trim().toLocaleLowerCase("az"), rows = L.filter(function (t) {
    var s = status(t)[0]; if (ST.f !== "all" && ST.f !== s) return false;
    return !q || (String(t.title || "") + " " + String(t.subject || "")).toLocaleLowerCase("az").indexOf(q) > -1;
  });
  var chip = function (k, l) { return '<button data-act="flt" data-v="' + k + '" aria-pressed="' + (ST.f === k) + '">' + l + "</button>"; };
  return '<div class="tm-stats"><div class="tm-stat"><b>' + L.length + '</b><span>Cəmi</span></div><div class="tm-stat"><b>' + c.live + '</b><span>Aktiv</span></div><div class="tm-stat"><b>' + c.soon + '</b><span>Tezliklə</span></div><div class="tm-stat"><b>' + c.hid + "</b><span>Gizli</span></div></div>" +
    '<div class="tm-bar"><input class="tm-in" type="search" data-f="q" placeholder="Ad və ya fənn üzrə axtar…" value="' + esc(ST.q) + '" aria-label="Axtar"><button class="tm-b g" data-act="new">➕ Yeni test</button></div>' +
    '<div class="tm-chips">' + chip("all", "Hamısı") + chip("live", "Aktiv") + chip("soon", "Tezliklə") + chip("hid", "Gizli") + "</div>" +
    (rows.length ? rows.map(function (t) {
      var s = status(t), shell = isShell(t);
      return '<div class="tm-item"><div><h4>' + esc(t.title) + '</h4><div class="tm-meta"><span class="tm-tag ' + s[0] + '">' + s[1] + "</span><span>📚 " + esc(t.subject || "Digər") + "</span><span>❓ " + qn(t) + " sual</span><span>⏱ " + mins(t) + " dəq</span>" + (shell ? "<span>• sual əlavə olunmayıb</span>" : "") + '</div></div><div class="tm-act">' +
        '<button class="tm-b s ' + (shell ? "g" : "o") + '" data-act="edit" data-id="' + esc(t._id) + '">' + (shell ? "➕ Sual əlavə et" : "✏️ Redaktə") + "</button>" +
        '<button class="tm-b s o" data-act="vis" data-id="' + esc(t._id) + '">' + (isHidden(t) ? "👁 Göstər" : "🙈 Gizlət") + "</button>" +
        '<button class="tm-b s x" data-act="del" data-id="' + esc(t._id) + '" aria-label="Sil">🗑 Sil</button></div></div>';
    }).join("") : '<div class="tm-empty">' + (L.length ? "Filtrə uyğun test tapılmadı." : "Hələ test yoxdur. «Yeni test» düyməsi ilə başlayın.") + "</div>");
}
function editHtml() {
  var e = ST.ed || (ST.ed = blankEd()), subs = {};
  ["Azərbaycan dili", "Qanunvericilik", "İnformatika", "Məntiq", "Riyaziyyat", "Tarix"].forEach(function (s) { subs[s] = 1; });
  (ST.list || []).forEach(function (t) { t.subject && (subs[t.subject] = 1); });
  return '<div class="tm-card"><h3>1. Əsas məlumat</h3><div class="tm-2"><div><label class="tm-lb" for="tm-t">Test adı <em>*</em></label><input class="tm-in" id="tm-t" data-f="title" maxlength="120" value="' + esc(e.title) + '" placeholder="məs: Ümumi məntiq testi">' +
    '<label class="tm-lb" for="tm-s">Fənn</label><input class="tm-in" id="tm-s" data-f="subject" list="tm-sl" maxlength="60" value="' + esc(e.subject) + '" placeholder="Fənn seçin və ya yazın"><datalist id="tm-sl">' + Object.keys(subs).map(function (s) { return '<option value="' + esc(s) + '">'; }).join("") + "</datalist></div>" +
    '<div><label class="tm-lb" for="tm-n">Sual sayı <em>*</em></label><div class="tm-step"><button class="tm-b o s" data-act="qn" data-v="-1" aria-label="Azalt">−</button><input class="tm-in" id="tm-n" data-f="qcount" type="number" inputmode="numeric" min="1" max="200" value="' + e.qcount + '"><button class="tm-b o s" data-act="qn" data-v="1" aria-label="Artır">＋</button></div>' +
    '<label class="tm-lb" for="tm-m">Müddət (dəqiqə)</label><input class="tm-in" id="tm-m" data-f="mins" type="number" inputmode="numeric" min="1" max="300" value="' + e.mins + '" style="max-width:150px"></div></div>' +
    '<label class="tm-opt"><input type="checkbox" data-f="notify"' + (e.notify ? " checked" : "") + '><span><b>Sual əlavə olunmayıbsa «Tezliklə» bildirişi göstər</b><small>İştirakçılar daxil olanda testin adı və sual sayı ilə bildiriş görəcək.</small></span></label>' +
    '<label class="tm-opt"><input type="checkbox" data-f="hidden"' + (e.hidden ? " checked" : "") + '><span><b>Platformada gizlət</b><small>Gizli test iştirakçılara nə test, nə də bildiriş kimi göstərilir.</small></span></label></div>' +
    '<div class="tm-card"><h3>2. Suallar <small style="font-weight:500;color:#64748b">(istəsəniz sonra əlavə edin)</small></h3>' +
    '<label class="tm-lb" for="tm-f">Test şəkli</label><input class="tm-in" id="tm-f" type="file" accept="image/*" data-f="file">' +
    '<div id="tm-pvw">' + (e.img ? '<img class="tm-pv" alt="Test şəkli" src="' + esc(e.img) + '"><div style="margin-top:8px"><button class="tm-b x s" data-act="rmimg">Şəkli sil</button></div>' : "") + "</div>" +
    '<label class="tm-lb" for="tm-a">Cavab açarı <span style="font-weight:500;color:#64748b">(ABCDA… və ya 1A 2B 3C…)</span></label><textarea class="tm-in" id="tm-a" data-f="bulk" rows="3" placeholder="məs: ABCDEABCDE"></textarea>' +
    '<div class="tm-hint" id="tm-cnt"></div><div class="tm-prog"><i id="tm-pg"></i></div><div class="tm-grid" id="tm-grid" role="group" aria-label="Cavablar"></div><div class="tm-hint">Xanaya toxunun: A → B → C → D → E → boş.</div></div>' +
    '<div class="tm-sticky"><button class="tm-b g" data-act="save"' + (ST.busy ? " disabled" : "") + '>💾 Yadda saxla</button><button class="tm-b o" data-act="cancel">Ləğv et</button></div>';
}
function gridDraw() {
  var e = ST.ed, g = $("tm-grid"); if (!e || !g) return;
  var done = e.ans.filter(Boolean).length, n = e.ans.length;
  g.innerHTML = e.ans.map(function (a, i) { return '<button type="button" class="tm-cell ' + (a ? "on" : "") + '" data-act="cyc" data-i="' + i + '" aria-label="Sual ' + (i + 1) + ", cavab: " + (a || "boş") + '">' + (i + 1) + "<b>" + (a || "·") + "</b></button>"; }).join("");
  var c = $("tm-cnt"); if (c) c.textContent = done + " / " + n + " sual cavablandırılıb" + (e.img ? "" : " · şəkil əlavə olunmayıb");
  var p = $("tm-pg"); if (p) p.style.width = (n ? done / n * 100 : 0) + "%";
}
function setHtml() {
  var o = function (v, t, d) { return '<label class="tm-opt"><input type="radio" name="tm-v" data-f="view" value="' + v + '"' + (view === v ? " checked" : "") + "><span><b>" + t + "</b><small>" + d + "</small></span></label>"; };
  return '<div class="tm-card"><h3>🎞 Testlər bölməsinin görünüşü</h3><div class="tm-hint" style="margin:0 0 6px">Bütün iştirakçılar üçün fənn testləri bu formada göstərilir.</div>' +
    o("flow", "3D karusel", "Hər fənn üçün ayrı kart, testlər fırlanan qabıq kimi.") + o("grid", "Siyahı (kartlar)", "Sadə və sürətli kart şəbəkəsi.") + "</div>" +
    '<div class="tm-card"><h3>🔔 Bildirişlər</h3><label class="tm-opt"><input type="checkbox" data-f="gnotify"' + (cfg.notify ? " checked" : "") + '><span><b>«Tezliklə» bildirişini iştirakçılara göstər</b><small>Söndürsəniz, yalnız testlər siyahısında «Tezliklə» kartı qalır, pəncərə açılmır.</small></span></label></div>' +
    '<div class="tm-sticky"><button class="tm-b g" data-act="saveset">💾 Ayarları saxla</button></div>';
}

/* ---------- Hadisələr ---------- */
function find(id) { return (ST.list || []).filter(function (t) { return String(t._id) === String(id); })[0]; }
function parseAns(v) {
  var s = String(v || "").toUpperCase(), out = [], re = /(\d+)\s*[-.):]?\s*([A-E])/g, m, found = false;
  while ((m = re.exec(s))) { found = true; var i = +m[1] - 1; if (i >= 0 && i < 500) out[i] = m[2]; }
  if (!found) s.replace(/[^A-E\-]/g, "").split("").forEach(function (c, i) { out[i] = c === "-" ? "" : c; });
  for (var k = 0; k < out.length; k++) out[k] = out[k] || "";
  return out;
}
function onInput(ev) {
  var t = ev.target, f = t.dataset && t.dataset.f; if (!f) return;
  var e = ST.ed;
  if (f === "q") { ST.q = t.value; var pos = t.selectionStart; draw(); var el = ST.host.querySelector('[data-f="q"]'); el && el.focus(); try { el.setSelectionRange(pos, pos); } catch (x) { } return; }
  if (f === "view") { view = t.value === "grid" ? "grid" : "flow"; return; }
  if (f === "gnotify") { cfg.notify = t.checked; return; }
  if (!e) return;
  if (f === "title" || f === "subject") e[f] = t.value;
  else if (f === "mins") e.mins = num(t.value, 10, 1, 300);
  else if (f === "notify") e.notify = t.checked;
  else if (f === "hidden") e.hidden = t.checked;
  else if (f === "qcount" && ev.type === "change") setQ(num(t.value, e.qcount, 1, 200));
  else if (f === "bulk") { var p = parseAns(t.value); if (p.length) { if (p.length > 200) p = p.slice(0, 200); if (p.length > e.ans.length) { e.qcount = p.length; e.ans = padAns(p, p.length); var n = $("tm-n"); n && (n.value = p.length); } else e.ans = padAns(p, e.ans.length); gridDraw(); } }
  else if (f === "file" && ev.type === "change") pickImg(t);
}
async function setQ(n) {
  var e = ST.ed; n = Math.max(1, Math.min(200, n));
  if (n < e.ans.length && e.ans.slice(n).some(Boolean) && !await ask("Sual sayı azaldılsın?", "Sonuncu " + (e.ans.length - n) + " sualın cavabları silinəcək.", "Azalt", true)) { var i = $("tm-n"); i && (i.value = e.qcount); return; }
  e.qcount = n; e.ans = padAns(e.ans, n); var el = $("tm-n"); el && (el.value = n); gridDraw();
}
function pickImg(inp) {
  var f = inp.files && inp.files[0]; if (!f) return;
  if (!/^image\//.test(f.type)) { toast("Yalnız şəkil faylı seçin", true); inp.value = ""; return; }
  if (f.size > 15 * 1048576) { toast("Şəkil çox böyükdür (maks. 15 MB)", true); inp.value = ""; return; }
  var r = new FileReader();
  r.onerror = function () { toast("Şəkil oxunmadı", true); };
  r.onload = function () {
    var im = new Image();
    im.onerror = function () { toast("Şəkil açılmadı", true); };
    im.onload = function () {
      var k = Math.min(1, 1400 / im.width), c = D.createElement("canvas"); c.width = Math.round(im.width * k); c.height = Math.round(im.height * k);
      c.getContext("2d").drawImage(im, 0, 0, c.width, c.height); ST.ed.img = c.toDataURL("image/jpeg", .75);
      var b = $("tm-pvw"); if (b) b.innerHTML = '<img class="tm-pv" alt="Test şəkli" src="' + ST.ed.img + '"><div style="margin-top:8px"><button class="tm-b x s" data-act="rmimg">Şəkli sil</button></div>';
      gridDraw();
    };
    im.src = r.result;
  };
  r.readAsDataURL(f);
}
async function onClick(ev) {
  var b = ev.target.closest("[data-act]"); if (!b || !ST.host.contains(b)) return;
  var a = b.dataset.act, id = b.dataset.id, e = ST.ed;
  if (a === "close") return close();
  if (a === "tab") { ST.tab = b.dataset.v; if (ST.tab === "edit" && !ST.ed) ST.ed = blankEd(); return draw(); }
  if (a === "flt") { ST.f = b.dataset.v; return draw(); }
  if (a === "new") { ST.ed = blankEd(); ST.tab = "edit"; draw(); return scrollTo0(); }
  if (a === "edit") { var t = find(id); if (!t) return; ST.ed = edFrom(t); ST.tab = "edit"; draw(); return scrollTo0(); }
  if (a === "cancel") { ST.ed = null; ST.tab = "list"; return draw(); }
  if (a === "qn") return e && setQ(e.qcount + (+b.dataset.v));
  if (a === "cyc") { var L = ["", "A", "B", "C", "D", "E"], i = +b.dataset.i; e.ans[i] = L[(L.indexOf(e.ans[i]) + 1) % 6]; return gridDraw(); }
  if (a === "rmimg") { e.img = ""; var p = $("tm-pvw"); p && (p.innerHTML = ""); var fi = $("tm-f"); fi && (fi.value = ""); return gridDraw(); }
  if (a === "vis") return toggleVis(id);
  if (a === "del") return del(id);
  if (a === "save") return saveEd();
  if (a === "saveset") return saveSet(b);
}
function scrollTo0() { var r = $("tm-root"); r && (r.scrollTop = 0); window.scrollTo && window.scrollTo(0, 0); }
async function guard(fn) {
  if (ST.busy) return; ST.busy = true;
  try { await fn(); } catch (e) { console.error("[tm]", e); toast("Xəta: " + (e && e.message || e), true); } finally { ST.busy = false; }
}
function payloadFrom(e) {
  var n = e.ans.length, filled = e.ans.filter(Boolean).length, hasQ = !!e.img && filled > 0, o = {};
  if (e.keep) Object.keys(e.keep).forEach(function (k) { if (k !== "_id") o[k] = e.keep[k]; });   /* naməlum sahələr itməsin */
  o.title = e.title.trim(); o.subject = e.subject.trim() || "Digər"; o.qcount = n; o.mins = e.mins; o.notify = e.notify;
  o.img = hasQ ? e.img : ""; o.ans = hasQ ? e.ans.map(function (x) { return x || "-"; }).join("") : "";
  if (e.hidden) o.status = "hidden"; else delete o.status;
  return o;
}
async function saveEd() {
  var e = ST.ed; if (!e) return;
  e.title = ($("tm-t") || {}).value || e.title; e.subject = ($("tm-s") || {}).value || e.subject;
  if (e.title.trim().length < 2) { toast("Test adını yazın (ən azı 2 simvol)", true); var t = $("tm-t"); t && t.focus(); return; }
  var filled = e.ans.filter(Boolean).length, n = e.ans.length;
  if (e.img && !filled) { toast("Şəkil var, amma cavab açarı boşdur. Cavabları daxil edin və ya şəkli silin.", true); return; }
  if (filled && !e.img) { toast("Cavablar var, amma test şəkli yoxdur. Şəkil əlavə edin.", true); return; }
  if (filled && filled < n && !await ask("Bəzi cavablar boşdur", (n - filled) + " sualın cavabı daxil edilməyib. Yenə də saxlansın?", "Saxla")) return;
  var live = e.img && filled && !e.hidden;
  await guard(async function () {
    await save(payloadFrom(e), e.id);
    toast(live ? "Test saxlanıldı və aktiv edildi ✅" : e.hidden ? "Test saxlanıldı (gizli) ✅" : "Test «Tezliklə» kimi saxlanıldı ⏳");
    ST.ed = null; ST.tab = "list"; ST.list = await all();
  });
  draw();
}
async function toggleVis(id) {
  var t = find(id); if (!t) return;
  await guard(async function () {
    var o = {}; Object.keys(t).forEach(function (k) { if (k !== "_id") o[k] = t[k]; });
    if (isHidden(t)) delete o.status; else o.status = "hidden";
    await save(o, t._id); ST.list = await all(); toast(isHidden(t) ? "Test göstərildi" : "Test gizlədildi");
  });
  draw();
}
async function del(id) {
  var t = find(id); if (!t) return;
  if (!await ask("Test silinsin?", "«" + t.title + "» həmişəlik silinəcək. Bu əməliyyat geri qaytarılmır.", "Sil", true)) return;
  await guard(async function () { await removeRow(t._id); ST.list = await all(); toast("Test silindi"); });
  draw();
}
async function saveSet(btn) {
  await guard(async function () {
    await V2.put(VIEWC, { mode: view }, viewId || undefined); try { localStorage.setItem(VKEY, view); } catch (e) { }
    await V2.put(CFGC, { notify: !!cfg.notify }, cfgId || undefined); liteAt = 0;
    await loadCfg(); toast("Ayarlar saxlanıldı ✅");
  });
}

/* ---------- İştirakçı tərəfi: «Tezliklə» ---------- */
function soonCards(list) {
  return '<div class="tm-soon-g">' + list.map(function (t) {
    return '<article class="tm-sc"><span class="bd">TEZLİKLƏ</span><div class="ic" aria-hidden="true">⏳</div><h4>' + esc(t.title) + '</h4><div class="m"><span>📚 ' + esc(t.subject || "Digər") + "</span>" + (qn(t) ? "<span>❓ " + qn(t) + " sual</span>" : "") + "<span>⏱ " + mins(t) + " dəq</span></div><p>Suallar hazırlanır — hazır olan kimi burada görünəcək.</p></article>";
  }).join("") + "</div>";
}
async function decorate() {
  var root = $("v3-tests"); if (!root || !root.classList.contains("active")) return;
  var list = await soonLite(); root = $("v3-tests");
  if (!list.length || !root || root.querySelector(".tm-soon")) return;
  var sec = root.querySelector(".dt-sec"), box = D.createElement("section"); box.className = "tm-soon";
  box.innerHTML = '<div class="tm-soon-h"><b>⏳ Tezliklə</b><small>' + list.length + " test</small></div>" + soonCards(list);
  if (sec) sec.parentNode.insertBefore(box, sec); else (root.querySelector(".dt-w") || root).appendChild(box);
  popup(list);
}
function seen() { try { return JSON.parse(localStorage.getItem(SEEN) || "[]"); } catch (e) { return []; } }
function popup(list) {
  if (cfg.notify === false || $("tm-pop")) return;
  var s = seen(), fresh = list.filter(function (t) { return wantsNotify(t) && s.indexOf(String(t._id)) < 0; });
  if (!fresh.length) return;
  var done = function () { try { localStorage.setItem(SEEN, JSON.stringify(s.concat(fresh.map(function (t) { return String(t._id); })).slice(-200))); } catch (e) { } };
  dialog('<h3>🔔 Tezliklə ' + (fresh.length > 1 ? "yeni testlər" : "yeni test") + '</h3><p>Aşağıdakı ' + (fresh.length > 1 ? "testlərin" : "testin") + ' sualları hazırlanır. Hazır olan kimi «Testlər» bölməsində görünəcək.</p>' +
    fresh.slice(0, 5).map(function (t) { return '<div class="tm-pl"><span style="font-size:22px">⏳</span><div><b>' + esc(t.title) + "</b><small>" + esc(t.subject || "Digər") + (qn(t) ? " · " + qn(t) + " sual" : "") + " · " + mins(t) + " dəq</small></div></div>"; }).join("") +
    (fresh.length > 5 ? '<p style="margin:10px 0 0">…və daha ' + (fresh.length - 5) + " test</p>" : "") + '<div class="row"><button class="tm-b g" data-ok data-focus>Aydındır</button></div>',
    function (o, c) { o.id = "tm-pop"; o.addEventListener("click", function (e) { if (e.target === o || e.target.closest("[data-ok]")) { done(); c(); } }); });
}
async function cabBadge() {
  var el = $("tm-cab-sub"); if (!el) return;
  var list = await soonLite(); el.textContent = list.length ? "⏳ " + list.length + " test tezliklə əlavə olunacaq" : "Fənn testləri və sınaqlar";
  var s = $("exam-select-screen"); s && s.classList.contains("active") && popup(list);
}
async function cabTests() {
  var b = $("dq-cb"); if (!b) return; var list = await soonLite();
  b.innerHTML = '<div class="dq-cd"><b>📝 İmtahan bölməsi</b><p style="color:#64748b;margin:6px 0 12px">Fənn testləri və sınaqlar bu bölmədə həll edilir.</p><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="v3-bt" onclick="V3.showTests()">📝 Testlərə daxil ol</button><button class="v3-bt o" onclick="YQ2.startExam()">🎓 Sınaqlara keç</button></div></div>' +
    (list.length ? '<div class="dq-cd"><b>⏳ Tezliklə</b><div class="tm-soon" style="margin-top:10px">' + soonCards(list) + "</div></div>" : "");
  popup(list);
}


/* Admin panelə kart əlavə et (panel sonradan yenidən qurulsa belə qaytarır) */
function ensureCard() {
  var grid = D.querySelector("#admin-panel .admin-nav-grid"); if (!grid || grid.querySelector("[data-tm-card]")) return;
  var c = D.createElement("div"); c.className = "admin-nav-card"; c.setAttribute("data-tm-card", "1"); c.setAttribute("role", "button"); c.tabIndex = 0;
  c.style.cssText = "background:#0e7490;color:#fff"; c.innerHTML = '<span class="icon">🗂️</span> Testlər idarəsi';
  c.addEventListener("click", open); c.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); } });
  grid.appendChild(c);
}
function watchCard() {
  var t = 0; ensureCard();
  new MutationObserver(function () { clearTimeout(t); t = setTimeout(ensureCard, 120); }).observe(D.body, { childList: true, subtree: true });
}

/* ---------- Quraşdırma ---------- */
function install() {
  rawList = V2.list; var rawPut = V2.put;
  V2.list = async function (c) {
    var r = await rawList.apply(this, arguments);
    return c === COLL && !raw ? r.filter(isLive) : r;       /* iştirakçıya yalnız aktiv testlər */
  };
  V2.put = async function (c) { raw++; try { return await rawPut.apply(this, arguments); } finally { raw--; } };
  V3.tTst = function () { mount(V3.$("v3-body")); };         /* V3 paneldəki «Testlər» tabı */
  window.TM = { open: open, close: close, mount: mount };

  /* Naviqasiya: giriş səhifəsi həmişə şəxsi kabinetə aparır (köhnə «tests» niyyəti qalmasın) */
  var oS = showScreen;
  showScreen = function (id) { if (id === "login-screen") try { DQ.pending = null; } catch (e) { } return oS.apply(this, arguments); };

  loadCfg(); watchCard();
  var n = 0, iv = setInterval(function () {
    var ok1 = hookDT(), ok2 = hookCab(), ok3 = hookYQ2();
    if ((ok1 && ok2 && ok3) || ++n > 300) clearInterval(iv);
  }, 100);
}
function hookDT() {
  if (!window.DT || typeof DT.paint !== "function") return false;
  if (DT.__tm) return true; DT.__tm = 1;
  var o = DT.paint; DT.paint = function () { var r = o.apply(this, arguments); Promise.resolve().then(decorate).catch(function (e) { console.warn("[tm]", e); }); return r; };
  return true;
}
function hookCab() {
  if (typeof DQ === "undefined" || !DQ.openCabinet) return false;
  if (DQ.__tm) return true; DQ.__tm = 1;
  var o = DQ.openCabinet; DQ.openCabinet = function () { var r = o.apply(this, arguments); setTimeout(function () { cabBadge().catch(function () { }); }, 50); return r; };
  return true;
}
function hookYQ2() {
  if (typeof YQ2 === "undefined" || !YQ2.go) return false;
  if (YQ2.__tm) return true; YQ2.__tm = 1;
  var o = YQ2.go; YQ2.go = async function (t) { var r = await o.apply(this, arguments); if (t === "tests") { try { await cabTests(); } catch (e) { console.warn("[tm]", e); } } return r; };
  return true;
}
function boot() {
  try { if (typeof V2 === "undefined" || typeof V3 === "undefined" || typeof DQ === "undefined" || typeof showScreen !== "function" || typeof _supabase === "undefined" || !V2.list || !V2.put) return false; } catch (e) { return false; }
  if (window.TM) return true; install(); return true;
}
if (!boot()) { var tries = 0, t0 = setInterval(function () { (boot() || ++tries > 400) && clearInterval(t0); }, 80); }
})();
;

