/* ===== dq-gemini-fix ===== */
(function(){
  var of=window.fetch,map={};try{map=JSON.parse(localStorage.getItem("dq_gmap")||"{}")}catch(e){}
  window.fetch=async function(u,o){
    if(typeof u!=="string"||u.indexOf("generativelanguage.googleapis.com")<0)return of.apply(this,arguments);
    var m=u.match(/models\/([^:?\/]+)/),cur=m&&m[1];
    if(cur&&map[cur]){u=u.replace("models/"+cur,"models/"+map[cur]);cur=map[cur]}
    var r=await of.call(this,u,o);if(r.ok||!cur)return r;
    var t="";try{t=await r.clone().text()}catch(e){}
    var s=t.match(/use models\/([\w.\-]+)/);
    if(s&&s[1]!==cur){var old=m[1];map[old]=s[1];try{localStorage.setItem("dq_gmap",JSON.stringify(map))}catch(e){}
      return of.call(this,u.replace("models/"+cur,"models/"+s[1]),o)}
    return r};
})();
;

