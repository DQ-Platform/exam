`);function gsScript(d){var json=JSON.stringify(d).replace(/\u2028/g,"\\u2028").replace(/\u2029/g,"\\u2029");return["// DQ Platform → Google Forms (avtomatik yaradılıb)","// İstifadə: script.google.com → Yeni layihə → bu kodu yapışdırın → «createQuiz» ▶ Run (icazə verin) → İcra jurnalında linklər çıxacaq.","var DATA = "+json+";","","function createQuiz() {","  var form = FormApp.create(DATA.title);","  form.setIsQuiz(true);","  DATA.qs.forEach(function (q, i) {","    (q.imgs || []).forEach(function (u, k) {","      var m = /^data:(.+?);base64,(.+)$/.exec(u);",'      if (m) form.addImageItem().setImage(Utilities.newBlob(Utilities.base64Decode(m[2]), m[1], "q" + (i + 1) + "_" + (k + 1) + ".jpg")).setTitle("Sual " + (i + 1));',"    });","    var item = form.addMultipleChoiceItem();",'    item.setTitle((i + 1) + ". " + q.q).setPoints(1).setRequired(true);',"    item.setChoices(q.o.map(function (o, k) { return item.createChoice(o, k === q.c); }));","  });",'  Logger.log("Redaktə linki: " + form.getEditUrl());','  Logger.log("Doldurma linki: " + form.getPublishedUrl());',"}"].join(`
