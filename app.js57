 function net(on){clearTimeout(ot);off.textContent=on?"Bağlantı bərpa olundu":"İnternet bağlantısı yoxdur";off.className=(on?"on ok":"on");if(on)ot=setTimeout(function(){off.className=""},2500)}
 W.addEventListener("offline",function(){net(false)});W.addEventListener("online",function(){net(true)});
