/* DQ Platform — app.js : bütün əsas skriptlər (index.html-dən ayrılıb). Sıra dəyişdirilməyib. */
(function(){try{var d=document.createElement("script");d.type="application/json";d.id="hz-def";d.textContent="{\"v\":1,\"on\":true,\"nav\":[{\"id\":\"home\",\"i\":\"🏠\",\"l\":\"Ana Səhifə\",\"h\":0},{\"id\":\"konstitusiya\",\"i\":\"📜\",\"l\":\"Konstitusiya\",\"h\":0},{\"id\":\"qullug\",\"i\":\"🏛\",\"l\":\"Dövlət Qulluğu\",\"h\":0},{\"id\":\"diger\",\"i\":\"📚\",\"l\":\"Digər Qanunlar\",\"h\":0},{\"id\":\"saylar\",\"i\":\"🔢\",\"l\":\"Rəqəmlər & Müddətlər\",\"h\":0},{\"id\":\"flashcards\",\"i\":\"🃏\",\"l\":\"Flaşkartlar\",\"h\":0},{\"id\":\"quiz\",\"i\":\"✏️\",\"l\":\"Test\",\"h\":0}],\"secs\":{\"konstitusiya\":{\"h\":\"Konstitusiya\",\"p\":\"Azərbaycan Respublikasının Konstitusiyası — 1995-ci il, referendumla qəbul edilib.\",\"tabs\":[{\"id\":\"k1\",\"l\":\"Hakimiyyət & Dövlət\",\"h\":0,\"html\":\"<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Maddə 7 — Azərbaycan dövləti<\\/div>\\n<p>Demokratik, hüquqi, dünyəvi, <strong style=\\\"color:#60a5fa\\\">unitar<\\/strong> respublikadır. Hakimiyyət bölünməsi prinsipi: <br/>• <strong style=\\\"color:#60a5fa\\\">Qanunvericilik<\\/strong> → Milli Məclis  |  <strong style=\\\"color:#60a5fa\\\">İcra<\\/strong> → Prezident  |  <strong style=\\\"color:#60a5fa\\\">Məhkəmə<\\/strong> → Məhkəmələr<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Maddə 8 — Prezidentin rolu<\\/div>\\n<p>• Xalqın <strong style=\\\"color:#34d399\\\">vahidliyini<\\/strong> təcəssüm etdirir<br/>• Dövlətçiliyin <strong style=\\\"color:#34d399\\\">varisliyini<\\/strong> təmin edir<br/>• Müstəqillik, ərazi bütövlüyü, beynəlxalq müqavilələrə riayətin <strong style=\\\"color:#34d399\\\">təminatçısı<\\/strong><br/>• Məhkəmə hakimiyyəti müstəqilliyinin <strong style=\\\"color:#34d399\\\">təminatçısı<\\/strong><\\/p>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">Referendum haqqında — Maddə 3<\\/div>\\n<p><strong style=\\\"color:#fbbf24\\\">Yalnız referendumla:<\\/strong> Konstitusiyanın qəbulu/dəyişdirilməsi + Dövlət sərhədlərinin dəyişdirilməsi<\\/p>\\n<p style=\\\"margin-top:8px\\\"><strong style=\\\"color:#f87171\\\">Referenduma ÇIXARILMAZ:<\\/strong> Vergilər, büdcə, amnistiya/əfvetmə, vəzifəli şəxslərin seçilməsi/təyini/təsdiqi<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Maddə 19 — Pul vahidi<\\/div>\\n<p>Manat. Pul nişanlarının tədavülü hüququ <strong style=\\\"color:#60a5fa\\\">yalnız Mərkəzi Banka<\\/strong> məxsusdur. Mərkəzi Bank dövlətin müstəsna mülkiyyətindədir.<\\/p>\\n<\\/div>\"},{\"id\":\"k2\",\"l\":\"Hüquqlar & Azadlıqlar\",\"h\":0,\"html\":\"<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Hər kəsin hüquqları (seçim)<\\/div>\\n<table>\\n<tr><th>Hüquq<\\/th><th>Maddə<\\/th><th>Qeyd<\\/th><\\/tr>\\n<tr><td>Yaşamaq<\\/td><td>27<\\/td><td>Toxunulmazlıq — hər bir şəxs<\\/td><\\/tr>\\n<tr><td>Azadlıq<\\/td><td>28<\\/td><td>Hər kəs<\\/td><\\/tr>\\n<tr><td>Mülkiyyət<\\/td><td>29<\\/td><td>Məhkəməsiz məhrum edilməz<\\/td><\\/tr>\\n<tr><td>Sağlam mühit<\\/td><td>39<\\/td><td>Hər kəs<\\/td><\\/tr>\\n<tr><td>Vicdan azadlığı<\\/td><td>48<\\/td><td>Hər kəs, din etiqad qüsur bəraəti vermir<\\/td><\\/tr>\\n<tr><td>Məlumat azadlığı<\\/td><td>50<\\/td><td>Senzura qadağan<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Yalnız AR vətəndaşlarının hüquqları<\\/div>\\n<table>\\n<tr><th>Hüquq<\\/th><th>Maddə<\\/th><\\/tr>\\n<tr><td>Dövlətin idarəsində iştirak<\\/td><td>55<\\/td><\\/tr>\\n<tr><td>Dövlət qulluğu<\\/td><td>55-II<\\/td><\\/tr>\\n<tr><td>Seçki hüququ<\\/td><td>56<\\/td><\\/tr>\\n<tr><td>Müraciət etmək<\\/td><td>57<\\/td><\\/tr>\\n<tr><td>Cəmiyyətin siyasi həyatında iştirak<\\/td><td>54<\\/td><\\/tr>\\n<tr><td>Təhsil<\\/td><td>42<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">Toxunulmazlıq müqayisəsi ⚠️<\\/div>\\n<table>\\n<tr><th>Şəxs<\\/th><th>Status<\\/th><\\/tr>\\n<tr><td>Hər kəs (32)<\\/td><td>Şəxsi toxunulmazlıq <em>hüququ vardır<\\/em><\\/td><\\/tr>\\n<tr><td>Prezident (106)<\\/td><td>Toxunulmazlıq <em>hüququna malikdir<\\/em><\\/td><\\/tr>\\n<tr><td>Hakimlər (128)<\\/td><td>Toxunulmazdırlar<\\/td><\\/tr>\\n<tr><td>MM deputatı, Vitse-prezident, Baş nazir<\\/td><td>Səlahiyyət müddəti ərzində <em>şəxsiyyəti toxunulmazdır<\\/em><\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card red\\\">\\n<div class=\\\"hz-badge red\\\">Vacib fərqlər<\\/div>\\n<p>• <strong style=\\\"color:#f87171\\\">Uşaq qayğısı:<\\/strong> Valideynlərin <em>borcu<\\/em> (17-II), həm hüququ həm borcu (34-IV)<br/>\\n      • <strong style=\\\"color:#f87171\\\">15 yaş:<\\/strong> işə götürülə bilməz | <strong style=\\\"color:#f87171\\\">18 yaş:<\\/strong> əmək qabiliyyətli uşaqlar valideynlərini saxlamalı<br/>\\n      • <strong style=\\\"color:#f87171\\\">Nikah:<\\/strong> könüllü razılıq | <strong style=\\\"color:#f87171\\\">Əmək müqaviləsi:<\\/strong> sərbəst bağlanır<br/>\\n      • <strong style=\\\"color:#f87171\\\">Mülki məsuliyyət<\\/strong> daşıyır (maddi yox!): dövlət + bələdiyyə<\\/p>\\n<\\/div>\"},{\"id\":\"k3\",\"l\":\"Prezident\",\"h\":0,\"html\":\"<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Prezidentliyə namizəd şərtləri (Maddə 100)<\\/div>\\n<p>AR-da <strong style=\\\"color:#60a5fa\\\">10 ildən artıq<\\/strong> daimi yaşayan • AR vətəndaşı • Seçkilərdə iştirak hüququ • Ağır cinayətə görə məhkum olunmayan • Başqa dövlətlər qarşısında öhdəliyi olmayan • <strong style=\\\"color:#60a5fa\\\">Ali təhsilli<\\/strong> • İkili vətəndaşlığı olmayan<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Prezident seçilir (Maddə 101)<\\/div>\\n<p>• <strong style=\\\"color:#34d399\\\">7 il<\\/strong> müddətinə, ümumi, bərabər, birbaşa seçki yolu ilə<br/>\\n      • İştirak edənlərin yarıdan çoxunun səsi ilə seçilir<br/>\\n      • Əgər 1-ci turda yox — <strong style=\\\"color:#34d399\\\">2-ci bazar günü<\\/strong> ikinci tur<br/>\\n      • Növbədənkənar seçkini <strong style=\\\"color:#34d399\\\">Prezident<\\/strong> elan edə bilər<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">Prezidentin aktları (Maddə 113)<\\/div>\\n<p>• Ümumi qaydalar üçün → <strong style=\\\"color:#fbbf24\\\">FƏRMAN<\\/strong><br/>\\n      • Digər məsələlər üçün → <strong style=\\\"color:#fbbf24\\\">SƏRƏNCAM<\\/strong><\\/p>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Prezident vəzifədən gedərsə (Maddə 104-105)<\\/div>\\n<p><strong style=\\\"color:#60a5fa\\\">60 gün<\\/strong> ərzində növbədənkənar seçki. Bu müddətdə:<br/>\\n      1️⃣ Birinci vitse-prezident → 2️⃣ Vitse-prezident → 3️⃣ Baş nazir → 4️⃣ MM sədri<\\/p>\\n<\\/div>\"},{\"id\":\"k4\",\"l\":\"Milli Məclis\",\"h\":0,\"html\":\"<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Milli Məclis — Əsas<\\/div>\\n<p>• <strong style=\\\"color:#60a5fa\\\">125 deputat<\\/strong> • Hər çağırışın müddəti <strong style=\\\"color:#60a5fa\\\">5 il<\\/strong><br/>\\n      • Seçkilər: <strong style=\\\"color:#60a5fa\\\">noyabr ayının birinci bazar günü<\\/strong><br/>\\n      • Səlahiyyətlidir: <strong style=\\\"color:#60a5fa\\\">83 deputatın<\\/strong> səlahiyyəti təsdiq olunanda<br/>\\n      • İlk iclası: təsdiqedən sonra <strong style=\\\"color:#60a5fa\\\">1 həftədən gec olmayaraq<\\/strong><\\/p>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Qanunvericilik təşəbbüsü hüququ (Maddə 96)<\\/div>\\n<p>Yaddaş sözu: <strong style=\\\"color:#34d399\\\">PAPAM + 40 min<\\/strong><br/>\\n      Prezident · Ali Məhkəmə · Prokurorluq · (deputatlar) · Ali Məclis (NMR) · MM deputatları · 40.000 seçki hüququ olan vətəndaş<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">Mühüm səs sayları<\\/div>\\n<table>\\n<tr><th>Məsələ<\\/th><th>Səs<\\/th><th>Növ<\\/th><\\/tr>\\n<tr><td>Prezident seçkiləri, MM seçkiləri, Referendum qanunları<\\/td><td>83<\\/td><td>Qanun<\\/td><\\/tr>\\n<tr><td>Ombudsmanın seçilməsi<\\/td><td>83<\\/td><td>Qərar<\\/td><\\/tr>\\n<tr><td>Hərbi fərmanların təsdiqi<\\/td><td>63<\\/td><td>Qərar<\\/td><\\/tr>\\n<tr><td>KM, Ali M, Apel. hakimləri — kənarlaşdırma<\\/td><td>83<\\/td><td>Qərar<\\/td><\\/tr>\\n<tr><td>Digər hakimlər — kənarlaşdırma<\\/td><td>63<\\/td><td>Qərar<\\/td><\\/tr>\\n<tr><td>Prezidentin impiçmenti<\\/td><td>95<\\/td><td>Qərar<\\/td><\\/tr>\\n<tr><td>Konstitusiyaya əlavələr<\\/td><td>95<\\/td><td>Konst. Qanunu<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card red\\\">\\n<div class=\\\"hz-badge red\\\">Deputatlığa namizəd şərtləri (Maddə 85)<\\/div>\\n<p>Olmaz: ikili vətəndaşlıq • başqa dövlət öhdəliyi • icra/məhkəmə hakimiyyətdə qulluq (elmi-pedaqoji-yaradıcılıq istisna) • din xadimi • fəaliyyətsizliyi • ağır cinayət məhkumu • azadlıqdan məhrum yerdə cəzaçəkən<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Qanunun MM-dən Prezidentə gedən yolu ⚠️ (Maddə 110-111)<\\/div>\\n<table>\\n<tr><th>Mərhələ<\\/th><th>Müddət<\\/th><th>Qeyd<\\/th><\\/tr>\\n<tr><td>MM qanunu qəbul edir → Prezidentə göndərir<\\/td><td><strong style=\\\"color:#34d399\\\">14 gün<\\/strong><\\/td><td>MM sədri imzalayır, Prezidentə verir<\\/td><\\/tr>\\n<tr><td>Prezident qanunu imzalayır<\\/td><td><strong style=\\\"color:#34d399\\\">56 gün<\\/strong> ərzində<\\/td><td>İmzalanmazsa — qüvvəyə minmiş sayılır<\\/td><\\/tr>\\n<tr><td>Prezident qanunu geri qaytarır (veto)<\\/td><td>56 gün ərzində<\\/td><td>Etirazları ilə MM-ə qaytarır<\\/td><\\/tr>\\n<tr><td>MM vetodan sonra yenidən baxır<\\/td><td><strong style=\\\"color:#34d399\\\">30 gün<\\/strong><\\/td><td>63 səs → veto aşılır, Prez. imzasız qüvvəyə minir<\\/td><\\/tr>\\n<\\/table>\\n<p style=\\\"margin-top:8px;font-size:12px;color:#94a3b8\\\">⚠️ <strong style=\\\"color:#fbbf24\\\">14 gün<\\/strong> = MM-in göndərmə müddəti  |  <strong style=\\\"color:#fbbf24\\\">56 gün<\\/strong> = Prezidentin imzalama müddəti. Konstitusiya qanunlarına Prezident veto qoya bilməz.<\\/p>\\n<\\/div>\"},{\"id\":\"k5\",\"l\":\"Məhkəmə\",\"h\":0,\"html\":\"<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Məhkəmə sistemi (Maddə 125)<\\/div>\\n<table>\\n<tr><th>Məhkəmə<\\/th><th>Hakim təyin edir<\\/th><\\/tr>\\n<tr><td>Konstitusiya Məhkəməsi (9 hakim)<\\/td><td>Prezidentin təqdimatı ilə MM — 63 qərar<\\/td><\\/tr>\\n<tr><td>Ali Məhkəmə<\\/td><td>Prezidentin təqdimatı ilə MM — 63 qərar<\\/td><\\/tr>\\n<tr><td>Apellyasiya (5 məhkəmə)<\\/td><td>Prezidentin təqdimatı ilə MM — 63 qərar<\\/td><\\/tr>\\n<tr><td>Digər bütün məhkəmələr<\\/td><td>Prezident (birbaşa)<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Hakimlərin kənarlaşdırılması<\\/div>\\n<p>• KM + Ali M + Apellyasiya → MM-də <strong style=\\\"color:#34d399\\\">83 səs<\\/strong> çoxluğu ilə<br/>\\n      • Digər hakimlər → MM-də <strong style=\\\"color:#34d399\\\">63 səs<\\/strong> çoxluğu ilə<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">Konstitusiya Məhkəməsinə sorğu verənlər<\\/div>\\n<p><strong style=\\\"color:#fbbf24\\\">PAPAM + NK<\\/strong> (Prezident, Ali Məhkəmə, Prokurorluq, Ali Məclis (MM), Nazirlər Kabineti + Naxçıvan Ali Məclisi) — Şərh üçün<br/>\\n<strong style=\\\"color:#fbbf24\\\">Ombudsman<\\/strong> + <strong style=\\\"color:#fbbf24\\\">Hər kəs<\\/strong> (hüquqları pozulanda) — müraciət edə bilər<\\/p>\\n<\\/div>\"},{\"id\":\"k6\",\"l\":\"Əlavə vs Dəyişiklik\",\"h\":0,\"html\":\"<div class=\\\"hz-card red\\\">\\n<div class=\\\"hz-badge red\\\">⚠️ Referenduma ÇIXARILMAZ maddələr<\\/div>\\n<p>Maddələr: <strong style=\\\"color:#f87171\\\">1, 2, 6, 7, 8, 21<\\/strong> — Bunlarda dəyişiklik və ya ləğv üçün referendum olmaz<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">⚠️ Əlavələr TƏKLİF EDİLƏ BİLMƏZ<\\/div>\\n<p>Konstitusiyanın <strong style=\\\"color:#fbbf24\\\">1-ci Bölməsi<\\/strong> (Maddə 1-23) — Bu maddələrə əlavə təklif olunmaz<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">Konstitusiyaya ƏLAVƏ (Maddə 156)<\\/div>\\n<table>\\n<tr><th><\\/th><th>Əlavə<\\/th><th>Dəyişiklik<\\/th><\\/tr>\\n<tr><td>Necə?<\\/td><td>Konstitusiya Qanunu ilə<\\/td><td>Referendumla<\\/td><\\/tr>\\n<tr><td>Kimlər təklif edir?<\\/td><td>Prezident VƏ ya ≥63 deputat<\\/td><td>MM VƏ ya Prezident<\\/td><\\/tr>\\n<tr><td>Səs<\\/td><td>95 (iki dəfə, 6 ay arayla)<\\/td><td>—<\\/td><\\/tr>\\n<tr><td>Xüsusiyyət<\\/td><td>1-ci bölməyə təklif olmaz<\\/td><td>1,2,6,7,8,21-ə olmaz<\\/td><\\/tr>\\n<tr><td>Prezident imzasızsa<\\/td><td>Qüvvəyə minmir<\\/td><td>—<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Konstitusiya Qanunu ilə müəyyən edilir (TAM 7 bənd)<\\/div>\\n<p>✅ 1. Dövlət bayrağının təsviri (M.23-III)<br/>\\n      ✅ 2. Dövlət gerbinin təsviri (M.23-III)<br/>\\n      ✅ 3. Dövlət himninin musiqisi və mətni (M.23-III)<br/>\\n      ✅ 4. Əvvəllər Prezident seçilmiş şəxsin təminatı qaydaları (M.108-II)<br/>\\n      ✅ 5. NMR Konstitusiyasının təsdiqi (M.134-VI)<br/>\\n      ✅ 6. Normativ hüquqi aktların dərc edilməsi qaydası (M.149-VIII)<br/>\\n      ✅ 7. MM-in ümumi qaydaları və həll etdiyi məsələlərə əlavələr (M.94-III &amp; 95-IV)<br/>\\n      ✅ 8. Konstitusiyaya bütün əlavələr (M.156)<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">AR Konstitusiyasının 3 əsas xüsusiyyəti<\\/div>\\n<p>⚡ <strong style=\\\"color:#60a5fa\\\">Ən yüksək hüquqi qüvvəyə<\\/strong> malikdir (AR-da)<br/>\\n      ⚡ <strong style=\\\"color:#60a5fa\\\">Birbaşa hüquqi qüvvəyə<\\/strong> malikdir<br/>\\n      ⚡ AR-nın <strong style=\\\"color:#60a5fa\\\">Qanunvericilik sisteminin əsasıdır<\\/strong><\\/p>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">\\\"Konstitusiya ilə\\\" müəyyən edilən 3 hal<\\/div>\\n<p>✅ <strong style=\\\"color:#34d399\\\">NMR statusu<\\/strong> — bu Konstitusiya ilə müəyyən edilir (M.134-II)<br/>\\n      ✅ <strong style=\\\"color:#34d399\\\">Bələdiyyələrin statusunun əsasları<\\/strong> — bu Konstitusiya ilə müəyyən edilir; bələdiyyələrə seçkilərin <em>qaydaları<\\/em> isə qanunla (M.142-III)<br/>\\n      ✅ <strong style=\\\"color:#34d399\\\">MM-də qanunların qəbul qaydası<\\/strong> — bu Konstitusiya ilə nəzərdə tutulmuş qaydada (M.93-II)<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">KM qərarının məcburi qüvvəsi<\\/div>\\n<p>Azərbaycan Respublikası <strong style=\\\"color:#fbbf24\\\">Konstitusiya Məhkəməsinin qərarı<\\/strong><br/>\\n      → AR <strong style=\\\"color:#fbbf24\\\">ərazisində məcburi qüvvəyə<\\/strong> malikdir<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card red\\\">\\n<div class=\\\"hz-badge red\\\">⚠️ Seçilmək hüququ məhdudlaşdırıla bilən şəxslər (M.56-II)<\\/div>\\n<p style=\\\"line-height:2\\\">🔴 <strong>Hərbi qulluqçular<\\/strong><br/>\\n      🔴 <strong>Hakimlər<\\/strong><br/>\\n      🔴 <strong>Dövlət məmurları<\\/strong><br/>\\n      🔴 <strong>Din xadimləri<\\/strong><br/>\\n      🔴 Məhkəmənin qanuni qüvvəyə minmiş hökmü ilə <strong>azadlıqdan məhrum edilmiş şəxslər<\\/strong><br/>\\n      🔴 Bu Konstitusiyada və qanunda nəzərdə tutulan <strong>digər şəxslər<\\/strong><\\/p>\\n<\\/div>\\n<div class=\\\"hz-card red\\\">\\n<div class=\\\"hz-badge red\\\">⚠️ Seçkilərdə və referendumda iştirak hüququ OLMAYAN (M.56-I)<\\/div>\\n<p>Məhkəmənin qərarı ilə <strong style=\\\"color:#f87171\\\">fəaliyyət qabiliyyətsizliyi<\\/strong> təsdiq olunmuş şəxslər<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">Dövlət / Bələdiyyə — MÜLKİ Məsuliyyət<\\/div>\\n<p>🏛️ <strong style=\\\"color:#34d399\\\">Dövlət<\\/strong>, dövlət qulluqçuları ilə birlikdə onların qanuna zidd hərəkət/hərəkətsizliyi nəticəsində hüquqlara dəymiş ziyana görə <strong style=\\\"color:#34d399\\\">MÜLKİ məsuliyyət<\\/strong> daşıyır <em>(maddi yox!)<\\/em><br/><br/>\\n      🏘️ <strong style=\\\"color:#34d399\\\">Bələdiyyələr<\\/strong>, bələdiyyə qulluqçuları ilə birlikdə eyni əsasla <strong style=\\\"color:#34d399\\\">MÜLKİ məsuliyyət<\\/strong> daşıyırlar <em>(maddi yox!)<\\/em><\\/p>\\n<\\/div>\"},{\"id\":\"k7\",\"l\":\"Oxşar Maddələr ⚠️\",\"h\":0,\"html\":\"<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">⚠️ İmtahanda ən çox çıxan — Oxşar maddə cütləri<\\/div>\\n<p style=\\\"font-size:12px;color:#94a3b8\\\">Bu maddələri bir-birindən fərqləndirə bilmək çox vacibdir!<\\/p>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">1) Maddə 5 vs Maddə 8<\\/div>\\n<table>\\n<tr><th>Maddə 5 — Xalqın vahidliyi<\\/th><th>Maddə 8 — Dövlətin başçısı<\\/th><\\/tr>\\n<tr><td>Azərbaycan <strong style=\\\"color:#60a5fa\\\">xalqı<\\/strong> vahiddir<\\/td><td>Prezident xalqın <strong style=\\\"color:#60a5fa\\\">vahidliyini təcəssüm etdirir<\\/strong><\\/td><\\/tr>\\n<tr><td>Xalqın vahidliyi dövlətin <strong style=\\\"color:#60a5fa\\\">təməlini<\\/strong> təşkil edir<\\/td><td>Prezident dövlətçiliyin <strong style=\\\"color:#60a5fa\\\">varisliyini<\\/strong> təmin edir<\\/td><\\/tr>\\n<tr><td>AR bütün vətəndaşların <strong style=\\\"color:#60a5fa\\\">ümumi və bölünməz vətənidir<\\/strong><\\/td><td>Prezident dövleti daxili və xarici münasibətlərdə <strong style=\\\"color:#60a5fa\\\">təmsil edir<\\/strong><\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">2) Maddə 13 vs Maddə 29 — Mülkiyyət<\\/div>\\n<table>\\n<tr><th>Maddə 13 — Mülkiyyət (dövlət prinsipi)<\\/th><th>Maddə 29 — Mülkiyyət hüququ (şəxs hüququ)<\\/th><\\/tr>\\n<tr><td>Mülkiyyət <strong style=\\\"color:#34d399\\\">toxunulmazdır<\\/strong> və dövlət tərəfindən müdafiə olunur<\\/td><td>Hər kəsin <strong style=\\\"color:#34d399\\\">mülkiyyət hüququ<\\/strong> vardır<\\/td><\\/tr>\\n<tr><td>Növləri: dövlət / xüsusi / bələdiyyə<\\/td><td>Heç bir növünə üstünlük verilmir<\\/td><\\/tr>\\n<tr><td>İnsan hüquqları, cəmiyyət, ləyaqət əleyhinə istifadə edilə bilməz<\\/td><td><strong style=\\\"color:#34d399\\\">Məhkəməsiz<\\/strong> məhrum edilməz. Tam müsadirəyə yol verilmir<\\/td><\\/tr>\\n<tr><td>—<\\/td><td>Xüsusi mülkiyyət <strong style=\\\"color:#34d399\\\">sosial öhdəliklərə<\\/strong> səbəb olur<\\/td><\\/tr>\\n<tr><td>—<\\/td><td>Dövlət <strong style=\\\"color:#34d399\\\">vərəsəlik hüququna<\\/strong> təminat verir<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">3) Maddə 15 vs Maddə 16 — İqtisadi vs Sosial inkişaf<\\/div>\\n<table>\\n<tr><th>Maddə 15 — İqtisadi inkişaf<\\/th><th>Maddə 16 — Sosial inkişaf<\\/th><\\/tr>\\n<tr><td>Bazar münasibətləri əsasında <strong style=\\\"color:#60a5fa\\\">sosial yönümlü<\\/strong> iqtisadiyyat<\\/td><td>Xalqın və hər vətəndaşın <strong style=\\\"color:#60a5fa\\\">rifahının yüksəldilməsi<\\/strong><\\/td><\\/tr>\\n<tr><td>Azad sahibkarlığa <strong style=\\\"color:#60a5fa\\\">təminat<\\/strong> verir<\\/td><td>Sosial müdafiə, layiqli həyat səviyyəsi<\\/td><\\/tr>\\n<tr><td>İnhisarçılıq və haqsız rəqabətə <strong style=\\\"color:#60a5fa\\\">yol vermir<\\/strong><\\/td><td>Mədəniyyət, təhsil, səhiyyə, elm, incəsənətin inkişafına <strong style=\\\"color:#60a5fa\\\">yardım<\\/strong><\\/td><\\/tr>\\n<tr><td>—<\\/td><td>Ölkənin təbiəti, xalqın tarixi, maddi və mənəvi irsi <strong style=\\\"color:#60a5fa\\\">qorunur<\\/strong><\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">4) Maddə 17 vs Maddə 34 — Ailə/Uşaqlar<\\/div>\\n<table>\\n<tr><th>Maddə 17 — Ailə, uşaqlar, dövlət<\\/th><th>Maddə 34 — Nikah hüququ<\\/th><\\/tr>\\n<tr><td>Ailə — cəmiyyətin <strong style=\\\"color:#34d399\\\">əsas özəyi<\\/strong>, dövlətin xüsusi himayəsindədir<\\/td><td>Qanunla nəzərdə tutulan <strong style=\\\"color:#34d399\\\">yaşa çatdıqda<\\/strong> ailə qurmaq hüququ<\\/td><\\/tr>\\n<tr><td>Uşaq qayğısı — <strong style=\\\"color:#34d399\\\">valideynlərin borcu<\\/strong> (17-II)<\\/td><td>Uşaq qayğısı — <strong style=\\\"color:#34d399\\\">həm hüquq, həm borc<\\/strong> (34-IV)<\\/td><\\/tr>\\n<tr><td><strong style=\\\"color:#34d399\\\">15 yaşına<\\/strong> çatmamış uşaqlar işə götürülə bilməz<\\/td><td>Nikah <strong style=\\\"color:#34d399\\\">könüllü razılıq<\\/strong> əsasında bağlanır<\\/td><\\/tr>\\n<tr><td>Valideyn qayğısından məhrum uşaqlar <strong style=\\\"color:#34d399\\\">dövlətin himayəsindədir<\\/strong><\\/td><td>Analıq, atalıq, uşaqlıq qanunla mühafizə edilir<\\/td><\\/tr>\\n<tr><td>—<\\/td><td><strong style=\\\"color:#34d399\\\">18 yaşına<\\/strong> çatmış əmək qabiliyyətli uşaqlar qabiliyyətsiz valideynlərini saxlamalı<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">5) Maddə 18 vs Maddə 42 — Din/Dövlət vs Təhsil<\\/div>\\n<table>\\n<tr><th>Maddə 18 — Din və dövlət<\\/th><th>Maddə 42 — Təhsil hüququ<\\/th><\\/tr>\\n<tr><td>Din dövlətdən <strong style=\\\"color:#60a5fa\\\">ayrıdır<\\/strong><\\/td><td>Hər <strong style=\\\"color:#60a5fa\\\">vətəndaşın<\\/strong> təhsil almaq hüququ (hər kəs yox!)<\\/td><\\/tr>\\n<tr><td>Bütün dini etiqadlar qanun qarşısında <strong style=\\\"color:#60a5fa\\\">bərabərdir<\\/strong><\\/td><td>Pulsuz icbari <strong style=\\\"color:#60a5fa\\\">ümumi orta<\\/strong> təhsil<\\/td><\\/tr>\\n<tr><td>İnsan ləyaqətini alçaldan din yayılması <strong style=\\\"color:#60a5fa\\\">qadağandır<\\/strong><\\/td><td>Dövlət min. təhsil <strong style=\\\"color:#60a5fa\\\">standartlarını<\\/strong> müəyyən edir<\\/td><\\/tr>\\n<tr><td>Dövlət təhsil sistemi <strong style=\\\"color:#60a5fa\\\">dünyəvi<\\/strong> xarakter daşıyır<\\/td><td>Maddi vəziyyətdən asılı olmayaraq istedadlı şəxslər dövlət <strong style=\\\"color:#60a5fa\\\">zəmanəti<\\/strong> ilə<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card green\\\">\\n<div class=\\\"hz-badge green\\\">6) Maddə 18 vs Maddə 48 — Din/Dövlət vs Vicdan azadlığı<\\/div>\\n<table>\\n<tr><th>Maddə 18 — Din və dövlət (institutlar)<\\/th><th>Maddə 48 — Vicdan azadlığı (şəxs)<\\/th><\\/tr>\\n<tr><td>Din dövlətdən ayrıdır<\\/td><td>Hər kəsin <strong style=\\\"color:#34d399\\\">vicdan azadlığı<\\/strong> vardır<\\/td><\\/tr>\\n<tr><td>Bütün dini etiqadlar bərabərdir<\\/td><td>Dinə münasibəti <strong style=\\\"color:#34d399\\\">müstəqil<\\/strong> müəyyənləşdirmək hüququ<\\/td><\\/tr>\\n<tr><td>Ləyaqəti alçaldan din yayılması qadağan<\\/td><td>Dini etiqad hüquq pozuntusuna <strong style=\\\"color:#34d399\\\">bəraət qazandırmır<\\/strong><\\/td><\\/tr>\\n<tr><td>Dövlət təhsili dünyəvidir<\\/td><td>Heç kəs dini mərasimlərdə iştirak etməyə <strong style=\\\"color:#34d399\\\">məcbur<\\/strong> edilə bilməz<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card yellow\\\">\\n<div class=\\\"hz-badge yellow\\\">7) Maddə 21 vs Maddə 45 — Dövlət dili vs Ana dili<\\/div>\\n<table>\\n<tr><th>Maddə 21 — Dövlət dili<\\/th><th>Maddə 45 — Ana dilindən istifadə<\\/th><\\/tr>\\n<tr><td>AR-ın dövlət dili <strong style=\\\"color:#fbbf24\\\">Azərbaycan dilidir<\\/strong><\\/td><td>Hər kəsin <strong style=\\\"color:#fbbf24\\\">ana dilindən<\\/strong> istifadə hüququ<\\/td><\\/tr>\\n<tr><td>Azərbaycan dilinin <strong style=\\\"color:#fbbf24\\\">inkişafını<\\/strong> təmin edir<\\/td><td>İstədiyi dildə <strong style=\\\"color:#fbbf24\\\">tərbiyə, təhsil, yaradıcılıq<\\/strong> hüququ<\\/td><\\/tr>\\n<tr><td>Əhalinin danışdığı <strong style=\\\"color:#fbbf24\\\">başqa dillərin<\\/strong> inkişafı da təmin edilir<\\/td><td>Heç kəs ana dilindən istifadə <strong style=\\\"color:#fbbf24\\\">hüququndan məhrum<\\/strong> edilə bilməz<\\/td><\\/tr>\\n<\\/table>\\n<\\/div>\\n<div class=\\\"hz-card blue\\\">\\n<div class=\\\"hz-badge blue\\\">8) Maddə