const SX=(()=>{const $=id=>document.getElementById(id),S={sync:[],crop:[]},esc=s=>String(s??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/"/g,"&quot;"),MK=/(?:^|\s)\(?(?:([A-E])(?:[.)\]:]|$)|([a-e])[.)])/g;function mount(){[["sync","🧠","Ağıllı PDF Sinxron (Sual + Variant)","#4f46e5",'Mətn qatlı PDF birbaşa oxunur (OCR yalnız skan səhifələrdə işləyir). Suallar, A–E variantları və "Cavab: X" sətri avtomatik ayrılır.'],["crop","✂️","Avto-Kəsmə: Fiqurlu Sual + Variantlar","#059669",'PDF/şəkildəki hər sual və hər variant ayrı şəkil kimi avtomatik kəsilib sinxronlaşdırılır. Tanınmayan sual ⚠️ ilə işarələnir — onu "Universal Kəsmə Alətı" ilə əl ilə düzəldin.']].forEach(([m,ic,title,color,desc])=>{const card=document.createElement("div");card.className="admin-nav-card",card.style.cssText=`background:${color};color:#fff`,card.onclick=()=>switchAdminTab("sx"+m),card.innerHTML=`<span class="icon">${ic}</span> ${title}`,document.querySelector(".admin-nav-grid").appendChild(card);const box=document.createElement("div");box.id="mod-sx"+m,box.className="admin-module-block",box.style.display="none",box.innerHTML=`<h4>${ic} ${title}</h4><p class="mt-1 mb-3" style="color:#64748b;font-size:13px">${desc}</p>
        <div class="target-category-selector mb-3">
          <input type="number" id="sx-exam-${m}" class="form-control" placeholder="Sınaq №" value="1" style="width:100px">
          <input type="number" id="sx-start-${m}" class="form-control" placeholder="Başlanğıc Sual №" value="1" style="width:140px">
          <label><input type="checkbox" id="sx-keep-${m}"> PDF nömrələrini saxla</label>
          ${["BA","BB","AC"].map((c,i)=>`<label><input type="checkbox" class="sx-cat-${m}" value="${c}" ${i?"":"checked"}> ${c}</label>`).join("")}
        </div>
