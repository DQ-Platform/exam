                    <div id="c-area" style="display:none" class="mt-3"><div style="display:flex;gap:8px;align-items:center;margin-bottom:8px"><button class="v2-b o s" onclick="V2.cpage(-1)">◀</button><span id="c-pg"></span><button class="v2-b o s" onclick="V2.cpage(1)">▶</button><small style="color:#64748b">Sahəni siçanla/barmaqla seçin. <b>P</b> — sual, <b>O</b> — növbəti variant</small></div><div style="overflow:auto;max-height:520px"><canvas id="c-cv" class="v2-cv"></canvas></div></div></div>
                    <div class="v2-card"><h3>Kəsim Tənzimləmələri</h3><div class="v2-f"><label>Növbəti Kəsiləcək Sualın Variant Sayı</label><label style="margin-right:16px"><input type="radio" name="c-n" ${b.n===4?"checked":""} onchange="V2.b2.n=4;V2.go('bank2')"> 4 Variant (A, B, C, D)</label><label><input type="radio" name="c-n" ${b.n===5?"checked":""} onchange="V2.b2.n=5;V2.go('bank2')"> 5 Variant (A, B, C, D, E)</label></div>
                    <div class="v2-f mt-3"><label>Növbəti Kəsiləcək Sualın Kateqoriyası</label><select class="v2-in" onchange="V2.b2.cat=this.value">${["BB","BA","AC","BDU"].map(c=>`<option ${b.cat===c?"selected":""}>${c}</option>`).join("")}</select></div></div>
                    <div class="v2-card"><h3>Sual Redaktoru (V2)</h3><div class="v2-f"><label style="color:#4f46e5">■ Sual Şəkli</label><div class="v2-var ${b.mode==="q"?"ok":""}" onclick="V2.b2.mode='q'" style="text-align:center;cursor:pointer">${b.q?`<img src="${b.q}"><br><button class="v2-b r s mt-2" onclick="V2.b2.q=null;V2.go('bank2')">✕ Sil</button>`:"<small><b>P</b> (Sual Kəs) rejimini seçib sual ərazisini kəsin.</small>"}</div></div>
                    <h4 style="text-align:left;margin:16px 0 10px;font-size:14px">Variantlar (${filled} doldurulub)</h4>
                    ${L.map((c,i)=>`<div class="v2-var ${b.mode==="v"&&b.vi===i?"ok":""}" onclick="V2.b2.mode='v';V2.b2.vi=${i}"><div style="display:flex;justify-content:space-between"><b>${c} variantı <small style="color:#94a3b8">${b.v[i]||(b.txt[i]||"").trim()?"Dolu":"Boş"}</small></b><a href="#" style="color:#dc2626;font-size:12px" onclick="V2.b2.v[${i}]=null;V2.b2.txt[${i}]='';V2.go('bank2');return false">✕ Sil</a></div>
                        <div class="row"><div class="v2-rad ${b.corr===i?"on":""}" onclick="event.stopPropagation();V2.b2.corr=${i};V2.go('bank2')">${c}</div><div style="min-width:110px;text-align:center;font-size:12px;color:#64748b;background:#fff;border-radius:8px;padding:6px">${b.v[i]?`<img src="${b.v[i]}">`:"Hələ variant yoxdur"}</div><textarea class="v2-in" rows="2" placeholder="Variant ${c} mətnini bura yazın..." oninput="V2.b2.txt[${i}]=this.value">${V2.esc(b.txt[i]||"")}</textarea></div>
                        <small style="color:#64748b">Variantı ham <b>O</b> (kəsmə) rejimində şəkil kimi, ham də burada klaviatura ilə mətn şəklində daxil edə bilərsiniz.</small></div>`).join("")}
                    <div class="v2-f mt-3"><label>İzah (İstəyə bağlı)</label><textarea class="v2-in" rows="3" placeholder="Sualın qanunvericilik izahı və ya qeydlər..." oninput="V2.b2.note=this.value">${V2.esc(b.note)}</textarea></div>
                    <div class="mt-4" style="display:flex;gap:10px"><button class="v2-b" style="flex:1" onclick="V2.addB2()">➕ Sual Bankına Əlavə Et</button><button class="v2-b o" onclick="V2.b2=null;V2.edit=-1;V2.go('bank2')">Təmizlə</button></div></div>`+V2.selList(),after:()=>{(V2.pdf||V2.img)&&V2.cshow()}}},async cropLoad(inp){const f=inp.files[0];f&&(V2.pdf=null,V2.img=null,V2.pg=1,f.type==="application/pdf"?(await window.__dqLibs("pdf"),V2.pdf=await pdfjsLib.getDocument(new Uint8Array(await f.arrayBuffer())).promise):V2.img=await new Promise(r=>{const i=new Image;i.onload=()=>r(i),i.src=URL.createObjectURL(f)}),V2.cshow())},async cshow(){V2.$("c-area").style.display="block";const cv=V2.$("c-cv"),ctx=cv.getContext("2d");if(V2.pdf){const page=await V2.pdf.getPage(V2.pg),vp=page.getViewport({scale:2});cv.width=vp.width,cv.height=vp.height,await page.render({canvasContext:ctx,viewport:vp}).promise,V2.$("c-pg").innerText=`Səhifə ${V2.pg}/${V2.pdf.numPages}`}else cv.width=V2.img.width,cv.height=V2.img.height,ctx.drawImage(V2.img,0,0),V2.$("c-pg").innerText="Şəkil";V2.base=ctx.getImageData(0,0,cv.width,cv.height);let st=null;const pos=e=>{const r=cv.getBoundingClientRect(),t=e.touches?e.touches[0]:e;return[(t.clientX-r.left)*cv.width/r.width,(t.clientY-r.top)*cv.height/r.height]},draw=e=>{if(!st)return;e.preventDefault();const[x,y]=pos(e);ctx.putImageData(V2.base,0,0),ctx.strokeStyle="#4f46e5",ctx.lineWidth=3,ctx.strokeRect(st[0],st[1],x-st[0],y-st[1])},end=e=>{if(!st)return;const[x,y]=e.changedTouches?pos({touches:e.changedTouches}):pos(e),w=Math.abs(x-st[0]),h=Math.abs(y-st[1]),sx=Math.min(x,st[0]),sy=Math.min(y,st[1]);st=null,ctx.putImageData(V2.base,0,0),!(w<10||h<10)&&V2.crop(sx,sy,w,h)};cv.onmousedown=cv.ontouchstart=e=>{e.preventDefault(),st=pos(e)},cv.onmousemove=cv.ontouchmove=draw,cv.onmouseup=cv.ontouchend=end},cpage(d){if(!V2.pdf)return;const n=V2.pg+d;n<1||n>V2.pdf.numPages||(V2.pg=n,V2.cshow())},crop(x,y,w,h){const t=document.createElement("canvas");t.w