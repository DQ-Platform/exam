 function seed(){var s=w*h,k=LOW?.55:1,mob=w<700?.6:1,dn=DENS();lastDens=dn;
  var nd=Math.max(12,Math.min(90,Math.round(s/17000*k*mob*dn)));
  dots=[];for(var i=0;i<nd;i++)dots.push({x:R(0,w),y:R(0,h),vx:R(-.18,.18),vy:R(-.18,.18),r:R(1,2.2),g:Math.random()<.25})}
 function burst(x,y,n){for(var i=0;i<n;i++){var a=R(0,6.28),v=R(1.2,4.8);sp.push({x:x,y:y,vx:Math.cos(a)*v,vy:Math.sin(a)*v-1,l:1,d:R(.012,.026),r:R(1.2,3),g:Math.random()<.8})}}
 function ring(x,y){sp.push({x:x,y:y,vx:0,vy:0,l:1,d:.035,r:4,ring:1})}
 function screenOK(){var a=D.querySelector(".screen.active");return !D.hidden&&!!a&&!!OK[a.id]}
 function tick(t){requestAnimationFrame(tick);var dt=Math.min(40,t-(last||t));last=t;frame++;
  if(frame%15===1){scrOK=screenOK();if(DENS()!==lastDens)seed()}
  var net=scrOK&&ON("net"),act=scrOK&&(net||sp.length>0);
  cv.classList.toggle("on",act);
  if(glow)glow.classList.toggle("on",scrOK&&ON("glow")&&!!P.on);
  if(!act){if(!scrOK&&sp.length)sp.length=0;return}
  if(dt>30){if(++slow>70&&dots.length>16){dots.length=Math.round(dots.length*.6);slow=-9999}}else if(slow>0)slow--;
  var k=dt/16.67,i,j,d,a,dx,dy,dist;cx.clearRect(0,0,w,h);
  if(net){
   for(i=0;i<dots.length;i++){d=dots[i];d.x+=d.vx*k;d.y+=d.vy*k;if(d.x<-10)d.x=w+10;else if(d.x>w+10)d.x=-10;if(d.y<-10)d.y=h+10;else if(d.y>h+10)d.y=-10;
    for(j=i+1;j<dots.length;j++){dx=d.x-dots[j].x;dy=d.y-dots[j].y;dist=dx*dx+dy*dy;if(dist<12100){a=1-Math.sqrt(dist)/110;cx.strokeStyle="rgba("+BLUE+","+(a*.28)+")";cx.lineWidth=.8;cx.beginPath();cx.moveTo(d.x,d.y);cx.lineTo(dots[j].x,dots[j].y);cx.stroke()}}
    if(P.on){dx=d.x-P.x;dy=d.y-P.y;dist=dx*dx+dy*dy;if(dist<22500){a=1-Math.sqrt(dist)/150;cx.strokeStyle="rgba("+GOLD+","+(a*.7)+")";cx.lineWidth=1;cx.beginPath();cx.moveTo(d.x,d.y);cx.lineTo(P.x,P.y);cx.stroke();d.x+=dx*.0016*k;d.y+=dy*.0016*k}}
    cx.fillStyle="rgba("+(d.g?GOLD:BLUE)+","+(d.g?.75:.5)+")";cx.beginPath();cx.arc(d.x,d.y,d.r,0,6.283);cx.fill()}}
  for(i=sp.length-1;i>=0;i--){var s=sp[i];s.x+=s.vx*k;s.y+=s.vy*k;s.l-=s.d*k;if(s.l<=0){sp.splice(i,1);continue}
   if(s.ring){s.r+=2.4*k;cx.strokeStyle="rgba("+GOLD+","+(s.l*.7)+")";cx.lineWidth=1.6;cx.beginPath();cx.arc(s.x,s.y,s.r,0,6.283);cx.stroke()}
   else{s.vy+=.06*k;cx.fillStyle="rgba("+(s.g?GOLD:BLUE)+","+s.l+")";cx.beginPath();cx.arc(s.x,s.y,s.r*s.l+.3,0,6.283);cx.fill()}}
  if(glow&&P.on)glow.style.transform="translate3d("+P.x+"px,"+P.y+"px,0)"}
 /* pointer */
 D.addEventListener("pointermove",function(e){P.x=e.clientX;P.y=e.clientY;P.on=1;if(glow&&P.on)glow.style.transform="translate3d("+P.x+"px,"+P.y+"px,0)"},{passive:true});
 D.addEventListener("pointerleave",function(){P.on=0});
 D.addEventListener("pointerup",function(e){if(e.pointerType!=="mouse")P.on=0});
 D.addEventListener("pointerdown",function(e){if(!scrOK||!ON("click"))return;var t=e.target;
  if(t.closest&&t.closest("button,a,input,textarea,select,label,[onclick],[role=button],.dq-mdl,#dqa-mdl,.v3-cd,.nw-card,.exam-item-card,.folder-card,.dqst>*,.yq-news"))return;
  ring(e.clientX,e.clientY);burst(e.clientX,e.clientY,16)},{passive:true});
 var rt;W.addEventListener("resize",function(){clearTimeout(rt);rt=setTimeout(size,200)});
 D.addEventListener("visibilitychange",function(){last=0});
 size();requestAnimationFrame(tick);
 /* intro: light sweep + spark burst once the splash is gone */
 var done=0;function intro(){if(done)return;done=1;if(!ON("intro")||!screenOK())return;try{if(sessionStorage.getItem("dqw_i"))return;sessionStorage.setItem("dqw_i","1")}catch(e){}
  var s=mk("div","dqw-sweep");s.innerHTML="<i></i>";B.appendChild(s);setTimeout(function(){s.remove()},1700);
  var cxm=w/2,cym=h*.34;burst(cxm,cym,46);setTimeout(function(){burst(cxm-w*.22,cym+40,22)},260);setTimeout(function(){burst(cxm+w*.22,cym+40,22)},420)}
 var spl=D.getElementById("dq-splash");
 if(spl&&D.body.contains(spl)&&!spl.classList.contains("off")){
  var mo=new MutationObserver(function(){if(spl.classList.contains("off")||!D.body.contains(spl)){mo.disconnect();(window.DQBOOT?DQBOOT.idle(intro,250):setTimeout(intro,250))}});mo.observe(spl,{attributes:true,attributeFilter:["class"]});
  setTimeout(function(){mo.disconnect();intro()},14000)}
 else setTimeout(intro,400);
 /* 3D tilt + glare on cards (precise pointers only) */
 if(FINE){
  var TS=".exam-item-card,.folder-card,.nw-card,.stat-card,.tv2-card,.bq-card,.v3-cd,.dqst>*",cur=null;
  function reset(c){if(!c)return;c.classList.remove("dqw-mv");c.classList.add("dqw-rs");c.style.transform="";var g=c.querySelector(":scope>.dqw-gl");g&&(g.style.opacity="");setTimeout(function(){c.classList.remove("dqw-rs")},620)}
  D.addEventListener("pointermove",function(e){
   if(!ON("tilt")){if(cur){reset(cur);cur=null}return}
   var c=e.target.closest&&e.target.closest(TS);if(c&&(c.closest("#exam-screen,#admin-panel")))c=null;
   if(c!==cur){reset(cur);cur=c;if(c){c.classList.add("dqw-tl");if(getComputedStyle(c).position==="static")c.style.position="relative";if(!c.querySelector(":scope>.dqw-gl")){var g=D.createElement("i");g.className="dqw-gl";c.appendChild(g)}}}
   if(!c)return;var r=c.getBoundingClientRect(),px=(e.clientX-r.left)/r.width,py=(e.clientY-r.top)/r.height;
   c.classList.remove("dqw-rs");c.classList.add("dqw-mv");
   c.style.transform="perspective(900px) rotateX("+((.5-py)*7).toFixed(2)+"deg) rotateY("+((px-.5)*9).toFixed(2)+"deg) translateZ(0) scale(1.018)";
   c.style.setProperty("--gx",(px*100)+"%");c.style.setProperty("--gy",(py*100)+"%")},{passive:true});
  D.addEventListener("pointerleave",function(){reset(cur);cur=null});
 }
}catch(err){console.warn("[dq-wow]",err)}});
})();
;

/* ===== dq-router ===== */
/* DQ bölmə keçidləri: /?go=test | sinaq | news | reg  (Worker /test, /sinaq, /news, /qeydiyyat buraya yönləndirir) */
(function(){"use strict";
var go;try{go=new URL(location.href).searchParams.get("go")}catch(e){}
if(!go)return;go=String(go).toLowerCase().replace(/ı/g,"i");
if(["test","sinaq","news","reg"].indexOf(go)<0)return;
function clean(){try{history.replaceState(null,"",location.pathname)}catch(e){}}
function has(n){try{return typeof (0,eval)(n)!=="undefined"}catch(e){return false}}
function item(a){try{var it=V3.D.items;for(var k in it)if(it[k]&&it[k].a===a)return k}catch(e){}return null}
function run(){
  if(go==="reg"){if(!(window.LXP&&LXP.open))return false;LXP.open();return true}
  if(go==="news"){if(typeof openFeedModal!=="function")return false;openFeedModal("news");return true}
  if(!has("V3")||typeof V3.go!=="function")return false;
  var ready=!!(V3.D&&V3.D.items);if(!ready&&n<20)return false;
  if(go==="test"){var t=item("tests");if(t)V3.go(t);else if(V3.showTests)V3.showTests();else return false;return true}
  if(go==="sinaq"){var x=item("exam");if(x)V3.go(x);else if(has("DQ")&&DQ.openCabinet)DQ.openCabinet();else return false;return true}
  return false}
var n=0,iv=setInterval(function(){n++;var ok=false;try{ok=run()}catch(e){ok=false}
  if(ok){clearInterval(iv);clean()}else if(n>60){clearInterval(iv);clean()}},400);
})();
;

/* ===== tlx-js ===== */
(function(){
"use strict";
if(window.TLX)return;

/* =====================================================================
   İLKİN MƏLUMAT — canlı məlumatı admin paneldəki «🎠 Karusel» modulu idarə edir; bu siyahı yalnız ehtiyat (ilkin) variantdır
   ===================================================================== */

/* Sual yazmaq üçün qısa yazılış:
     Q('Sual mətni', ['A variantı','B variantı','C variantı','D variantı'], 1, 'İzah (ixtiyari)')
   Üçüncü parametr — düzgün variantın nömrəsi:  0 = A,  1 = B,  2 = C,  3 = D,  4 = E
   Nümunə:
     questions:[
       Q('2 + 2 neçədir?', ['3','4','5','6'], 1, '2 + 2 = 4'),
       Q('Paytaxt hansıdır?', ['Bakı','Gəncə','Sumqayıt'], 0)
     ]
*/
function Q(t,o,c,e){return{t:t,o:o,c:c,e:e||""}}

var CFG={
  minPerQuestion:1,        // vaxt: hər sual üçün neçə dəqiqə (mövzuda "time" yazılıbsa, o götürülür)
  shuffleQuestions:false,  // true — suallar hər dəfə qarışıq sırada gəlsin
  shuffleOptions:false,    // true — variantlar hər dəfə qarışıq sırada gəlsin
  autoDelay:2600,          // karuselin avtomatik keçid vaxtı (ms)
  showAdminTests:false     // true — köhnə «Fənlər üzrə testlər» (admin paneldən əlavə olunan testlər) da altda göstərilsin
};

/* count — sual əlavə olunana qədər kartda görünən planlaşdırılmış sual sayı.
   questions-a sual əlavə etdikdə say avtomatik real sual sayına çevrilir.
   time    — (ixtiyari) testin müddəti, dəqiqə ilə. */
var TLX_SUBJECTS=[
 {name:"Məntiq",icon:"🧠",grad:["#7c3aed","#4c1d95"],acc:"#c4b5fd",topics:[
   {name:"Riyazi məntiq",count:45,questions:[]},
   {name:"Verbal məntiq",count:40,questions:[]},
   {name:"Şəkil məntiqi",count:35,questions:[]},
   {name:"Suyun axını",count:30,questions:[]},
   {name:"Məntiqi nəticə",count:50,questions:[]}
 ]},
 {name:"Qanunvericilik",icon:"⚖️",grad:["#2f63bd","#0a2f7a"],acc:"#8fb3ec",topics:[
   {name:"Konstitusiya",count:50,questions:[]},
   {name:"Dövlət qulluğu haqqında",count:60,questions:[]},
   {name:"İnzibati hüquq",count:45,questions:[]},
   {name:"Əmək hüququ",count:40,questions:[]},
   {name:"Cinayət hüququ",count:55,questions:[]}
 ]},
 {name:"Azərbaycan dili",icon:"📖",grad:["#059669","#065f46"],acc:"#6ee7b7",topics:[
   {name:"Fonetika",count:40,questions:[]},
   {name:"Leksika",count:45,questions:[]},
   {name:"Söz yaradıcılığı",count:35,questions:[]},
   {name:"Morfologiya",count:50,questions:[]},
   {name:"Sintaksis",count:40,questions:[]}
 ]},
 {name:"İnformatika",icon:"💻",grad:["#ea580c","#7c2d12"],acc:"#fdba74",topics:[
   {name:"Alqoritmlər",count:35,questions:[]},
   {name:"Şəbəkələr",count:40,questions:[]},
   {name:"Verilənlər bazası",count:30,questions:[]},
   {name:"MS Office",count:45,questions:[]},
   {name:"Kibertəhlükəsizlik",count:25,questions:[]}
 ]}
];

/* =====================================================================
   MÜHƏRRİK — aşağıdakı hissəyə toxunmağa ehtiyac yoxdur
   ===================================================================== */
var BEST_KEY="dq_tlx_best",LETTERS="ABCDEF";
var RM=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
var $=function(i){return document.getElementById(i)};
var esc=function(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})};
var pad=function(n){return String(n).padStart(2,"0")};
var INST=[];

/* --- məlumatın yoxlanması və normallaşdırılması --- */
function validQ(q){
  return q&&typeof q.t==="string"&&q.t.trim()&&Array.isArray(q.o)&&q.o.length>=2&&q.o.length<=LETTERS.length&&
    q.o.every(function(x){return String(x).trim()})&&Number.isInteger(q.c)&&q.c>=0&&q.c<q.o.length;
}
var DATA=[];
var PALX=[["#7c3aed","#4c1d95","#c4b5fd"],["#2f63bd","#0a2f7a","#8fb3ec"],["#059669","#065f46","#6ee7b7"],["#ea580c","#7c2d12","#fdba74"],["#db2777","#831843","#f9a8d4"],["#0891b2","#164e63","#67e8f9"],["#ca8a04","#713f12","#fde047"],["#dc2626","#7f1d1d","#fca5a5"]];
/* Tək məlumat mənbəyi: «🎠 Karusel» modulunun kataloqu (KRS). Yoxdursa — yuxarıdakı ilkin siyahı. */
function catalogue(){
  var d=window.KRS_DATA;if(d&&Array.isArray(d.subjects))return d.subjects;
  try{var c=JSON.parse(localStorage.getItem("krs_cache_v1")||"null");if(c&&Array.isArray(c.subjects))return c.subjects}catch(e){}
  return TLX_SUBJECTS.map(function(s){return{name:s.name,icon:s.icon,c1:s.grad[0],c2:s.grad[1],acc:s.acc,
    topics:(s.topics||[]).map(function(t){return{name:t.name,count:t.count,time:t.time,qs:t.questions||[]}})}});
}
function buildData(){
  DATA=catalogue().filter(function(s){return s&&s.name&&!s.hidden}).map(function(s,i){
    var p=PALX[i%PALX.length];
    return{name:s.name,icon:s.icon||"📚",grad:[s.c1||p[0],s.c2||p[1]],acc:s.acc||p[2],
      topics:(s.topics||[]).filter(function(t){return t&&t.name&&!t.hidden}).map(function(t){
        var qs=(t.qs||[]).filter(function(q,k){var ok=validQ(q);if(!ok)console.warn("[TLX] "+s.name+" / "+t.name+": "+(k+1)+"-ci sual yanlış formatdadır və buraxıldı.");return ok});
        return{name:t.name,planned:+t.count||0,time:+t.time||0,qs:qs,n:qs.length||(+t.count||0)}})}
  }).filter(function(s){return s.topics.length});
}
buildData();

/* --- ən yaxşı nəticə (yalnız bu cihazda) --- */
function bestAll(){try{return JSON.parse(localStorage.getItem(BEST_KEY)||"{}")||{}}catch(e){return{}}}
function bestKey(s,t){return s.name+"|"+t.name}
function bestSave(s,t,p){try{var b=bestAll(),k=bestKey(s,t);if(!(b[k]>=p)){b[k]=p;localStorage.setItem(BEST_KEY,JSON.stringify(b))}}catch(e){}}

/* --- qab şəkli (SVG) --- */
function wrapTxt(text,max){
  var w=text.split(" "),L=[],c="";
  w.forEach(function(x){var t=(c?c+" ":"")+x;if(t.length>max&&c){L.push(c);c=x}else c=t});
  if(c)L.push(c);return L.slice(0,3);
}
function cover(s,topic){
  var c1=s.grad[0],c2=s.grad[1],acc=s.acc,lines=wrapTxt(topic.toUpperCase(),15);
  var ts=lines.map(function(l,i){return"<tspan x='150' y='"+(286+i*26)+"'>"+esc(l)+"</tspan>"}).join("");
  var lineY=286+(lines.length-1)*26+18;
  var svg="<svg xmlns='http://www.w3.org/2000/svg' width='300' height='420' viewBox='0 0 300 420'>"
   +"<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='"+c2+"'/><stop offset='1' stop-color='"+c1+"'/></linearGradient>"
   +"<pattern id='p' width='26' height='26' patternUnits='userSpaceOnUse'><circle cx='2' cy='2' r='1.1' fill='rgba(255,255,255,.16)'/></pattern></defs>"
   +"<rect width='300' height='420' rx='18' fill='url(#g)'/><rect width='300' height='420' rx='18' fill='url(#p)'/>"
   +"<rect x='-30' y='-30' width='120' height='120' rx='20' fill='rgba(255,255,255,.07)' transform='rotate(45 30 30)'/>"
   +"<rect x='250' y='370' width='110' height='110' rx='18' fill='rgba(255,255,255,.06)' transform='rotate(45 305 425)'/>"
   +"<rect x='14' y='14' width='272' height='392' rx='12' fill='none' stroke='rgba(255,255,255,.35)' stroke-width='1.5' stroke-dasharray='7 6'/>"
   +"<circle cx='150' cy='118' r='62' fill='rgba(255,255,255,.12)'/><circle cx='150' cy='118' r='62' fill='none' stroke='rgba(255,255,255,.35)' stroke-width='1.5'/>"
   +"<circle cx='150' cy='118' r='74' fill='none' stroke='"+acc+"' stroke-width='1' stroke-dasharray='3 7' opacity='.8'/>"
   +"<text x='150' y='140' font-size='54' text-anchor='middle'>"+esc(s.icon)+"</text>"
   +"<rect x='55' y='196' width='190' height='27' rx='13.5' fill='rgba(0,0,0,.22)'/>"
   +"<text x='150' y='215' font-size='13.5' font-weight='800' letter-spacing='1' text-anchor='middle' fill='#fff' font-family='Arial'>"+esc(s.name.toUpperCase())+"</text>"
   +"<text x='150' y='0' font-size='21' font-weight='800' text-anchor='middle' fill='#fff' font-family='Arial'>"+ts+"</text>"
   +"<line x1='95' y1='"+lineY+"' x2='205' y2='"+lineY+"' stroke='"+acc+"' stroke-width='3' stroke-linecap='round'/>"
   +"<text x='150' y='368' font-size='11.5' letter-spacing='1.5' text-anchor='middle' fill='rgba(255,255,255,.85)' font-family='Arial'>DQ PLATFORM • SINAQLAR</text>"
   +"<text x='150' y='390' font-size='13' font-weight='800' text-anchor='middle' fill='"+acc+"' font-family='Arial'>"+monthYear()+"</text>"
   +"</svg>";
  return"data:image/svg+xml;utf8,"+encodeURIComponent(svg);
}
function monthYear(){var d=new Date();return pad(d.getMonth()+1)+"."+d.getFullYear()}

/* --- bildiriş --- */
var toastT=0;
function toast(msg){
  var el=$("tlx-toast");
  if(!el){el=document.createElement("div");el.id="tlx-toast";el.setAttribute("role","status");document.body.appendChild(el)}
  el.textContent=msg;el.classList.add("on");clearTimeout(toastT);toastT=setTimeout(function(){el.classList.remove("on")},2800);
}

/* --- karusel kartı --- */
function buildCard(s,ci){
  var card=document.createElement("article"),n=s.topics.length,total=s.topics.reduce(function(a,t){return a+t.n},0);
  card.className="tlx-card";card.style.setProperty("--a1",s.grad[0]);card.style.setProperty("--a2",s.grad[1]);card.style.setProperty("--d",(ci*.13)+"s");
  card.innerHTML='<div class="tlx-in"><div class="tlx-head"><div class="tlx-ico" aria-hidden="true">'+esc(s.icon)+'</div>'
    +'<div class="tlx-ht"><h3>'+esc(s.name)+'</h3><span>'+n+' mövzu • '+total+' sual</span></div>'
    +'<div class="tlx-count" aria-hidden="true"><span class="tlx-cur">01</span><em>/ '+pad(n)+'</em></div></div>'
    +'<div class="tlx-stage" role="group" aria-roledescription="karusel" aria-label="'+esc(s.name)+' mövzuları" tabindex="0">'
    +'<div class="tlx-orbit r1"></div><div class="tlx-orbit r2"></div><div class="tlx-halo"></div><div class="tlx-ring"></div></div>'
    +'<div class="tlx-topicline"><span class="tlx-tn"><span class="tlx-topic-name" aria-live="polite"></span></span><span class="tlx-sual"></span></div>'
    +'<div class="tlx-dots"></div><div class="tlx-bar" aria-hidden="true"><i></i></div>'
    +'<button type="button" class="tlx-btn">Testə başla <span class="ar" aria-hidden="true">→</span></button></div>';

  var ring=card.querySelector(".tlx-ring"),stage=card.querySelector(".tlx-stage"),dots=card.querySelector(".tlx-dots"),
      nameEl=card.querySelector(".tlx-topic-name"),sualEl=card.querySelector(".tlx-sual"),cntEl=card.querySelector(".tlx-cur"),
      bar=card.querySelector(".tlx-bar i"),startBtn=card.querySelector(".tlx-btn");
  var active=0,timer=0,st={hover:false,focus:false,vis:true,dead:false};

  var covers=s.topics.map(function(t,k){
    var b=document.createElement("button");b.type="button";b.className="tlx-cover";b.setAttribute("aria-label",t.name);
    b.style.backgroundImage='url("'+cover(s,t.name)+'")';
    b.addEventListener("click",function(){if(Date.now()-(stage.__mv||0)<300)return;if(k===active)begin(s,t,b);else{go(k);sync()}});
    ring.appendChild(b);return b});
  var dEls=s.topics.map(function(t,k){
    var b=document.createElement("button");b.type="button";b.setAttribute("aria-label",(k+1)+". "+t.name);
    b.addEventListener("click",function(){go(k);sync()});dots.appendChild(b);return b});

  function layout(){
    var h=Math.floor(n/2);
    covers.forEach(function(el,i){
      var off=i-active;if(off>h)off-=n;if(off<-h)off+=n;var a=Math.abs(off);
      el.style.transform="translateX("+(off*72)+"px) translateZ("+(-a*140)+"px) rotateY("+(-off*38)+"deg) scale("+(1-a*.14)+")";
      el.style.zIndex=String(20-a);el.style.opacity=a>2?"0":"1";el.style.pointerEvents=a>2?"none":"";
      el.style.filter=a?"brightness("+(1-a*.25)+")":"none";el.tabIndex=a?-1:0;el.classList.toggle("on",off===0);
    });
  }
  function label(){
    var t=s.topics[active],b=bestAll()[bestKey(s,t)];
    sualEl.textContent="• "+t.n+" sual"+(b>=0&&t.qs.length?" • ən yaxşı "+b+"%":"");
  }
  function go(i){
    var prev=active;active=((i%n)+n)%n;layout();
    var d=active-prev;if(d>n/2)d-=n;if(d<-n/2)d+=n;var sfx=d>=0?"R":"L",t=s.topics[active];
    if(!nameEl.textContent){nameEl.textContent=t.name}
    else if(prev!==active){
      var old=nameEl,nw=document.createElement("span");
      nw.className="tlx-topic-name in"+sfx;nw.textContent=t.name;nw.setAttribute("aria-live","polite");
      old.className="tlx-topic-name out"+sfx;old.removeAttribute("aria-live");
      old.parentNode.appendChild(nw);nameEl=nw;setTimeout(function(){old.remove()},560);
    }
    label();
    sualEl.classList.remove("sw");void sualEl.offsetWidth;sualEl.classList.add("sw");
    cntEl.classList.remove("tk","tkR","tkL");void cntEl.offsetWidth;cntEl.textContent=pad(active+1);cntEl.classList.add("tk"+sfx);
    dEls.forEach(function(d2,k){d2.setAttribute("aria-current",k===active)});
  }
  function stop(){clearInterval(timer);timer=0;bar.style.transition="none";bar.style.width="0%"}
  function sync(){
    stop();
    if(RM||n<2||st.dead||st.hover||st.focus||!st.vis||document.hidden||runOpen())return;
    void bar.offsetWidth;bar.style.transition="width "+CFG.autoDelay+"ms linear";bar.style.width="100%";
    timer=setInterval(function(){if(!card.isConnected){destroy();return}go(active+1)},CFG.autoDelay);
  }
  function destroy(){st.dead=true;stop();try{io.disconnect()}catch(e){}document.removeEventListener("visibilitychange",sync)}

  card.addEventListener("mouseenter",function(){st.hover=true;sync()});
  card.addEventListener("mouseleave",function(){st.hover=false;sync()});
  card.addEventListener("focusin",function(){st.focus=true;sync()});
  card.addEventListener("focusout",function(){st.focus=false;sync()});
  stage.addEventListener("keydown",function(e){
    if(e.key==="ArrowRight"){e.preventDefault();go(active+1);sync()}else if(e.key==="ArrowLeft"){e.preventDefault();go(active-1);sync()}});
  var sx=null;
  stage.addEventListener("pointerdown",function(e){if(e.pointerType==="mouse"&&e.button!==0)return;sx=e.clientX});
  stage.addEventListener("pointerup",function(e){if(sx===null)return;var dx=e.clientX-sx;sx=null;if(Math.abs(dx)>40){stage.__mv=Date.now();go(active+(dx<0?1:-1));sync()}});
  stage.addEventListener("pointercancel",function(){sx=null});
  startBtn.addEventListener("click",function(){begin(s,s.topics[active],startBtn)});

  /* 3D meyil (yalnız siçanlı cihazlarda) */
  var inner=card.querySelector(".tlx-in");
  if(!RM&&window.matchMedia&&matchMedia("(hover:hover) and (pointer:fine)").matches){
    card.addEventListener("mousemove",function(e){var r=card.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      inner.style.transform="rotateY("+(x*7)+"deg) rotateX("+(-y*7)+"deg) translateY(-3px)"});
    card.addEventListener("mouseleave",function(){inner.style.transform=""});
  }
  var io=new IntersectionObserver(function(es){var e=es[es.length-1];st.vis=e.isIntersecting;   /* ən son vəziyyət */
    if(e.isIntersecting)card.classList.add("in");sync()},{threshold:.12});
  io.observe(card);
  document.addEventListener("visibilitychange",sync);
  go(0);
  INST.push({card:card,destroy:destroy,refresh:function(){label()},sync:sync});
  return card;
}

/* --- paneli ekrana yerləşdirir --- */
function enhance(){
  var root=$("v3-tests");
  if(root)root.querySelectorAll(".dt-day,.tm-soon").forEach(function(x){x.remove()});   /* «Günün tövsiyə testi» və «Tezliklə» silinir */
  if(!root||root.querySelector(".tlx"))return;
  var sec=root.querySelector(".dt-sec");if(!sec||!DATA.length)return;
  INST.forEach(function(i){i.destroy()});INST.length=0;
  var panel=document.createElement("section");panel.className="tlx";panel.setAttribute("aria-label","Fənlər üzrə testlər");
  panel.innerHTML='<div class="tlx-hd"><span class="tlx-pill">MÖVZU TESTLƏRİ • '+DATA.length+' FƏNN</span><h2>Fənlər üzrə testlər</h2>'
    +'<div class="tlx-rule"><i></i><b>✦</b><i></i></div>'
    +'<p>Mövzular üzrə hazırlanmış interaktiv test qabları. Mövzunu seçin və «Testə başla» düyməsini basın — qabların üzərinə gəldikdə fırlanma dayanır.</p></div>'
    +'<div class="tlx-grid"></div><div class="tlx-foot">© 2026 DQ Platform • Bütün hüquqlar qorunur</div>';
  var grid=panel.querySelector(".tlx-grid");
  DATA.forEach(function(s,i){grid.appendChild(buildCard(s,i))});
  sec.parentNode.insertBefore(panel,CFG.showAdminTests?sec:sec.nextSibling);
  root.classList.toggle("tlx-on",!CFG.showAdminTests);
  /* IntersectionObserver gec işə düşsə belə kartlar görünsün */
  setTimeout(function(){panel.querySelectorAll(".tlx-card").forEach(function(c){c.classList.add("in")})},1600);
}

/* =====================================================================
   TEST HƏLLİ PƏNCƏRƏSİ
   ===================================================================== */
var R=null,runEl=null;
function runOpen(){return!!(runEl&&runEl.classList.contains("open"))}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),x=a[i];a[i]=a[j];a[j]=x}return a}
function fmt(s){return pad(Math.floor(s/60))+":"+pad(s%60)}

function begin(s,t,opener){
  if(typeof DQ!=="undefined"&&DQ.cabinet&&!DQ.cabinet()){
    try{DQ.pending="tests";showScreen("login-screen");DQ.msg("Fənn testlərində iştirak üçün əvvəlcə kabinetə daxil olun.")}catch(e){}return}
  if(!t.qs.length){toast("«"+t.name+"» sualları hazırlanır — tezliklə aktiv olacaq ✨");return}
  var qs=t.qs.slice();if(CFG.shuffleQuestions)shuffle(qs);
  qs=qs.map(function(q){
    var idx=q.o.map(function(_,i){return i});if(CFG.shuffleOptions)shuffle(idx);
    return{t:q.t,i:q.i,o:idx.map(function(i){return q.o[i]}),c:idx.indexOf(q.c),e:q.e};
  });
  var mins=t.time>0?t.time:Math.max(1,Math.round(qs.length*CFG.minPerQuestion));
  R={s:s,t:t,qs:qs,a:qs.map(function(){return-1}),i:0,end:Date.now()+mins*60000,total:mins*60,t0:Date.now(),done:false,opener:opener,timer:0};
  var tl=$("tlx-toast");if(tl)tl.classList.remove("on");
  ensureRun();paintShell();showQ();
  runEl.classList.add("open");document.documentElement.style.overflow="hidden";
  INST.forEach(function(i){i.sync()});
  R.timer=setInterval(tick,500);tick();
  runEl.querySelector(".tlx-rbody").focus();
}
function ensureRun(){
  if(runEl)return;
  runEl=document.createElement("div");runEl.id="tlx-run";runEl.setAttribute("role","dialog");runEl.setAttribute("aria-modal","true");runEl.setAttribute("aria-labelledby","tlx-rt");
  runEl.innerHTML='<div class="tlx-rtop"><div class="tlx-rttl"><b id="tlx-rt"></b><small></small></div><div class="tlx-rtm" id="tlx-tm" role="timer">00:00</div>'
    +'<button type="button" class="tlx-rx" aria-label="Bağla">✕</button></div><div class="tlx-rpb" aria-hidden="true"><i></i></div>'
    +'<div class="tlx-rbody" tabindex="-1"><div class="tlx-rin"></div></div><div class="tlx-rft"></div>';
  document.body.appendChild(runEl);
  runEl.querySelector(".tlx-rx").addEventListener("click",function(){closeRun()});
  runEl.querySelector(".tlx-rft").addEventListener("click",footClick);
  document.addEventListener("keydown",onKey);
}
function paintShell(){
  runEl.querySelector("#tlx-rt").textContent=R.t.name;
  runEl.querySelector(".tlx-rttl small").textContent=R.s.name+" • "+R.qs.length+" sual";
  runEl.querySelector("#tlx-tm").classList.remove("low");
}
function inner(){return runEl.querySelector(".tlx-rin")}
function foot(){return runEl.querySelector(".tlx-rft")}
function answered(){return R.a.filter(function(x){return x>=0}).length}
function paintProg(){runEl.querySelector(".tlx-rpb i").style.width=(answered()/R.qs.length*100)+"%"}

function showQ(){
  var q=R.qs[R.i],n=R.qs.length;
  inner().innerHTML='<div class="tlx-qn">Sual <b>'+(R.i+1)+'</b> / '+n+' • cavablandırılıb: <span id="tlx-ac">'+answered()+'</span></div>'
    +'<h3 class="tlx-qt">'+esc(q.t)+'</h3>'+(q.i?'<img src="'+q.i+'" alt="" style="max-width:100%;border-radius:10px;margin:8px 0;background:#fff">':'')+'<div class="tlx-opts" role="radiogroup" aria-label="Variantlar">'
    +q.o.map(function(o,k){return'<button type="button" class="tlx-opt" role="radio" data-k="'+k+'"><i>'+LETTERS[k]+'</i><span>'+esc(o)+'</span></button>'}).join("")
    +'</div><button type="button" class="tlx-clr" hidden>Cavabı təmizlə</button><div class="tlx-pal" aria-label="Suallar">'
    +R.qs.map(function(_,k){return'<button type="button" data-q="'+k+'" aria-label="'+(k+1)+'-ci sual">'+(k+1)+'</button>'}).join("")+'</div>';
  foot().innerHTML='<button type="button" class="tlx-rb" data-a="prev">← Əvvəlki</button><button type="button" class="tlx-rb" data-a="next">Növbəti →</button><button type="button" class="tlx-rb g" data-a="fin">Testi bitir</button>';
  inner().querySelector(".tlx-opts").addEventListener("click",function(e){var b=e.target.closest(".tlx-opt");if(b)pick(+b.dataset.k)});
  inner().querySelector(".tlx-clr").addEventListener("click",function(){pick(-1)});
  inner().querySelector(".tlx-pal").addEventListener("click",function(e){var b=e.target.closest("button");if(b){R.i=+b.dataset.q;showQ()}});
  paintOpts();paintProg();
  var rb=runEl.querySelector(".tlx-rbody");rb.scrollTop=0;
  if(!runEl.contains(document.activeElement))rb.focus({preventScroll:true});
}
function footClick(e){
  var b=e.target.closest("[data-a]");if(!b||!R)return;
  var a=b.dataset.a;
  if(R.done){
    if(a==="back")closeRun(true);
    else if(a==="again"){var s=R.s,t=R.t,o=R.opener;closeRun(true,true);begin(s,t,o)}
    return}
  if(a==="prev"&&R.i>0){R.i--;showQ()}
  else if(a==="next"&&R.i<R.qs.length-1){R.i++;showQ()}
  else if(a==="fin")finish(false);
}
function paintOpts(){
  var cur=R.a[R.i];
  inner().querySelectorAll(".tlx-opt").forEach(function(b,k){b.classList.toggle("on",k===cur);b.setAttribute("aria-checked",k===cur)});
  inner().querySelector(".tlx-clr").hidden=cur<0;
  inner().querySelectorAll(".tlx-pal button").forEach(function(b,k){b.classList.toggle("dn",R.a[k]>=0);b.classList.toggle("cu",k===R.i)});
  var ac=$("tlx-ac");if(ac)ac.textContent=answered();
  var f=foot();f.querySelector('[data-a=prev]').disabled=R.i===0;f.querySelector('[data-a=next]').disabled=R.i===R.qs.length-1;
}
function pick(k){if(!R||R.done)return;R.a[R.i]=k;paintOpts();paintProg()}

function tick(){
  if(!R||R.done)return;
  var left=Math.max(0,Math.round((R.end-Date.now())/1000)),tm=$("tlx-tm");
  tm.textContent=fmt(left);tm.classList.toggle("low",left<=60);
  if(left<=0){toast("⏰ Vaxt bitdi — nəticə yoxlanıldı");finish(true)}
}
function finish(auto){
  if(!R||R.done)return;
  var blank=R.a.filter(function(x){return x<0}).length;
  if(!auto&&blank&&!confirm(blank+" sual cavabsızdır. Testi bitirmək istəyirsiniz?"))return;
  R.done=true;clearInterval(R.timer);
  var n=R.qs.length,ok=0,bad=0;
  R.qs.forEach(function(q,i){if(R.a[i]<0){}else if(R.a[i]===q.c)ok++;else bad++});
  var pc=Math.round(ok/n*100),spent=Math.min(R.total,Math.round((Date.now()-R.t0)/1000));
  bestSave(R.s,R.t,pc);INST.forEach(function(i){i.refresh()});
  var msg=pc>=85?"Əla nəticə! 🏆":pc>=65?"Yaxşı nəticə 👏":pc>=45?"Pis deyil, davam edin 💪":"Mövzunu təkrar edin 📚";
  var rev=R.qs.map(function(q,i){
    var u=R.a[i],st=u<0?"➖":u===q.c?"✅":"❌";
    return'<details><summary><em>'+st+'</em><span>'+(i+1)+'. '+esc(q.t)+'</span></summary><div class="tlx-rv">'
      +q.o.map(function(o,k){var cls=k===q.c?"ok":k===u?"no":"";
        return'<div class="'+cls+'"><b>'+LETTERS[k]+'.</b> '+esc(o)+(k===q.c?" ✔":"")+(k===u&&k!==q.c?" (sizin cavab)":"")+'</div>'}).join("")
      +(u<0?'<div>Bu suala cavab verilməyib.</div>':'')+(q.e?'<p>💡 '+esc(q.e)+'</p>':'')+'</div></details>'}).join("");
  inner().innerHTML='<div class="tlx-res"><div class="tlx-score" style="--p:'+pc+'"><div><b>'+ok+' / '+n+'</b><small>'+pc+'% uğur</small></div></div>'
    +'<h3>'+msg+'</h3><p>'+esc(R.s.name)+' • '+esc(R.t.name)+'</p>'
    +'<div class="tlx-st"><span>✅ Düz: '+ok+'</span><span>❌ Səhv: '+bad+'</span><span>➖ Boş: '+(n-ok-bad)+'</span><span>⏱ '+fmt(spent)+'</span></div></div><div class="tlx-rev">'+rev+'</div>';
  foot().innerHTML='<button type="button" class="tlx-rb" data-a="again">↻ Yenidən</button><button type="button" class="tlx-rb g" data-a="back">Testlərə qayıt</button>';
  var tm=runEl.querySelector("#tlx-tm");tm.classList.remove("low");tm.textContent=fmt(spent);
  runEl.querySelector(".tlx-rpb i").style.width="100%";
  var rb=runEl.querySelector(".tlx-rbody");rb.scrollTop=0;rb.focus();
}
function closeRun(force,silent){
  if(!R)return;
  if(!R.done&&!force&&!confirm("Testdən çıxılsın? Cavablar itəcək."))return;
  clearInterval(R.timer);var op=R.opener;R=null;
  runEl.classList.remove("open");
  document.documentElement.style.overflow="";
  if(!silent){INST.forEach(function(i){i.sync()});try{op&&op.isConnected&&op.focus()}catch(e){}}
}
function onKey(e){
  if(!R)return;
  if(e.key==="Escape"){e.preventDefault();closeRun();return}
  if(e.key==="Tab"){
    var f=[].filter.call(runEl.querySelectorAll("button:not([disabled]):not([hidden]),summary,[tabindex='0']"),function(x){return x.offsetParent!==null});
    if(!f.length)return;var a=f[0],z=f[f.length-1];
    if(!runEl.contains(document.activeElement)){e.preventDefault();a.focus();return}
    if(e.shiftKey&&document.activeElement===a){e.preventDefault();z.focus()}else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus()}
    return}
  if(R.done||e.ctrlKey||e.metaKey||e.altKey)return;
  if(e.key==="ArrowRight"&&R.i<R.qs.length-1){R.i++;showQ()}
  else if(e.key==="ArrowLeft"&&R.i>0){R.i--;showQ()}
  else{var k=LETTERS.indexOf(String(e.key).toUpperCase());
    if(k<0&&/^[1-6]$/.test(e.key))k=+e.key-1;
    if(k>=0&&k<R.qs[R.i].o.length&&e.target.tagName!=="SUMMARY")pick(k)}
}

/* --- «Testlər» ekranına qoşulma --- */
function hook(){
  var root=$("v3-tests");if(!root)return false;
  new MutationObserver(function(){try{enhance()}catch(e){console.error("[TLX]",e)}}).observe(root,{childList:true});
  try{enhance()}catch(e){console.error("[TLX]",e)}
  return true;
}
if(!hook()){document.addEventListener("DOMContentLoaded",hook)}

window.TLX={v2:true,subjects:TLX_SUBJECTS,config:CFG,refresh:function(){buildData();var r=$("v3-tests"),p=r&&r.querySelector(".tlx");p&&p.remove();enhance()}};
})();
;

/* ===== dqcr-js ===== */
(function(){
"use strict";
if(window.DQCR)return;

/* =====================================================================
   DQCR — Karusel & Mövzu idarəsi
   · Fənn / mövzu / sual əlavə etmə (Supabase dq_v2_store, V2 ilə eyni baza)
   · Ana səhifə: Standart karusel (quiz + elan) və ⚡ Günün sualı fleşkart karuseli
   ===================================================================== */

var C={sub:"tlx_subjects",top:"tlx_topics",sl:"dqcr_slides",fl:"dqcr_flash",cfg:"dqcr_cfg"};
var KEY={};Object.keys(C).forEach(function(k){KEY[C[k]]=k});
var CACHE="dqcr_cache_v1",ANS="dqcr_fl_ans_v1",LET="ABCDEF";
var RM=!!(window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches);
var DEF={std:false,flash:false,pos:"top",auto:6000};
var S={sub:[],top:[],sl:[],fl:[],cfg:Object.assign({},DEF)};
window.DQCR_DATA=S;

var PAL=[["#7c3aed","#4c1d95","#c4b5fd"],["#2f63bd","#0a2f7a","#8fb3ec"],["#059669","#065f46","#6ee7b7"],["#ea580c","#7c2d12","#fdba74"],
         ["#db2777","#831843","#f9a8d4"],["#0891b2","#164e63","#67e8f9"],["#ca8a04","#713f12","#fde047"],["#dc2626","#7f1d1d","#fca5a5"]];

var $=function(i){return document.getElementById(i)};
var esc=function(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})};
var pad=function(n){return String(n).padStart(2,"0")};
function norm(s){
  return String(s==null?"":s).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/ə/g,"e").replace(/ı/g,"i")
    .replace(/(\d),(\d)/g,"$1.$2").replace(/[^\p{L}\p{N}\s.]/gu,"").replace(/\.(?!\d)/g,"").replace(/(^|\D)\./g,"$1").replace(/\s+/g," ").trim();
}
function th(i){return PAL[((+i||0)%PAL.length+PAL.length)%PAL.length]}
function isOn(x){return x&&x.on!==false}
function sortL(a){return a.sort(function(x,y){return(+(x.ord!=null?x.ord:x._id)||0)-(+(y.ord!=null?y.ord:y._id)||0)})}
function uid(){return Date.now()+Math.floor(Math.random()*999)}

/* ---------------------------------------------------------------------
   VERİLƏNLƏR BAZASI (V2 ilə eyni cədvəl: dq_v2_store)
   --------------------------------------------------------------------- */
async function isCloud(){
  try{
    if(typeof V2==="undefined"||typeof _supabase==="undefined")return false;
    await V2.probe();return V2.mode==="cloud";
  }catch(e){return false}
}
async function loadAll(){
  var out={};Object.keys(C).forEach(function(k){out[k]=[]});
  if(await isCloud()){
    var r=await _supabase.from("dq_v2_store").select("*").in("collection",Object.keys(KEY)).order("id",{ascending:true});
    if(r.error)throw r.error;
    (r.data||[]).forEach(function(row){var k=KEY[row.collection];if(k)out[k].push(Object.assign({},row.data,{_id:row.id}))});
  }else{
    Object.keys(C).forEach(function(k){
      try{out[k]=(JSON.parse(localStorage.getItem("dq_v2_"+C[k])||"[]")||[]).slice().reverse()}catch(e){out[k]=[]}
    });
  }
  return out;
}
async function put(k,obj,id){
  var col=C[k],data=Object.assign({},obj);delete data._id;
  if(await isCloud()){
    var r=id?await _supabase.from("dq_v2_store").update({data:data}).eq("id",id):await _supabase.from("dq_v2_store").insert([{collection:col,data:data}]);
    if(r.error)throw r.error;return;
  }
  var all=[];try{all=JSON.parse(localStorage.getItem("dq_v2_"+col)||"[]")||[]}catch(e){}
  if(id){var i=all.findIndex(function(x){return String(x._id)===String(id)});if(i>-1)all[i]=Object.assign({},data,{_id:all[i]._id})}
  else all.unshift(Object.assign({},data,{_id:uid()}));
  localStorage.setItem("dq_v2_"+col,JSON.stringify(all));
}
async function del(k,id){
  if(await isCloud()){var r=await _supabase.from("dq_v2_store").delete().eq("id",id);if(r.error)throw r.error;return}
  var col=C[k],all=[];try{all=JSON.parse(localStorage.getItem("dq_v2_"+col)||"[]")||[]}catch(e){}
  localStorage.setItem("dq_v2_"+col,JSON.stringify(all.filter(function(x){return String(x._id)!==String(id)})));
}

var lastSig="",loading=null,cfgBusy=false;
function apply(o){
  S.sub=sortL(o.sub);S.top=sortL(o.top);S.sl=sortL(o.sl);S.fl=sortL(o.fl);
  S.cfg=Object.assign({},DEF,o.cfg[0]||{});
  var sig=JSON.stringify([S.sub,S.top]),changed=sig!==lastSig;lastSig=sig;
  try{localStorage.setItem(CACHE,JSON.stringify({sub:S.sub,top:S.top,sl:S.sl,fl:S.fl,cfg:S.cfg}))}catch(e){}
  if(changed&&window.TLX&&TLX.refresh){try{TLX.refresh()}catch(e){console.warn("[DQCR] TLX",e)}}
  Home.update();
}
function refresh(force){
  if(loading&&!force)return loading;
  loading=(async function(){
    try{apply(await loadAll())}catch(e){console.warn("[DQCR]",e)}
    loading=null;
  })();
  return loading;
}
try{
  var cc=JSON.parse(localStorage.getItem(CACHE)||"null");
  if(cc){S.sub=cc.sub||[];S.top=cc.top||[];S.sl=cc.sl||[];S.fl=cc.fl||[];S.cfg=Object.assign({},DEF,cc.cfg||{});lastSig=JSON.stringify([S.sub,S.top])}
}catch(e){}
async function saveCfg(patch){
  Object.assign(S.cfg,patch);
  if(cfgBusy)return;cfgBusy=true;
  try{
    var o=await loadAll(),cur=o.cfg[0];
    await put("cfg",Object.assign({},cur||{},S.cfg),cur&&cur._id);
  }finally{cfgBusy=false}
  await refresh(true);
}

/* ---------------------------------------------------------------------
   KİÇİK KÖMƏKÇİLƏR
   --------------------------------------------------------------------- */
function toast(m,bad){
  var d=document.createElement("div");d.className="dqcr-toast"+(bad?" bad":"");d.textContent=m;document.body.appendChild(d);
  requestAnimationFrame(function(){d.classList.add("on")});
  setTimeout(function(){d.classList.remove("on");setTimeout(function(){d.remove()},400)},2600);
}
function openLink(l){
  l=String(l||"").trim();if(!l)return;
  try{
    if(/^(https?:|mailto:|tel:)/i.test(l)){window.open(l,"_blank","noopener");return}
    if(l==="tests"&&window.V3&&V3.showTests)return V3.showTests();
    if(l==="reg"&&window.LXP&&LXP.open)return LXP.open();
    if(l==="exam"&&window.DQ&&DQ.openCabinet)return DQ.openCabinet();
    if(/^[\w.-]+\.[a-z]{2,}/i.test(l))window.open("https://"+l,"_blank","noopener");
  }catch(e){}
}
function loadAns(){try{return JSON.parse(localStorage.getItem(ANS)||"{}")||{}}catch(e){return{}}}
function saveAns(m){try{localStorage.setItem(ANS,JSON.stringify(m))}catch(e){}}
function fkey(f,i){return String(f._id!=null?f._id:"p"+i)+":"+String(f.q||"").length}
function judge(f,val){
  if(f.type==="text"){
    var acc=(f.answers||[]).map(norm).filter(Boolean),u=norm(val);
    return{ok:!!u&&acc.indexOf(u)>-1,user:String(val||"").trim(),correct:(f.answers||[]).join(" / ")};
  }
  var k=+val;return{ok:k===+f.c,user:(f.opts&&f.opts[k]!=null)?LET[k]+") "+f.opts[k]:"",correct:(f.opts&&f.opts[f.c]!=null)?LET[f.c]+") "+f.opts[f.c]:""};
}

/* ---------------------------------------------------------------------
   STANDART KARUSEL (quiz + elan slaydları)
   --------------------------------------------------------------------- */
function slideHTML(s){
  var t=th(s.th),st="--g1:"+t[0]+";--g2:"+t[1]+";--ac:"+t[2];
  if(s.kind==="quiz"){
    return'<article class="dqcr-sl" style="'+st+'"><div class="dqcr-sl-in"><span class="dqcr-tag">❓ QUİZ</span><h3>'+esc(s.title)+'</h3>'
      +'<div class="dqcr-opts">'+(s.opts||[]).map(function(o,k){return'<button type="button" class="dqcr-op" data-k="'+k+'"><i>'+LET[k]+'</i><span>'+esc(o)+'</span></button>'}).join("")+'</div>'
      +'<div class="dqcr-sx" hidden></div></div></article>';
  }
  return'<article class="dqcr-sl" style="'+st+'"><div class="dqcr-sl-in"><div class="dqcr-ic" aria-hidden="true">'+esc(s.icon||"📢")+'</div><span class="dqcr-tag">'+esc(s.tag||"📢 ELAN")+'</span><h3>'+esc(s.title)+'</h3>'
    +(s.text?'<p>'+esc(s.text)+'</p>':'')+(s.link?'<button type="button" class="dqcr-go" data-link="'+esc(s.link)+'">'+esc(s.btn||"Ətraflı")+' →</button>':'')+'</div></article>';
}
function mountStd(host,list,auto){
  var n=list.length,cur=0,timer=0,dead=false,hold=false,vis=true,drag=0,pausedUntil=0,answered={};
  host.innerHTML='<div class="dqcr-s"><div class="dqcr-s-view"><div class="dqcr-s-track">'+list.map(slideHTML).join("")+'</div></div>'
    +(n>1?'<button type="button" class="dqcr-nav l" aria-label="Əvvəlki">‹</button><button type="button" class="dqcr-nav r" aria-label="Növbəti">›</button><div class="dqcr-dots"></div><div class="dqcr-bar" aria-hidden="true"><i></i></div>':'')+'</div>';
  var root=host.firstChild,view=root.querySelector(".dqcr-s-view"),track=root.querySelector(".dqcr-s-track"),
      els=[].slice.call(track.children),dots=root.querySelector(".dqcr-dots"),bar=root.querySelector(".dqcr-bar i");
  if(dots)els.forEach(function(_,k){var b=document.createElement("button");b.type="button";b.setAttribute("aria-label",(k+1)+". slayd");b.addEventListener("click",function(){go(k,true)});dots.appendChild(b)});
  function layout(anim){
    if(!els.length)return;
    var vw=view.clientWidth,sw=els[0].offsetWidth,gap=12,x=(vw-sw)/2-cur*(sw+gap)+drag;
    track.style.transition=anim===false?"none":"";track.style.transform="translate3d("+x+"px,0,0)";
    els.forEach(function(e,i){e.classList.toggle("on",i===cur)});
    if(dots)[].forEach.call(dots.children,function(d,i){d.setAttribute("aria-current",i===cur)});
  }
  function go(i,user){
    cur=((i%n)+n)%n;drag=0;layout();if(user)pausedUntil=Date.now()+9000;sync();
  }
  function sync(){
    clearInterval(timer);timer=0;if(bar){bar.style.transition="none";bar.style.width="0%"}
    if(RM||n<2||dead||hold||!vis||document.hidden||Date.now()<pausedUntil){if(Date.now()<pausedUntil&&!dead){clearTimeout(sync.t);sync.t=setTimeout(sync,pausedUntil-Date.now()+30)}return}
    if(bar){void bar.offsetWidth;bar.style.transition="width "+auto+"ms linear";bar.style.width="100%"}
    timer=setInterval(function(){if(!root.isConnected){destroy();return}go(cur+1)},auto);
  }
  function destroy(){dead=true;clearInterval(timer);try{io.disconnect();ro.disconnect()}catch(e){}document.removeEventListener("visibilitychange",sync)}
  var l=root.querySelector(".dqcr-nav.l"),r=root.querySelector(".dqcr-nav.r");
  if(l)l.addEventListener("click",function(){go(cur-1,true)});if(r)r.addEventListener("click",function(){go(cur+1,true)});
  root.addEventListener("mouseenter",function(){hold=true;sync()});root.addEventListener("mouseleave",function(){hold=false;sync()});
  /* sürüşdürmə */
  var sx=null,moved=false,pid=null;
  view.addEventListener("pointerdown",function(e){if(e.pointerType==="mouse"&&e.button!==0)return;sx=e.clientX;moved=false;pid=e.pointerId});
  view.addEventListener("pointermove",function(e){
    if(sx===null)return;var dx=e.clientX-sx;
    if(!moved&&Math.abs(dx)>9){moved=true;hold=true;try{view.setPointerCapture(pid)}catch(_){}}
    if(moved){drag=dx;layout(false)}
  });
  function up(e){
    if(sx===null)return;var dx=e.clientX-sx;sx=null;
    if(moved){hold=false;if(Math.abs(dx)>50)go(cur+(dx<0?1:-1),true);else{drag=0;layout();sync()}view.__mv=Date.now()}
  }
  view.addEventListener("pointerup",up);view.addEventListener("pointercancel",up);
  view.addEventListener("click",function(e){if(Date.now()-(view.__mv||0)<250){e.stopPropagation();e.preventDefault()}},true);
  /* düymələr */
  track.addEventListener("click",function(e){
    var g=e.target.closest(".dqcr-go");if(g){openLink(g.getAttribute("data-link"));return}
    var o=e.target.closest(".dqcr-op");if(!o)return;
    var sl=o.closest(".dqcr-sl"),i=els.indexOf(sl),q=list[i];if(!q||answered[i])return;
    var k=+o.getAttribute("data-k"),ok=k===+q.c;answered[i]=true;pausedUntil=Date.now()+14000;sync();
    sl.querySelectorAll(".dqcr-op").forEach(function(b,j){b.disabled=true;if(j===+q.c)b.classList.add("ok");else if(j===k)b.classList.add("no")});
    var ex=sl.querySelector(".dqcr-sx");ex.hidden=false;ex.className="dqcr-sx "+(ok?"ok":"no");
    ex.innerHTML=(ok?"✅ <b>Düzdür!</b>":"❌ <b>Səhvdir.</b> Düzgün cavab: <b>"+LET[q.c]+") "+esc(q.opts[q.c])+"</b>")+(q.e?'<div>💡 '+esc(q.e)+'</div>':'');
    if(!ok){sl.classList.remove("shk");void sl.offsetWidth;sl.classList.add("shk")}
  });
  var io=new IntersectionObserver(function(es){vis=es[es.length-1].isIntersecting;sync()},{threshold:.2});io.observe(root);
  var ro=new ResizeObserver(function(){layout(false)});ro.observe(view);
  document.addEventListener("visibilitychange",sync);
  layout(false);requestAnimationFrame(function(){layout(false);sync()});
  return{destroy:destroy,go:go};
}

/* ---------------------------------------------------------------------
   ⚡ GÜNÜN SUALI — FLEŞKART KARUSELİ
   --------------------------------------------------------------------- */
var CONF=["#fbbf24","#34d399","#60a5fa","#f472b6","#a78bfa","#f87171"];
function mountFlash(host,list,opt){
  opt=opt||{};
  var n=list.length,cur=0,dead=false,hold=false,vis=true,last=Date.now(),timer=0,ans=opt.preview?{}:loadAns(),st=[];
  list.forEach(function(f,i){var a=ans[fkey(f,i)];st[i]=a?{done:true,val:a.val,ok:!!a.ok,peek:!!a.peek}:{done:false}});
  host.innerHTML='<section class="dqcr-f" aria-label="Günün sualı">'
    +'<div class="dqcr-f-bg" aria-hidden="true"><i class="a"></i><i class="b"></i><i class="c"></i>'+spark()+'</div>'
    +'<div class="dqcr-f-hd"><span class="dqcr-f-pill">⚡ HƏR GÜN YENİ SUAL</span><h2>Günün sualı</h2><p>Kartı çevir — cavabını yoxla!</p><div class="dqcr-f-sc" aria-live="polite"></div></div>'
    +'<div class="dqcr-f-wrap"><div class="dqcr-f-stage">'+list.map(function(f,i){return cardHTML(f,i,n)}).join("")+'</div></div>'
    +(n>1?'<div class="dqcr-f-ct"><button type="button" class="dqcr-fn l" aria-label="Əvvəlki sual">‹</button><div class="dqcr-fd"></div><button type="button" class="dqcr-fn r" aria-label="Növbəti sual">›</button></div>':'')
    +'</section>';
  var root=host.firstChild,stage=root.querySelector(".dqcr-f-stage"),cards=[].slice.call(stage.children),dots=root.querySelector(".dqcr-fd"),sc=root.querySelector(".dqcr-f-sc");
  if(dots)cards.forEach(function(_,k){var b=document.createElement("button");b.type="button";b.setAttribute("aria-label",(k+1)+". sual");b.addEventListener("click",function(){go(k,true)});dots.appendChild(b)});

  function spark(){var s="";for(var i=0;i<14;i++)s+='<u style="left:'+Math.round(Math.random()*100)+'%;top:'+Math.round(Math.random()*100)+'%;animation-delay:'+(Math.random()*4).toFixed(2)+'s;--s:'+(0.5+Math.random()).toFixed(2)+'"></u>';return s}
  function cardHTML(f,i,total){
    var t=th(f.th),sty="--g1:"+t[0]+";--g2:"+t[1]+";--ac:"+t[2];
    var front='<div class="dqcr-ff fr"><div class="dqcr-fh"><span class="dqcr-fb">⚡ GÜNÜN SUALI</span><span class="dqcr-fno">'+(i+1)+' / '+total+'</span></div>'
      +'<div class="dqcr-fq"><div>'+esc(f.q)+'</div></div>'
      +(f.type==="text"
        ?'<div class="dqcr-fin"><input type="text" class="dqcr-ti" placeholder="Cavabınızı bura yazın…" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" aria-label="Cavab"><button type="button" class="dqcr-sub">Cavabla ➜</button></div>'
        :'<div class="dqcr-fo-w">'+(f.opts||[]).map(function(o,k){return'<button type="button" class="dqcr-fo" data-k="'+k+'"><i>'+LET[k]+'</i><span>'+esc(o)+'</span></button>'}).join("")+'</div>')
      +'<button type="button" class="dqcr-peek">👁 Cavaba bax</button></div>';
    return'<article class="dqcr-fc" style="'+sty+'"><div class="dqcr-shk"><div class="dqcr-fi">'+front+'<div class="dqcr-ff bk"></div></div></div></article>';
  }
  function fillBack(i){
    var f=list[i],s=st[i],j=judge(f,s.val),bk=cards[i].querySelector(".bk"),h;
    if(s.peek){
      h='<div class="dqcr-vd pk"><span>👁</span><b>Düzgün cavab</b></div><div class="dqcr-row c"><small>Düzgün cavab</small><b>'+esc(j.correct)+'</b></div>';
    }else{
      h='<div class="dqcr-vd '+(s.ok?"ok":"no")+'"><span>'+(s.ok?"🎉":"😕")+'</span><b>'+(s.ok?"Əla! Düzdür":"Səhvdir")+'</b></div>'
       +'<div class="dqcr-row u '+(s.ok?"ok":"no")+'"><small>Sizin cavab</small><b>'+(esc(j.user)||"—")+'</b></div>'
       +(s.ok?'':'<div class="dqcr-row c"><small>Düzgün cavab</small><b>'+esc(j.correct)+'</b></div>');
    }
    if(f.e)h+='<div class="dqcr-ex2">💡 '+esc(f.e)+'</div>';
    h+='<div class="dqcr-fa"><button type="button" class="dqcr-rs">↻ Yenidən</button>'+(n>1?'<button type="button" class="dqcr-nx">Növbəti sual ➜</button>':'')+'</div>';
    bk.innerHTML=h;
  }
  function paintCard(i){
    var c=cards[i],s=st[i];c.classList.toggle("fl",!!s.done);
    c.classList.toggle("won",!!(s.done&&s.ok&&!s.peek));c.classList.toggle("lost",!!(s.done&&!s.ok&&!s.peek));
    var fr=c.querySelector(".fr"),bk=c.querySelector(".bk");fr.setAttribute("aria-hidden",!!s.done);bk.setAttribute("aria-hidden",!s.done);
    fr.querySelectorAll("button,input").forEach(function(x){x.tabIndex=s.done?-1:0});
  }
  function score(){
    var d=0,ok=0;st.forEach(function(s){if(s.done&&!s.peek){d++;if(s.ok)ok++}});
    sc.innerHTML=d?'<span>✅ '+ok+' düz</span><span>❌ '+(d-ok)+' səhv</span><span>📌 '+d+' / '+n+'</span>':'';
  }
  function persist(){
    if(opt.preview)return;var m=loadAns();
    list.forEach(function(f,i){var k=fkey(f,i);if(st[i].done)m[k]={val:st[i].val,ok:st[i].ok,peek:st[i].peek};else delete m[k]});saveAns(m);
  }
  function layout(){
    var h=Math.floor(n/2),cw=cards[0]?cards[0].offsetWidth:320;
    cards.forEach(function(c,i){
      var off=i-cur;if(off>h)off-=n;if(off<-h)off+=n;var a=Math.abs(off);
      c.style.transform="translate(-50%,-50%) translateX("+(off*cw*.62)+"px) translateZ("+(-a*170)+"px) rotateY("+(-off*30)+"deg) scale("+(1-a*.1)+")";
      c.style.zIndex=String(30-a);c.style.opacity=a>1?"0":"1";c.style.pointerEvents=a>1?"none":"";
      c.style.filter=a?"brightness("+(1-a*.32)+") saturate(.8)":"none";c.classList.toggle("on",off===0);c.setAttribute("aria-hidden",off!==0);
    });
    if(dots)[].forEach.call(dots.children,function(d,k){d.setAttribute("aria-current",k===cur)});
  }
  function go(i,user){cur=((i%n)+n)%n;if(user)last=Date.now();layout()}
  function burst(c){
    if(RM)return;var b=document.createElement("div");b.className="dqcr-burst";
    for(var k=0;k<30;k++){var p=document.createElement("i"),a=Math.random()*Math.PI*2,d=80+Math.random()*130;
      p.style.cssText="--dx:"+(Math.cos(a)*d).toFixed(0)+"px;--dy:"+(Math.sin(a)*d-50).toFixed(0)+"px;--r:"+Math.round(Math.random()*720-360)+"deg;--c:"+CONF[k%CONF.length]+";animation-delay:"+(Math.random()*.18).toFixed(2)+"s";b.appendChild(p)}
    c.appendChild(b);setTimeout(function(){b.remove()},1800);
  }
  function answer(i,val,btn){
    var s=st[i];if(s.done)return;last=Date.now();
    var j=judge(list[i],val);
    if(btn)btn.classList.add("sel");
    setTimeout(function(){
      if(dead)return;
      st[i]={done:true,val:val,ok:j.ok,peek:false};fillBack(i);persist();paintCard(i);score();
      var c=cards[i];
      if(j.ok)setTimeout(function(){burst(c)},520);
      else if(!RM){setTimeout(function(){var w=c.querySelector(".dqcr-shk");w.classList.remove("shake");void w.offsetWidth;w.classList.add("shake")},560)}
    },btn?180:0);
  }
  function peek(i){var s=st[i];if(s.done)return;last=Date.now();st[i]={done:true,val:"",ok:false,peek:true};fillBack(i);persist();paintCard(i);score()}
  function reset(i){st[i]={done:false};persist();paintCard(i);score();var c=cards[i],inp=c.querySelector(".dqcr-ti");if(inp)inp.value="";c.querySelectorAll(".dqcr-fo.sel").forEach(function(b){b.classList.remove("sel")})}

  stage.addEventListener("click",function(e){
    var c=e.target.closest(".dqcr-fc");if(!c)return;var i=cards.indexOf(c);
    if(Date.now()-(stage.__mv||0)<250)return;
    if(i!==cur){go(i,true);return}
    var b;
    if((b=e.target.closest(".dqcr-fo")))answer(i,+b.getAttribute("data-k"),b);
    else if(e.target.closest(".dqcr-sub")){var inp=c.querySelector(".dqcr-ti");if(!inp.value.trim()){inp.focus();inp.classList.remove("nope");void inp.offsetWidth;inp.classList.add("nope");return}answer(i,inp.value,null)}
    else if(e.target.closest(".dqcr-peek"))peek(i);
    else if(e.target.closest(".dqcr-rs"))reset(i);
    else if(e.target.closest(".dqcr-nx"))go(cur+1,true);
  });
  stage.addEventListener("keydown",function(e){
    if(e.key==="Enter"&&e.target.classList.contains("dqcr-ti")){e.preventDefault();var c=e.target.closest(".dqcr-fc"),i=cards.indexOf(c);if(!e.target.value.trim()){e.target.classList.remove("nope");void e.target.offsetWidth;e.target.classList.add("nope");return}answer(i,e.target.value,null)}
    else if(e.key==="ArrowRight"&&!e.target.classList.contains("dqcr-ti")){go(cur+1,true)}
    else if(e.key==="ArrowLeft"&&!e.target.classList.contains("dqcr-ti")){go(cur-1,true)}
  });
  stage.addEventListener("input",function(){last=Date.now()});
  var l=root.querySelector(".dqcr-fn.l"),r=root.querySelector(".dqcr-fn.r");
  if(l)l.addEventListener("click",function(){go(cur-1,true)});if(r)r.addEventListener("click",function(){go(cur+1,true)});
  /* sürüşdürmə */
  var sx=null,moved=false;
  stage.addEventListener("pointerdown",function(e){if(e.pointerType==="mouse"&&e.button!==0)return;if(e.target.closest("input,textarea"))return;sx=e.clientX;moved=false});
  stage.addEventListener("pointermove",function(e){if(sx!==null&&Math.abs(e.clientX-sx)>12)moved=true});
  function up(e){if(sx===null)return;var dx=e.clientX-sx;sx=null;if(moved&&Math.abs(dx)>45&&n>1){go(cur+(dx<0?1:-1),true);stage.__mv=Date.now()}}
  stage.addEventListener("pointerup",up);stage.addEventListener("pointercancel",function(){sx=null});
  root.addEventListener("mouseenter",function(){hold=true});root.addEventListener("mouseleave",function(){hold=false});
  /* boş vaxtda avtomatik keçid */
  function tick(){
    if(!root.isConnected){destroy();return}
    if(RM||n<2||hold||!vis||document.hidden||Date.now()-last<11000)return;
    if(st.some(function(s){return s.done})&&st[cur].done)return;
    if(root.contains(document.activeElement)&&document.activeElement.tagName==="INPUT")return;
    go(cur+1);
  }
  timer=setInterval(tick,3000);
  function destroy(){dead=true;clearInterval(timer);try{io.disconnect();ro.disconnect()}catch(e){}}
  var io=new IntersectionObserver(function(es){vis=es[es.length-1].isIntersecting},{threshold:.15});io.observe(root);
  var ro=new ResizeObserver(function(){layout()});ro.observe(stage);
  list.forEach(function(_,i){if(st[i].done)fillBack(i);paintCard(i)});score();layout();requestAnimationFrame(layout);
  return{destroy:destroy,go:go};
}

/* ---------------------------------------------------------------------
   ANA SƏHİFƏ
   --------------------------------------------------------------------- */
var Home={
  box:null,sSig:"",fSig:"",sCtl:null,fCtl:null,obs:null,t:0,
  ensure:function(){
    if(this.box)return this.box;
    var b=document.createElement("div");b.id="dqcr-home";b.className="dqcr-host";
    b.innerHTML='<div id="dqcr-fl-h"></div><div id="dqcr-std-h"></div>';this.box=b;return b;
  },
  place:function(){
    var h=$("v3-home"),b=this.box;if(!h||!b)return;
    if(S.cfg.pos==="bottom"){if(b.parentNode!==h||b.nextElementSibling)h.appendChild(b);return}
    var grid=$("dt-grid"),ban=$("lxp-ban"),ref=(ban&&ban.parentNode===h)?ban:(grid&&grid.parentNode===h?grid:null);
    if(!ref){if(b.parentNode!==h)h.insertBefore(b,h.firstChild);return}
    if(b.parentNode!==h||b.nextElementSibling!==ref)h.insertBefore(b,ref);
  },
  update:function(){
    var h=$("v3-home");if(!h)return;
    var sl=S.sl.filter(isOn),fl=S.fl.filter(isOn),wantS=!!S.cfg.std&&sl.length>0,wantF=!!S.cfg.flash&&fl.length>0;
    if(!wantS&&!wantF){if(this.box){this.kill("s");this.kill("f");this.box.remove();this.box=null}return}
    var b=this.ensure(),sh=b.querySelector("#dqcr-std-h"),fh=b.querySelector("#dqcr-fl-h");
    var ss=wantS?JSON.stringify([sl,S.cfg.auto]):"",fs=wantF?JSON.stringify(fl):"";
    if(!wantS){this.kill("s");sh.innerHTML=""}else if(ss!==this.sSig||!this.sCtl){this.kill("s");this.sCtl=mountStd(sh,sl,+S.cfg.auto||6000)}
    if(!wantF){this.kill("f");fh.innerHTML=""}else if(fs!==this.fSig||!this.fCtl){this.kill("f");this.fCtl=mountFlash(fh,fl)}
    this.sSig=ss;this.fSig=fs;this.place();
    if(!this.obs){
      var me=this;this.obs=new MutationObserver(function(){clearTimeout(me.t);me.t=setTimeout(function(){if(me.box)me.place()},120)});
      this.obs.observe(h,{childList:true});
    }
  },
  kill:function(w){var c=w==="s"?this.sCtl:this.fCtl;if(c)try{c.destroy()}catch(e){}if(w==="s")this.sCtl=null;else this.fCtl=null}
};

/* ---------------------------------------------------------------------
   SUAL PARSERİ  (yapışdırılan mətn → sual massivi)
   --------------------------------------------------------------------- */
function parseQs(txt){
  var qs=[],bad=0;
  String(txt||"").replace(/\r/g,"").split(/\n\s*\n+/).forEach(function(b){
    b=b.trim();if(!b)return;
    var lines=b.split("\n").map(function(s){return s.trim()}).filter(Boolean),q=[],o=[],ans=-1,ex="",inEx=false;
    lines.forEach(function(l){
      var m;
      if((m=/^(?:cavab|düzgün(?:\s+cavab)?|duzgun|answer|ans|correct)\s*[:=\-]\s*([A-Fa-f1-6])\b/i.exec(l))){ans=/\d/.test(m[1])?+m[1]-1:LET.indexOf(m[1].toUpperCase());inEx=false;return}
      if((m=/^(?:izah|şərh|serh|izahat|explanation|note)\s*[:=\-]\s*(.*)$/i.exec(l))){ex=m[1];inEx=true;return}
      if((m=/^([*✓✔]\s*)?([A-Fa-f])\s*[).:\-]\s+(.+?)(\s*[✓✔*])?$/.exec(l))&&LET.indexOf(m[2].toUpperCase())===o.length){
        o.push(m[3].trim());inEx=false;if(m[1]||m[4])ans=o.length-1;return}
      if(inEx){ex+="\n"+l;return}
      if(!o.length)q.push(l);else o[o.length-1]+=" "+l;
    });
    if(q.length)q[0]=q[0].replace(/^\s*\d+\s*[.)\-]\s*/,"");
    var qt=q.join("\n").trim();
    if(qt&&o.length>=2&&ans>=0&&ans<o.length)qs.push({t:qt,o:o,c:ans,e:ex.trim()});else bad++;
  });
  return{qs:qs,bad:bad};
}
function qsToText(qs){
  return(qs||[]).map(function(q,i){
    return(i+1)+". "+q.t+"\n"+q.o.map(function(o,k){return LET[k]+") "+o}).join("\n")+"\nCavab: "+LET[q.c]+(q.e?"\nİzah: "+q.e:"");
  }).join("\n\n");
}

/* ---------------------------------------------------------------------
   ADMİN PANELİ
   --------------------------------------------------------------------- */
var A={tab:"sl",ed:{top:null,sub:null,sl:null,fl:null},th:{sub:0,sl:0,fl:0},busy:false,root:null,pv:null};
var TABS=[["sl","🏠 Ana səhifə karuseli"],["fl","⚡ Günün sualı"]];
function g(id){var e=$(id);return e?e.value:""}
function fld(label,html,hint){return'<label class="dqcr-fl"><span>'+label+'</span>'+html+(hint?'<small>'+hint+'</small>':'')+'</label>'}
function sw(on,act,id,label){return'<label class="dqcr-sw"><input type="checkbox" data-a="'+act+'" data-id="'+esc(id||"")+'"'+(on?" checked":"")+'><i></i>'+(label?'<em>'+label+'</em>':'')+'</label>'}
function swatches(k){
  return'<div class="dqcr-pal" role="radiogroup">'+PAL.map(function(p,i){return'<button type="button" data-a="pal" data-k="'+k+'" data-i="'+i+'" class="'+(A.th[k]===i?"on":"")+'" style="background:linear-gradient(135deg,'+p[0]+','+p[1]+')" aria-label="Rəng '+(i+1)+'"></button>'}).join("")+'</div>';
}
function allSubjectNames(){
  var n=[];((window.TLX&&TLX.subjects)||[]).forEach(function(s){n.push(s.name)});
  S.sub.forEach(function(s){if(n.indexOf(s.name)<0)n.push(s.name)});S.top.forEach(function(t){if(n.indexOf(t.subject)<0)n.push(t.subject)});return n;
}
function allTopicNames(){
  var n=[];((window.TLX&&TLX.subjects)||[]).forEach(function(s){(s.topics||[]).forEach(function(t){if(n.indexOf(t.name)<0)n.push(t.name)})});
  S.top.forEach(function(t){if(n.indexOf(t.name)<0)n.push(t.name)});return n;
}
function head(){
  return'<div class="dqcr-ah"><div><b>🏠 Ana səhifə karuseli</b><small>'+(A.cloud?"☁️ Mərkəzi baza":"📱 Yalnız bu cihaz (Supabase cədvəli yoxdur)")+'</small></div><button type="button" class="dqcr-x" data-a="close" aria-label="Bağla">✕</button></div>'
    +'<div class="dqcr-tabs">'+TABS.map(function(t){return'<button type="button" data-a="tab" data-v="'+t[0]+'" class="'+(A.tab===t[0]?"on":"")+'">'+t[1]+'</button>'}).join("")+'</div>';
}
function draw(){
  if(!A.root)return;
  var body=A.tab==="top"?vTop():A.tab==="sub"?vSub():A.tab==="sl"?vSl():vFl();
  var sc=A.root.querySelector(".dqcr-ab"),y=sc?sc.scrollTop:0;
  A.root.querySelector(".dqcr-ap").innerHTML=head()+'<div class="dqcr-ab">'+body+'</div>';
  var nb=A.root.querySelector(".dqcr-ab");if(nb)nb.scrollTop=y;
  if(A.tab==="top")qCount();
  syncCorrect("sl");syncCorrect("fl");toggleType();
}

/* --- Mövzular --- */
function vTop(){
  var e=A.ed.top||{},isE=!!A.ed.top;
  var h='<div class="dqcr-card"><h4>'+(isE?"✏️ Mövzunu redaktə et":"➕ Mövzu əlavə et")+'</h4>'
   +'<datalist id="dqcr-dl-s">'+allSubjectNames().map(function(n){return'<option value="'+esc(n)+'">'}).join("")+'</datalist>'
   +'<datalist id="dqcr-dl-t">'+allTopicNames().map(function(n){return'<option value="'+esc(n)+'">'}).join("")+'</datalist>'
   +fld("Fənn","<input id=\"dqcr-t-sub\" list=\"dqcr-dl-s\" class=\"dqcr-in\" placeholder=\"Fənni seçin və ya yeni ad yazın\" value=\""+esc(e.subject||"")+"\">","Yeni fənn adı yazsanız, avtomatik yeni karusel kartı yaranır.")
   +fld("Mövzu adı","<input id=\"dqcr-t-name\" list=\"dqcr-dl-t\" class=\"dqcr-in\" placeholder=\"Məs: Cinayət hüququ\" value=\""+esc(e.name||"")+"\">","Mövcud mövzunun adını yazsanız, suallar ona əlavə olunur.")
   +'<div class="dqcr-two">'+fld("Sual sayı (plan)","<input id=\"dqcr-t-cnt\" type=\"number\" min=\"0\" class=\"dqcr-in\" placeholder=\"40\" value=\""+esc(e.count||"")+"\">","Sual əlavə edilənədək kartda görünür.")
   +fld("Müddət (dəq)","<input id=\"dqcr-t-time\" type=\"number\" min=\"0\" class=\"dqcr-in\" placeholder=\"avto\" value=\""+esc(e.time||"")+"\">")+'</div>'
   +fld("Suallar (yapışdırın)","<textarea id=\"dqcr-t-qs\" class=\"dqcr-in\" rows=\"9\" placeholder=\"1. Sual mətni?\nA) Variant 1\nB) Variant 2\nC) Variant 3\nD) Variant 4\nCavab: B\nİzah: ixtiyari\n\n2. Növbəti sual...\">"+esc(qsToText(e.qs))+"</textarea>","Suallar arasında boş sətir buraxın. «Cavab: B» sətri məcburidir, «İzah:» ixtiyaridir.")
   +'<div class="dqcr-cnt" id="dqcr-t-c"></div>'
   +'<div class="dqcr-row2"><button type="button" class="dqcr-b g" data-a="save-top">💾 '+(isE?"Yadda saxla":"Mövzunu əlavə et")+'</button>'+(isE?'<button type="button" class="dqcr-b" data-a="cancel" data-v="top">Ləğv et</button>':'')+'</div></div>';
  var by={};S.top.forEach(function(t){(by[t.subject]=by[t.subject]||[]).push(t)});
  var keys=Object.keys(by);
  h+='<div class="dqcr-card"><h4>📋 Əlavə etdiyiniz mövzular <span class="dqcr-c">'+S.top.length+'</span></h4>';
  if(!keys.length)h+='<p class="dqcr-mt">Hələ mövzu əlavə edilməyib. Daxili mövzular (məs. Məntiq, Qanunvericilik) olduğu kimi qalır.</p>';
  keys.forEach(function(k){
    h+='<div class="dqcr-grp"><b>'+esc(k)+'</b>'+by[k].map(function(t){
      return'<div class="dqcr-it'+(t.hidden?" off":"")+'"><div class="dqcr-itx"><b>'+esc(t.name)+'</b><small>'+((t.qs||[]).length||(+t.count||0))+' sual'+((t.qs||[]).length?"":" (plan)")+(t.time?" • "+t.time+" dəq":"")+(t.hidden?" • gizli":"")+'</small></div>'
       +'<div class="dqcr-ia"><button type="button" data-a="edit-top" data-id="'+esc(t._id)+'" aria-label="Redaktə">✏️</button><button type="button" data-a="vis-top" data-id="'+esc(t._id)+'" aria-label="Göstər / gizlət">'+(t.hidden?"🙈":"👁")+'</button><button type="button" data-a="del-top" data-id="'+esc(t._id)+'" aria-label="Sil">🗑</button></div></div>'}).join("")+'</div>';
  });
  return h+'</div>';
}
function qCount(){
  var el=$("dqcr-t-c"),ta=$("dqcr-t-qs");if(!el||!ta)return;
  var r=parseQs(ta.value),has=ta.value.trim().length;
  el.innerHTML=has?('✅ '+r.qs.length+' sual tanındı'+(r.bad?' • <span class="bad">⚠️ '+r.bad+' blok yanlış formatdadır (buraxılacaq)</span>':'')):'<span class="dqcr-mt">Sual yapışdırmasanız, mövzu «hazırlanır» kimi görünəcək.</span>';
}
async function saveTop(){
  var sub=g("dqcr-t-sub").trim(),name=g("dqcr-t-name").trim();
  if(!sub||!name)return toast("Fənn və mövzu adını yazın",true);
  var r=parseQs(g("dqcr-t-qs")),old=A.ed.top;
  if(g("dqcr-t-qs").trim()&&!r.qs.length)return toast("Suallar tanınmadı — formatı yoxlayın",true);
  var o={subject:sub,name:name,count:+g("dqcr-t-cnt")||0,time:+g("dqcr-t-time")||0,qs:r.qs,hidden:old?!!old.hidden:false,ord:old&&old.ord!=null?old.ord:Date.now()};
  await put("top",o,old&&old._id);A.ed.top=null;toast("Mövzu saxlanıldı ✅"+(r.bad?" ("+r.bad+" blok buraxıldı)":""));
}

/* --- Fənnlər --- */
function vSub(){
  var e=A.ed.sub||{},isE=!!A.ed.sub;
  var h='<div class="dqcr-card"><h4>'+(isE?"✏️ Fənni redaktə et":"➕ Fənn əlavə et")+'</h4>'
   +'<div class="dqcr-two">'+fld("Fənnin adı","<input id=\"dqcr-s-name\" class=\"dqcr-in\" placeholder=\"Məs: Tarix\" value=\""+esc(e.name||"")+"\">")+fld("Emoji","<input id=\"dqcr-s-ico\" class=\"dqcr-in\" maxlength=\"4\" placeholder=\"📚\" value=\""+esc(e.icon||"📚")+"\">")+'</div>'
   +'<div class="dqcr-fl"><span>Rəng</span>'+swatches("sub")+'</div>'
   +'<p class="dqcr-mt">Fənn əlavə etdikdən sonra «📚 Mövzular» bölməsində ona mövzu əlavə edin — karusel kartı mövzu əlavə olunanda görünür.</p>'
   +'<div class="dqcr-row2"><button type="button" class="dqcr-b g" data-a="save-sub">💾 '+(isE?"Yadda saxla":"Fənni əlavə et")+'</button>'+(isE?'<button type="button" class="dqcr-b" data-a="cancel" data-v="sub">Ləğv et</button>':'')+'</div></div>';
  h+='<div class="dqcr-card"><h4>🗂️ Əlavə etdiyiniz fənnlər <span class="dqcr-c">'+S.sub.length+'</span></h4>';
  if(!S.sub.length)h+='<p class="dqcr-mt">Hələ fənn əlavə edilməyib. Daxili fənlər: '+esc(((window.TLX&&TLX.subjects)||[]).map(function(s){return s.name}).join(", "))+'.</p>';
  S.sub.forEach(function(s){
    var cnt=S.top.filter(function(t){return t.subject===s.name&&!t.hidden}).length,p=[s.c1||PAL[0][0],s.c2||PAL[0][1]];
    h+='<div class="dqcr-it'+(s.hidden?" off":"")+'"><span class="dqcr-sb" style="background:linear-gradient(135deg,'+esc(p[0])+','+esc(p[1])+')">'+esc(s.icon||"📚")+'</span><div class="dqcr-itx"><b>'+esc(s.name)+'</b><small>'+cnt+' mövzu'+(cnt?"":" • mövzu yoxdur, karuselde görünmür")+(s.hidden?" • gizli":"")+'</small></div>'
     +'<div class="dqcr-ia"><button type="button" data-a="edit-sub" data-id="'+esc(s._id)+'">✏️</button><button type="button" data-a="vis-sub" data-id="'+esc(s._id)+'">'+(s.hidden?"🙈":"👁")+'</button><button type="button" data-a="del-sub" data-id="'+esc(s._id)+'">🗑</button></div></div>';
  });
  return h+'</div>';
}
async function saveSub(){
  var name=g("dqcr-s-name").trim();if(!name)return toast("Fənnin adını yazın",true);
  var old=A.ed.sub,p=th(A.th.sub);
  await put("sub",{name:name,icon:g("dqcr-s-ico").trim()||"📚",c1:p[0],c2:p[1],acc:p[2],hidden:old?!!old.hidden:false,ord:old&&old.ord!=null?old.ord:Date.now()},old&&old._id);
  A.ed.sub=null;toast("Fənn saxlanıldı ✅");
}

/* --- Ana səhifə karuseli --- */
function vSl(){
  var e=A.ed.sl||{},isE=!!A.ed.sl,kind=e.kind||"quiz";
  var h='<div class="dqcr-card dqcr-master"><div><b>Standart karusel</b><small>'+(S.cfg.std?"Ana səhifədə göstərilir":"Deaktivdir")+'</small></div>'+sw(S.cfg.std,"cfg-std","", "")+'</div>'
   +'<div class="dqcr-card"><div class="dqcr-two">'
   +fld("Yerləşmə","<select class=\"dqcr-in\" data-a=\"cfg-pos\"><option value=\"top\""+(S.cfg.pos!=="bottom"?" selected":"")+">Ana səhifənin yuxarısı</option><option value=\"bottom\""+(S.cfg.pos==="bottom"?" selected":"")+">Ana səhifənin aşağısı</option></select>")
   +fld("Avtomatik keçid","<select class=\"dqcr-in\" data-a=\"cfg-auto\">"+[4000,6000,8000,12000].map(function(v){return'<option value="'+v+'"'+(+S.cfg.auto===v?" selected":"")+'>'+(v/1000)+' saniyə</option>'}).join("")+"</select>")+'</div></div>';
  h+='<div class="dqcr-card"><h4>'+(isE?"✏️ Slaydı redaktə et":"➕ Slayd əlavə et")+'</h4>'
   +fld("Növ","<select id=\"dqcr-l-kind\" class=\"dqcr-in\" data-a=\"type-ch\"><option value=\"quiz\""+(kind==="quiz"?" selected":"")+">❓ Quiz sualı (variantlı)</option><option value=\"info\""+(kind==="info"?" selected":"")+">📢 Elan / məlumat</option></select>")
   +fld("Sual / Başlıq","<textarea id=\"dqcr-l-title\" class=\"dqcr-in\" rows=\"2\" placeholder=\"Sual və ya elan başlığı\">"+esc(e.title||"")+"</textarea>")
   +'<div class="dqcr-grp2" data-for="quiz">'
   +fld("Variantlar (hər sətirdə biri)","<textarea id=\"dqcr-l-opts\" class=\"dqcr-in\" rows=\"4\" data-a=\"opts-in\" data-p=\"sl\" placeholder=\"Bakı\nGəncə\nŞəki\">"+esc((e.opts||[]).join("\n"))+"</textarea>")
   +fld("Düzgün cavab","<select id=\"dqcr-l-c\" class=\"dqcr-in\" data-v=\""+(e.c!=null?e.c:0)+"\"></select>")
   +fld("İzah (ixtiyari)","<input id=\"dqcr-l-ex\" class=\"dqcr-in\" placeholder=\"Cavabdan sonra göstərilir\" value=\""+esc(e.e||"")+"\">")+'</div>'
   +'<div class="dqcr-grp2" data-for="info">'
   +fld("Mətn (ixtiyari)","<textarea id=\"dqcr-l-text\" class=\"dqcr-in\" rows=\"3\" placeholder=\"Qısa izahat\">"+esc(e.text||"")+"</textarea>")
   +'<div class="dqcr-two">'+fld("Emoji","<input id=\"dqcr-l-ico\" class=\"dqcr-in\" maxlength=\"4\" placeholder=\"📢\" value=\""+esc(e.icon||"")+"\">")+fld("Düymə yazısı","<input id=\"dqcr-l-btn\" class=\"dqcr-in\" placeholder=\"Ətraflı\" value=\""+esc(e.btn||"")+"\">")+'</div>'
   +fld("Düymə linki","<input id=\"dqcr-l-link\" class=\"dqcr-in\" placeholder=\"https://…  və ya:  tests / reg / exam\" value=\""+esc(e.link||"")+"\">","tests — Testlər, reg — Qeydiyyat, exam — Kabinet")+'</div>'
   +'<div class="dqcr-fl"><span>Rəng</span>'+swatches("sl")+'</div>'
   +'<div class="dqcr-row2"><button type="button" class="dqcr-b g" data-a="save-sl">💾 '+(isE?"Yadda saxla":"Slaydı əlavə et")+'</button>'+(isE?'<button type="button" class="dqcr-b" data-a="cancel" data-v="sl">Ləğv et</button>':'')+'</div></div>';
  h+='<div class="dqcr-card"><h4>🎞️ Slaydlar <span class="dqcr-c">'+S.sl.length+'</span><button type="button" class="dqcr-mini" data-a="pv-sl">👁 Önizləmə</button></h4>';
  if(!S.sl.length)h+='<p class="dqcr-mt">Hələ slayd yoxdur.</p>';
  S.sl.forEach(function(s,i){
    h+='<div class="dqcr-it'+(s.on===false?" off":"")+'"><span class="dqcr-sb" style="background:linear-gradient(135deg,'+th(s.th)[0]+','+th(s.th)[1]+')">'+(s.kind==="quiz"?"❓":esc(s.icon||"📢"))+'</span><div class="dqcr-itx"><b>'+esc(String(s.title).slice(0,70))+'</b><small>'+(s.kind==="quiz"?"Quiz • "+(s.opts||[]).length+" variant":"Elan")+'</small></div>'
     +'<div class="dqcr-ia"><button type="button" data-a="up-sl" data-id="'+esc(s._id)+'"'+(i===0?" disabled":"")+'>↑</button><button type="button" data-a="dn-sl" data-id="'+esc(s._id)+'"'+(i===S.sl.length-1?" disabled":"")+'>↓</button>'
     +'<button type="button" data-a="edit-sl" data-id="'+esc(s._id)+'">✏️</button><button type="button" data-a="del-sl" data-id="'+esc(s._id)+'">🗑</button>'+sw(s.on!==false,"tg-sl",s._id,"")+'</div></div>';
  });
  return h+'</div>';
}
async function saveSl(){
  var kind=g("dqcr-l-kind"),title=g("dqcr-l-title").trim(),old=A.ed.sl;
  if(!title)return toast("Sual / başlıq yazın",true);
  var o={kind:kind,title:title,th:A.th.sl,on:old?old.on!==false:true,ord:old&&old.ord!=null?old.ord:Date.now()};
  if(kind==="quiz"){
    var opts=g("dqcr-l-opts").split("\n").map(function(s){return s.trim()}).filter(Boolean);
    if(opts.length<2)return toast("Ən azı 2 variant yazın",true);if(opts.length>6)return toast("Ən çox 6 variant ola bilər",true);
    o.opts=opts;o.c=Math.min(+g("dqcr-l-c")||0,opts.length-1);o.e=g("dqcr-l-ex").trim();
  }else{o.text=g("dqcr-l-text").trim();o.icon=g("dqcr-l-ico").trim();o.btn=g("dqcr-l-btn").trim();o.link=g("dqcr-l-link").trim()}
  await put("sl",o,old&&old._id);A.ed.sl=null;toast("Slayd saxlanıldı ✅");
}

/* --- Günün sualı --- */
function vFl(){
  var e=A.ed.fl||{},isE=!!A.ed.fl,type=e.type||"choice",active=S.cfg.flash;
  var h='<div class="dqcr-card dqcr-hero'+(active?" on":"")+'"><div><b>⚡ Güclü fleşkart karusel</b><small>'+(active?"Ana səhifədə AKTİVDİR — "+S.fl.filter(isOn).length+" sual göstərilir":"Deaktivdir. Aktivləşdirmək üçün düyməyə basın.")+'</small></div>'
   +'<button type="button" class="dqcr-b '+(active?"r":"g")+'" data-a="cfg-flash">'+(active?"⏹ Deaktiv et":"🚀 Ana səhifədə aktivləşdir")+'</button></div>';
  h+='<div class="dqcr-card"><h4>'+(isE?"✏️ Sualı redaktə et":"➕ Günün sualı paylaş")+'</h4>'
   +fld("Sual","<textarea id=\"dqcr-f-q\" class=\"dqcr-in\" rows=\"3\" placeholder=\"Sual mətni…\">"+esc(e.q||"")+"</textarea>")
   +fld("Cavab növü","<select id=\"dqcr-f-type\" class=\"dqcr-in\" data-a=\"type-ch\"><option value=\"choice\""+(type==="choice"?" selected":"")+">🔘 Variantlardan seçmə</option><option value=\"text\""+(type==="text"?" selected":"")+">✍️ Yazılı cavab</option></select>")
   +'<div class="dqcr-grp2" data-for="choice">'
   +fld("Variantlar (hər sətirdə biri)","<textarea id=\"dqcr-f-opts\" class=\"dqcr-in\" rows=\"4\" data-a=\"opts-in\" data-p=\"fl\" placeholder=\"Variant 1\nVariant 2\nVariant 3\">"+esc((e.opts||[]).join("\n"))+"</textarea>")
   +fld("Düzgün cavab","<select id=\"dqcr-f-c\" class=\"dqcr-in\" data-v=\""+(e.c!=null?e.c:0)+"\"></select>")+'</div>'
   +'<div class="dqcr-grp2" data-for="text">'
   +fld("Qəbul olunan cavab(lar)","<textarea id=\"dqcr-f-ans\" class=\"dqcr-in\" rows=\"3\" placeholder=\"Bakı\nBaki\">"+esc((e.answers||[]).join("\n"))+"</textarea>","Hər sətirdə bir variant. Böyük/kiçik hərf və ə, ı, ö, ü, ç, ş, ğ fərqi nəzərə alınmır.")+'</div>'
   +fld("İzah (ixtiyari)","<input id=\"dqcr-f-ex\" class=\"dqcr-in\" placeholder=\"Kartın arxasında göstərilir\" value=\""+esc(e.e||"")+"\">")
   +'<div class="dqcr-fl"><span>Rəng</span>'+swatches("fl")+'</div>'
   +'<div class="dqcr-row2"><button type="button" class="dqcr-b g" data-a="save-fl">💾 '+(isE?"Yadda saxla":"Sualı paylaş")+'</button>'+(isE?'<button type="button" class="dqcr-b" data-a="cancel" data-v="fl">Ləğv et</button>':'')+'</div></div>';
  h+='<div class="dqcr-card"><h4>🃏 Paylaşılan suallar <span class="dqcr-c">'+S.fl.length+'</span><button type="button" class="dqcr-mini" data-a="pv-fl">👁 Önizləmə</button></h4>';
  if(!S.fl.length)h+='<p class="dqcr-mt">Hələ sual paylaşılmayıb. 1 və ya daha çox sual əlavə edə bilərsiniz.</p>';
  S.fl.forEach(function(f,i){
    h+='<div class="dqcr-it'+(f.on===false?" off":"")+'"><span class="dqcr-sb" style="background:linear-gradient(135deg,'+th(f.th)[0]+','+th(f.th)[1]+')">'+(f.type==="text"?"✍️":"🔘")+'</span><div class="dqcr-itx"><b>'+esc(String(f.q).slice(0,70))+'</b><small>'+(f.type==="text"?"Yazılı cavab":"Variantlı • "+(f.opts||[]).length+" variant")+'</small></div>'
     +'<div class="dqcr-ia"><button type="button" data-a="up-fl" data-id="'+esc(f._id)+'"'+(i===0?" disabled":"")+'>↑</button><button type="button" data-a="dn-fl" data-id="'+esc(f._id)+'"'+(i===S.fl.length-1?" disabled":"")+'>↓</button>'
     +'<button type="button" data-a="edit-fl" data-id="'+esc(f._id)+'">✏️</button><button type="button" data-a="del-fl" data-id="'+esc(f._id)+'">🗑</button>'+sw(f.on!==false,"tg-fl",f._id,"")+'</div></div>';
  });
  return h+'</div>';
}
async function saveFl(){
  var q=g("dqcr-f-q").trim(),type=g("dqcr-f-type"),old=A.ed.fl;
  if(!q)return toast("Sualı yazın",true);
  var o={q:q,type:type,e:g("dqcr-f-ex").trim(),th:A.th.fl,on:old?old.on!==false:true,ord:old&&old.ord!=null?old.ord:Date.now()};
  if(type==="text"){
    var a=g("dqcr-f-ans").split("\n").map(function(s){return s.trim()}).filter(Boolean);
    if(!a.length)return toast("Ən azı bir düzgün cavab yazın",true);o.answers=a;
  }else{
    var opts=g("dqcr-f-opts").split("\n").map(function(s){return s.trim()}).filter(Boolean);
    if(opts.length<2)return toast("Ən azı 2 variant yazın",true);if(opts.length>6)return toast("Ən çox 6 variant ola bilər",true);
    o.opts=opts;o.c=Math.min(+g("dqcr-f-c")||0,opts.length-1);
  }
  await put("fl",o,old&&old._id);A.ed.fl=null;toast("Sual saxlanıldı ✅");
}

/* --- ortaq form köməkçiləri --- */
function syncCorrect(p){
  var ta=$("dqcr-"+(p==="sl"?"l":"f")+"-opts"),sel=$("dqcr-"+(p==="sl"?"l":"f")+"-c");if(!ta||!sel)return;
  var n=Math.max(2,ta.value.split("\n").map(function(s){return s.trim()}).filter(Boolean).length),keep=sel.value!==""?+sel.value:+sel.getAttribute("data-v")||0,h="";
  for(var i=0;i<Math.min(n,6);i++)h+='<option value="'+i+'"'+(i===keep?" selected":"")+'>'+LET[i]+'</option>';
  sel.innerHTML=h;
}
function toggleType(){
  var k=$("dqcr-l-kind"),f=$("dqcr-f-type");
  if(k)A.root.querySelectorAll('.dqcr-grp2[data-for="quiz"],.dqcr-grp2[data-for="info"]').forEach(function(x){x.style.display=x.getAttribute("data-for")===k.value?"":"none"});
  if(f)A.root.querySelectorAll('.dqcr-grp2[data-for="choice"],.dqcr-grp2[data-for="text"]').forEach(function(x){x.style.display=x.getAttribute("data-for")===f.value?"":"none"});
}
function find(k,id){return S[k].filter(function(x){return String(x._id)===String(id)})[0]}
async function swap(k,id,dir){
  var i=S[k].findIndex(function(x){return String(x._id)===String(id)}),j=i+dir;if(i<0||j<0||j>=S[k].length)return;
  var a=S[k][i],b=S[k][j],oa=a.ord!=null?a.ord:a._id,ob=b.ord!=null?b.ord:b._id;if(oa===ob)ob=oa+(dir>0?1:-1);
  await put(k,Object.assign({},a,{ord:ob}),a._id);await put(k,Object.assign({},b,{ord:oa}),b._id);
}
async function run(fn,okMsg){
  if(A.busy)return;A.busy=true;
  try{await fn();await refresh(true);if(okMsg)toast(okMsg)}catch(e){console.error("[DQCR]",e);toast("Xəta: "+(e&&e.message?e.message:e),true)}
  A.busy=false;draw();
}

function preview(kind){
  closePv();
  var list=(kind==="fl"?S.fl:S.sl).map(function(x){return Object.assign({},x,{on:true})});
  if(!list.length)return toast("Önizləmə üçün əvvəlcə əlavə edin",true);
  var d=document.createElement("div");d.id="dqcr-pv";d.innerHTML='<div class="dqcr-pvb"><button type="button" class="dqcr-x" aria-label="Bağla">✕</button><div class="dqcr-host" style="margin:0;padding:0;max-width:none"></div></div>';
  document.body.appendChild(d);A.pv=d;
  var host=d.querySelector(".dqcr-host");
  A.pvc=kind==="fl"?mountFlash(host,list,{preview:true}):mountStd(host,list,+S.cfg.auto||6000);
  d.addEventListener("click",function(e){if(e.target===d||e.target.closest(".dqcr-x"))closePv()});
}
function closePv(){if(A.pvc){try{A.pvc.destroy()}catch(e){}A.pvc=null}if(A.pv){A.pv.remove();A.pv=null}}

function build(){
  if(A.root)return;
  var d=document.createElement("div");d.id="dqcr-adm";d.setAttribute("role","dialog");d.setAttribute("aria-modal","true");
  d.innerHTML='<div class="dqcr-ap"></div>';document.body.appendChild(d);A.root=d;
  d.addEventListener("click",function(e){
    var b=e.target.closest("[data-a]");if(!b||b.tagName==="SELECT"||b.type==="checkbox")return;
    var a=b.getAttribute("data-a"),id=b.getAttribute("data-id"),v=b.getAttribute("data-v");
    if(a==="close")return close();
    if(a==="tab"){A.tab=v;draw();return}
    if(a==="cancel"){A.ed[v]=null;draw();return}
    if(a==="pal"){A.th[b.getAttribute("data-k")]=+b.getAttribute("data-i");d.querySelectorAll('.dqcr-pal button').forEach(function(x){x.classList.toggle("on",x===b)});return}
    if(a==="pv-sl")return preview("sl");if(a==="pv-fl")return preview("fl");
    if(a==="save-top")return run(saveTop);if(a==="save-sub")return run(saveSub);if(a==="save-sl")return run(saveSl);if(a==="save-fl")return run(saveFl);
    if(a==="cfg-flash")return run(function(){return saveCfg({flash:!S.cfg.flash})},S.cfg.flash?"Günün sualı deaktiv edildi":"⚡ Günün sualı ana səhifədə aktivdir");
    var map={top:"top",sub:"sub",sl:"sl",fl:"fl"},m=/^(edit|del|vis|up|dn)-(top|sub|sl|fl)$/.exec(a);
    if(!m)return;var op=m[1],k=map[m[2]],it=find(k,id);if(!it)return;
    if(op==="edit"){A.ed[k]=it;if(k!=="top"){var ti=it.th;if(k==="sub"){var ix=PAL.findIndex(function(p){return p[0]===it.c1});A.th.sub=ix<0?0:ix}else A.th[k]=+ti||0}draw();A.root.querySelector(".dqcr-ab").scrollTop=0;return}
    if(op==="del"){
      var msg=k==="sub"?"«"+it.name+"» fənni və ona aid əlavə edilmiş mövzular silinsin?":"Silinsin?";
      if(!confirm(msg))return;
      return run(async function(){
        if(k==="sub")for(var t of S.top.filter(function(x){return x.subject===it.name}))await del("top",t._id);
        await del(k,id);if(A.ed[k]&&String(A.ed[k]._id)===String(id))A.ed[k]=null;
      },"Silindi");
    }
    if(op==="vis")return run(function(){return put(k,Object.assign({},it,{hidden:!it.hidden}),id)});
    if(op==="up")return run(function(){return swap(k,id,-1)});if(op==="dn")return run(function(){return swap(k,id,1)});
  });
  d.addEventListener("change",function(e){
    var b=e.target,a=b.getAttribute&&b.getAttribute("data-a");if(!a)return;
    if(a==="cfg-std")return run(function(){return saveCfg({std:b.checked})},b.checked?"Karusel aktivləşdirildi":"Karusel deaktiv edildi");
    if(a==="cfg-pos")return run(function(){return saveCfg({pos:b.value})},"Yer yadda saxlanıldı");
    if(a==="cfg-auto")return run(function(){return saveCfg({auto:+b.value})},"Yadda saxlanıldı");
    if(a==="tg-sl"||a==="tg-fl"){var k=a==="tg-sl"?"sl":"fl",it=find(k,b.getAttribute("data-id"));if(!it)return;return run(function(){return put(k,Object.assign({},it,{on:b.checked}),it._id)},b.checked?"Aktiv edildi":"Deaktiv edildi")}
    if(a==="type-ch")toggleType();
  });
  d.addEventListener("input",function(e){
    var t=e.target;if(t.id==="dqcr-t-qs")qCount();
    if(t.getAttribute&&t.getAttribute("data-a")==="opts-in"){var p=t.getAttribute("data-p");var sel=$("dqcr-"+(p==="sl"?"l":"f")+"-c");if(sel)sel.setAttribute("data-v",sel.value);syncCorrect(p)}
  });
  document.addEventListener("keydown",function(e){if(e.key==="Escape"){if(A.pv)closePv();else if(A.root&&A.root.classList.contains("open"))close()}});
}
async function open(){
  build();A.cloud=await isCloud();A.root.classList.add("open");document.documentElement.style.overflow="hidden";
  draw();try{await refresh(true);draw()}catch(e){}
}
function close(){closePv();if(A.root)A.root.classList.remove("open");document.documentElement.style.overflow=""}

/* --- admin kartı --- */
function addCard(){
  var grid=document.querySelector("#admin-panel .admin-nav-grid");
  if($("dqcr-card"))return true;if(!grid)return false;
  var d=document.createElement("div");d.id="dqcr-card";d.className="admin-nav-card";d.style.cssText="background:linear-gradient(135deg,#f59e0b,#db2777);color:#fff";
  d.innerHTML='<span class="icon">🏠</span> Ana səhifə karuseli & Günün sualı';d.onclick=open;grid.appendChild(d);return true;
}

window.DQCR={open:open,close:close,refresh:refresh,data:S,mountFlash:mountFlash,mountStd:mountStd,parse:parseQs};

/* başlanğıc */
function init(){
  Home.update();refresh();
  var n=0,iv=setInterval(function(){n++;if(addCard()||n>40)clearInterval(iv)},500);
  /* admin panel yenidən qurulsa kartı bərpa et */
  var ap=$("admin-panel");if(ap)new MutationObserver(function(){if(!$("dqcr-card"))addCard()}).observe(ap,{childList:true,subtree:true});
  /* ana səhifəyə qayıdanda yeniləmə (≥60 san.) */
  var lastRef=Date.now();
  var sh=window.showScreen;
  if(typeof sh==="function"&&!sh.__dqcr){var w=function(id){var r=sh.apply(this,arguments);if(id==="v3-home"){Home.update();if(Date.now()-lastRef>60000){lastRef=Date.now();refresh()}}return r};w.__dqcr=1;try{window.showScreen=w;showScreen=w}catch(e){}}
}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init);else init();
})();
;

/* ===== krs-js ===== */
(function(){"use strict";
if(window.KRS)return;
/* KRS — Karusel idarəsi: fənn / mövzu / sual CRUD.
   Verilənlər: dq_v2_store, kolleksiya «krs_catalogue» (tək sənəd). Qeyd olunmayıbsa tlx-js-dəki ilkin siyahı işləyir. */
var COL="krs_catalogue",CACHE="krs_cache_v1",L="ABCDEF",$=function(i){return document.getElementById(i)};
var PAL=[["#7c3aed","#4c1d95"],["#2f63bd","#0a2f7a"],["#059669","#065f46"],["#ea580c","#7c2d12"],["#db2777","#831843"],["#0891b2","#164e63"],["#ca8a04","#713f12"],["#dc2626","#7f1d1d"]];
var esc=function(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})};
var clone=function(x){return JSON.parse(JSON.stringify(x))};
var S={id:null},E=null,root=null;

/* ---------- verilənlər ---------- */
function seed(){return clone(((window.TLX&&TLX.subjects)||[]).map(function(s){return{name:s.name,icon:s.icon,c1:s.grad[0],c2:s.grad[1],
  topics:(s.topics||[]).map(function(t){return{name:t.name,count:t.count||0,time:t.time||0,qs:t.questions||[]}})}}))}
function current(){var d=window.KRS_DATA;return clone(d&&d.subjects?d.subjects:seed())}
function light(h){var m=/^#?([0-9a-f]{6})$/i.exec(h||"");if(!m)return"#c4b5fd";var n=parseInt(m[1],16),f=function(v){return Math.round(v+(255-v)*.55)};
  return"#"+[n>>16&255,n>>8&255,n&255].map(function(v){return("0"+f(v).toString(16)).slice(-2)}).join("")}
function apply(d){var j=JSON.stringify(d),old=null;try{old=localStorage.getItem(CACHE)}catch(e){}
  window.KRS_DATA=d;try{localStorage.setItem(CACHE,j)}catch(e){}
  if(old!==j&&window.TLX&&TLX.refresh)TLX.refresh()}
async function load(){
  try{await V2.probe();var r=(await V2.list(COL))[0];
    if(r&&Array.isArray(r.subjects)){S.id=r._id;apply({subjects:r.subjects});return true}}catch(e){console.warn("[KRS]",e)}
  return false}

/* ---------- yoxlama və təmizləmə ---------- */
function qErr(q){if(!String(q.t||"").trim())return"mətn boşdur";var o=(q.o||[]).map(function(x){return String(x||"").trim()});
  if(o.some(function(x){return!x}))return"boş variant var";if(o.length<2)return"ən azı 2 variant lazımdır";
  if(!(q.c>=0&&q.c<o.length))return"düzgün cavab seçilməyib";return""}
function blank(q){return!String(q.t||"").trim()&&(q.o||[]).every(function(x){return!String(x||"").trim()})}
function prune(){E.subs.forEach(function(s){s.topics.forEach(function(t){t.qs=t.qs.filter(function(q){return!blank(q)})})})}
function check(){var p=[],sn={};
  E.subs.forEach(function(s,i){var a=(s.name||"").trim(),k=a.toLowerCase();
    if(!a)p.push("Fənn №"+(i+1)+": ad boşdur");else if(sn[k])p.push("«"+a+"» fənni təkrarlanır");sn[k]=1;
    var tn={};s.topics.forEach(function(t,j){var b=(t.name||"").trim(),kb=b.toLowerCase();
      if(!b)p.push(a+": mövzu №"+(j+1)+" adsızdır");else if(tn[kb])p.push(a+": «"+b+"» mövzusu təkrarlanır");tn[kb]=1;
      t.qs.forEach(function(q,n){var r=qErr(q);if(r)p.push(a+" › "+b+" › sual "+(n+1)+": "+r)})})});
  return p}
function clean(){return E.subs.map(function(s){return{name:s.name.trim(),icon:(s.icon||"📚").trim()||"📚",c1:s.c1,c2:s.c2,acc:light(s.c1),hidden:!!s.hidden,
  topics:s.topics.map(function(t){return{name:t.name.trim(),count:Math.max(0,+t.count||0),time:Math.max(0,+t.time||0),hidden:!!t.hidden,
    qs:t.qs.map(function(q){return Object.assign({t:q.t.trim(),o:q.o.map(function(x){return String(x).trim()}),c:q.c,e:(q.e||"").trim()},q.i?{i:q.i}:{})})}})}})}

/* ---------- toplu əlavə (mətndən sual ayırma) ---------- */
function parse(raw){var qs=[],c=null,m;
  String(raw||"").replace(/\r/g,"").split("\n").forEach(function(ln){ln=ln.trim();if(!ln)return;
    if(c&&(m=ln.match(/^(?:cavab|düzgün(?:\s+cavab)?)\s*[:=\-–]\s*\(?([A-Fa-f])\)?\.?$/i))){c.c=L.indexOf(m[1].toUpperCase());return}
    if(c&&(m=ln.match(/^(?:[İIi]zah|[Şş]ərh)\s*[:\-–]\s*(.+)$/i))){c.e=m[1];return}
    if(c&&(m=ln.match(/^\(?([A-Fa-f])[.)]\s*(.+)$/))&&c.o.length===L.indexOf(m[1].toUpperCase())){c.o.push(m[2]);return}
    if((m=ln.match(/^\d{1,3}\s*[.)\-]\s*(.+)$/))&&(!c||c.o.length>=2)){c={t:m[1],o:[],c:-1,e:""};qs.push(c);return}
    if(c){if(c.o.length)c.o[c.o.length-1]+=" "+ln;else c.t+=" "+ln}else{c={t:ln,o:[],c:-1,e:""};qs.push(c)}});
  return qs.filter(function(q){return q.o.length>=2})}

/* ---------- görünüş ---------- */
function sub(){return E.subs[E.si]}
function top(){var s=sub();return s&&s.topics[E.ti]}
function dirty(){E.dirty=true;var x=$("krs-st");if(x)x.textContent="● saxlanmamış dəyişikliklər"}
function chips(){return E.subs.map(function(s,i){return'<button type="button" data-a="ssel" data-i="'+i+'" class="'+(i===E.si?"on":"")+'">'+esc(s.icon)+" "+esc(s.name||"(adsız)")+(s.hidden?" 🚫":"")+"</button>"}).join("")+'<button type="button" class="add" data-a="sadd">＋ Fənn</button>'}
function subCard(s){return'<div class="krs-c"><h4>🗂️ Fənn parametrləri<span><button type="button" class="krs-bt sm" data-a="sl" '+(E.si?"":"disabled")+'>◀</button> <button type="button" class="krs-bt sm" data-a="sr" '+(E.si<E.subs.length-1?"":"disabled")+'>▶</button> <button type="button" class="krs-bt sm red" data-a="sdel">🗑 Sil</button></span></h4>'
  +'<div class="krs-g"><label>Fənnin adı<input class="krs-i" data-k="sname" value="'+esc(s.name)+'"></label><label>İkon (emoji)<input class="krs-i" data-k="sicon" maxlength="4" value="'+esc(s.icon)+'"></label>'
  +'<label>Rəng 1<input type="color" data-k="sc1" value="'+esc(s.c1)+'"></label><label>Rəng 2<input type="color" data-k="sc2" value="'+esc(s.c2)+'"></label>'
  +'<label class="ck"><input type="checkbox" data-k="sshow" '+(s.hidden?"":"checked")+'> Karuseldə göstər</label></div></div>'}
function topCard(s){var rows=s.topics.map(function(t,i){return'<div class="krs-t '+(i===E.ti?"on ":"")+(t.hidden?"off":"")+'"><div class="krs-tr"><input class="krs-i" data-k="tname" data-i="'+i+'" value="'+esc(t.name)+'" placeholder="Mövzunun adı">'
  +'<span class="krs-n">'+t.qs.length+' sual</span></div><div class="krs-tr"><label>Vaxt (dəq)<input type="number" min="0" class="krs-i" data-k="ttime" data-i="'+i+'" value="'+(t.time||"")+'" placeholder="avto"></label>'
  +'<label>Plan<input type="number" min="0" class="krs-i" data-k="tcount" data-i="'+i+'" value="'+(t.count||"")+'"></label></div>'
  +'<div class="krs-tr"><button type="button" class="krs-bt sm blue" data-a="tsel" data-i="'+i+'">✏️ Suallar</button><button type="button" class="krs-bt sm" data-a="tup" data-i="'+i+'" '+(i?"":"disabled")+'>↑</button><button type="button" class="krs-bt sm" data-a="tdn" data-i="'+i+'" '+(i<s.topics.length-1?"":"disabled")+'>↓</button>'
  +'<button type="button" class="krs-bt sm" data-a="tvis" data-i="'+i+'">'+(t.hidden?"👁 Göstər":"🙈 Gizlət")+'</button><button type="button" class="krs-bt sm red" data-a="tdel" data-i="'+i+'">🗑</button></div></div>'}).join("");
  return'<div class="krs-c"><h4>📚 Mövzular ('+s.topics.length+')<button type="button" class="krs-bt sm pri" data-a="tadd">＋ Mövzu</button></h4>'+(rows||'<div class="krs-em">Bu fənndə hələ mövzu yoxdur.</div>')+'</div>'}
function qCard(q,n){var o=q.o.map(function(x,k){return'<div class="krs-o"><input type="radio" name="c'+n+'" data-k="qc" data-q="'+n+'" data-o="'+k+'" '+(q.c===k?"checked":"")+' title="Düzgün cavab"><em>'+L[k]+'</em>'
  +'<input class="krs-i" data-k="qo" data-q="'+n+'" data-o="'+k+'" value="'+esc(x)+'" placeholder="Variant '+L[k]+'"><button type="button" class="krs-bt sm red" data-a="odel" data-q="'+n+'" data-o="'+k+'" '+(q.o.length>2?"":"disabled")+'>✕</button></div>'}).join("");
  return'<div class="krs-q '+(qErr(q)?"bad":"")+'"><div class="krs-qh"><span>Sual '+(n+1)+'</span><span><button type="button" class="krs-bt sm" data-a="qup" data-q="'+n+'">↑</button> <button type="button" class="krs-bt sm" data-a="qdn" data-q="'+n+'">↓</button> <button type="button" class="krs-bt sm red" data-a="qdel" data-q="'+n+'">🗑</button></span></div>'
  +'<textarea rows="2" data-k="qt" data-q="'+n+'" placeholder="Sualın mətni">'+esc(q.t)+'</textarea>'+o
  +'<div class="krs-tr" style="margin-top:8px"><button type="button" class="krs-bt sm" data-a="oadd" data-q="'+n+'" '+(q.o.length<6?"":"disabled")+'>＋ Variant</button><input class="krs-i" data-k="qe" data-q="'+n+'" value="'+esc(q.e)+'" placeholder="İzah (ixtiyari)"></div></div>'}
function qList(){var t=top();if(!t)return"";var f=E.q.trim().toLowerCase(),h=t.qs.map(function(q,n){return!f||String(q.t).toLowerCase().indexOf(f)>-1?qCard(q,n):""}).join("");
  return h||'<div class="krs-em">'+(t.qs.length?"Axtarışa uyğun sual tapılmadı.":"Bu mövzuda hələ sual yoxdur. «＋ Sual» və ya «📥 Toplu əlavə» ilə başlayın.")+"</div>"}
function qBlock(){var t=top();if(!t)return'<div class="krs-c"><div class="krs-em">Sualları redaktə etmək üçün mövzunun yanındakı «✏️ Suallar» düyməsini seçin.</div></div>';
  return'<div class="krs-c"><h4>❓ Suallar — '+esc(t.name||"(adsız)")+' ('+t.qs.length+')<span><button type="button" class="krs-bt sm pri" data-a="qadd">＋ Sual</button> <button type="button" class="krs-bt sm blue" data-a="bulk">📥 Toplu əlavə</button></span></h4>'
  +(E.bulk?'<div class="krs-c" style="background:#f8fafc"><small style="display:block;margin-bottom:6px;color:#475569">Format: «1. Sual», sonra «A) …», «B) …», «Cavab: B», istəyə görə «İzah: …». Hər sual ayrı blokda.</small><textarea id="krs-bt" rows="9"></textarea><div class="krs-tr" style="margin-top:8px"><button type="button" class="krs-bt blue" data-a="bgo">Əlavə et</button><button type="button" class="krs-bt" data-a="bx">Ləğv et</button></div></div>':"")
  +'<div class="krs-bar"><input class="krs-i" data-k="srch" placeholder="🔍 Suallarda axtar…" value="'+esc(E.q)+'"></div><div id="krs-qs">'+qList()+"</div></div>"}
function draw(){var b=root.querySelector(".krs-b"),y=b.scrollTop,s=sub();
  b.innerHTML='<div class="krs-c"><div class="krs-chips" id="krs-chips">'+chips()+"</div></div>"+(s?subCard(s)+topCard(s)+qBlock():'<div class="krs-c"><div class="krs-em">Hələ fənn yoxdur. «＋ Fənn» ilə əlavə edin.</div></div>');
  b.scrollTop=y}

/* ---------- əməliyyatlar ---------- */
function mv(a,i,d){var j=i+d;if(j<0||j>=a.length)return false;var x=a[i];a[i]=a[j];a[j]=x;return true}
async function save(){prune();var p=check();
  if(p.length){alert("Yadda saxlamaq üçün düzəldin:\n\n• "+p.slice(0,8).join("\n• ")+(p.length>8?"\n… və daha "+(p.length-8)+" xəta":""));draw();return}
  var btn=root.querySelector('[data-a="save"]');btn.disabled=true;
  try{var d={subjects:clean(),v:2,at:new Date().toISOString()};await V2.probe();await V2.put(COL,d,S.id||void 0);
    if(!S.id){var r=(await V2.list(COL))[0];S.id=r&&r._id}
    apply({subjects:d.subjects});E.dirty=false;$("krs-st").textContent="✅ saxlanıldı";V2.toast("Karusel yeniləndi ✅");draw()}
  catch(e){alert("Saxlanmadı: "+(e&&e.message||e))}btn.disabled=false}
function close(f){if(E&&E.dirty&&!f&&!confirm("Saxlanmamış dəyişikliklər itəcək. Bağlansın?"))return;root.classList.remove("open");document.documentElement.style.overflow=""}
function act(a,el){var s=sub(),t=top(),i=+el.dataset.i,n=+el.dataset.q,o=+el.dataset.o,q=t&&t.qs[n];
  switch(a){
  case"close":return close();
  case"save":return save();
  case"reset":if(!confirm("Bütün dəyişikliklər ilkin siyahı ilə əvəz olunsun? (Yadda saxlayana qədər saytda dəyişmir.)"))return;E.subs=seed();E.si=0;E.ti=-1;dirty();break;
  case"ssel":E.si=i;E.ti=E.subs[i].topics.length?0:-1;E.q="";E.bulk=false;break;
  case"sadd":var p=PAL[E.subs.length%PAL.length];E.subs.push({name:"Yeni fənn",icon:"📚",c1:p[0],c2:p[1],topics:[]});E.si=E.subs.length-1;E.ti=-1;dirty();break;
  case"sdel":if(!confirm("«"+s.name+"» fənni və bütün mövzu/sualları silinsin?"))return;E.subs.splice(E.si,1);E.si=Math.max(0,E.si-1);E.ti=-1;dirty();break;
  case"sl":if(mv(E.subs,E.si,-1)){E.si--;dirty()}break;
  case"sr":if(mv(E.subs,E.si,1)){E.si++;dirty()}break;
  case"tadd":s.topics.push({name:"Yeni mövzu",count:0,time:0,qs:[]});E.ti=s.topics.length-1;E.q="";dirty();break;
  case"tsel":E.ti=i;E.q="";E.bulk=false;break;
  case"tdel":if(!confirm("«"+s.topics[i].name+"» mövzusu və "+s.topics[i].qs.length+" sualı silinsin?"))return;s.topics.splice(i,1);E.ti=Math.min(E.ti,s.topics.length-1);dirty();break;
  case"tup":if(mv(s.topics,i,-1)){E.ti=i-1;dirty()}break;
  case"tdn":if(mv(s.topics,i,1)){E.ti=i+1;dirty()}break;
  case"tvis":s.topics[i].hidden=!s.topics[i].hidden;dirty();break;
  case"qadd":t.qs.push({t:"",o:["","","",""],c:-1,e:""});E.q="";dirty();break;
  case"qdel":if(!confirm("Sual "+(n+1)+" silinsin?"))return;t.qs.splice(n,1);dirty();break;
  case"qup":mv(t.qs,n,-1)&&dirty();break;
  case"qdn":mv(t.qs,n,1)&&dirty();break;
  case"oadd":if(q.o.length<6){q.o.push("");dirty()}break;
  case"odel":if(q.o.length>2){q.o.splice(o,1);q.c=q.c===o?-1:q.c>o?q.c-1:q.c;dirty()}break;
  case"bulk":E.bulk=!E.bulk;break;
  case"bx":E.bulk=false;break;
  case"bgo":var r=parse($("krs-bt").value);if(!r.length)return alert("Sual tapılmadı. Format: «1. Sual», «A) …», «B) …», «Cavab: B».");
    r.forEach(function(x){t.qs.push(x)});E.bulk=false;dirty();V2.toast(r.length+" sual əlavə olundu ✅");break;
  default:return}
  draw();
  if(a==="tadd"||a==="qadd"||a==="sadd"){var f=root.querySelector(a==="qadd"?".krs-q:last-child textarea":a==="tadd"?".krs-t.on [data-k=tname]":'[data-k=sname]');if(f){f.focus();f.select&&a!=="qadd"&&f.select();f.scrollIntoView({block:"center"})}}}
function onInput(e){var el=e.target,k=el.dataset.k;if(!k||!E)return;var s=sub(),t=top(),i=+el.dataset.i,n=+el.dataset.q,o=+el.dataset.o,q=t&&t.qs[n],v=el.value;
  if(k==="srch"){E.q=v;$("krs-qs").innerHTML=qList();return}
  if(k==="sname"){s.name=v;$("krs-chips").innerHTML=chips()}
  else if(k==="sicon"){s.icon=v;$("krs-chips").innerHTML=chips()}
  else if(k==="sc1")s.c1=v;else if(k==="sc2")s.c2=v;
  else if(k==="sshow"){s.hidden=!el.checked;$("krs-chips").innerHTML=chips()}
  else if(k==="tname")s.topics[i].name=v;else if(k==="ttime")s.topics[i].time=+v||0;else if(k==="tcount")s.topics[i].count=+v||0;
  else if(k==="qt")q.t=v;else if(k==="qe")q.e=v;else if(k==="qo")q.o[o]=v;else if(k==="qc")q.c=o;else return;
  if(q){var c=el.closest(".krs-q");c&&c.classList.toggle("bad",!!qErr(q))}
  dirty()}

/* ---------- qurulum ---------- */
function build(){if(root)return;root=document.createElement("div");root.id="krs-root";root.className="krs-ov";root.setAttribute("role","dialog");root.setAttribute("aria-label","Karusel idarəsi");
  root.innerHTML='<div class="krs-p"><div class="krs-h"><div><b>🎠 Karusel — fənn testləri</b><small>Fənn, mövzu və sualların idarəsi · <span id="krs-st" class="krs-st"></span></small></div><div class="krs-ha"><button type="button" class="krs-bt" data-a="reset" title="İlkin siyahı">↺</button><button type="button" class="krs-bt pri" data-a="save">💾 Saxla</button><button type="button" class="krs-bt" data-a="close" aria-label="Bağla">✕</button></div></div><div class="krs-b"></div></div>';
  document.body.appendChild(root);
  root.addEventListener("click",function(e){var b=e.target.closest("[data-a]");if(b&&!b.disabled)act(b.dataset.a,b)});
  root.addEventListener("input",onInput);root.addEventListener("change",onInput);
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&root.classList.contains("open"))close()})}
async function open(){build();await load();E={subs:current(),si:0,ti:-1,q:"",bulk:false,dirty:false};
  E.subs.forEach(function(s){s.topics=s.topics||[];s.topics.forEach(function(t){t.qs=t.qs||[]})});
  if(E.subs[0]&&E.subs[0].topics.length)E.ti=0;$("krs-st").textContent="";root.classList.add("open");document.documentElement.style.overflow="hidden";draw()}
function addCard(){var g=document.querySelector("#admin-panel .admin-nav-grid");if($("krs-card"))return true;if(!g)return false;
  var d=document.createElement("div");d.id="krs-card";d.className="admin-nav-card";d.style.cssText="background:linear-gradient(135deg,#0a2f7a,#d9a441);color:#fff";
  d.innerHTML='<span class="icon">🎠</span> Karusel — fənn testləri';d.onclick=open;g.appendChild(d);return true}
window.KRS={open:open,close:close,parse:parse,_t:{check:check,clean:clean,qErr:qErr}};
var n=0,iv=setInterval(function(){if(typeof V2!=="undefined"&&window.TLX){clearInterval(iv);load()}else if(++n>120)clearInterval(iv)},250);
var m=0,iv2=setInterval(function(){if(addCard()||++m>40)clearInterval(iv2)},500);
var ap=$("admin-panel");if(ap)new MutationObserver(function(){if(!$("krs-card"))addCard()}).observe(ap,{childList:true,subtree:true});
})();
;

/* ===== dq-studio-css ===== */
window.__DQS_CSS="#dqs-fab{position:fixed;left:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:100010;border:0;border-radius:99px;padding:13px 20px;font:800 14px inherit;color:#fff;background:#1e1b4b;box-shadow:0 10px 24px #0006;cursor:pointer}\n#dqs-fab[hidden],#dqs[hidden]{display:none}\n#dqs{position:fixed;left:0;right:0;bottom:0;z-index:100011;max-height:46vh;overflow:auto;background:#fff;color:#1e1b4b;border-radius:20px 20px 0 0;box-shadow:0 -10px 40px #0004;padding:10px 14px calc(14px + env(safe-area-inset-bottom,0px));font:600 13px inherit}\n#dqs *{box-sizing:border-box}\n#dqs .r{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:6px 0}\n#dqs .t{font-weight:800;flex:1}\n#dqs button{border:1px solid #d9dcf3;background:#f6f6fd;border-radius:10px;padding:8px 11px;font:700 13px inherit;color:#1e1b4b;cursor:pointer}\n#dqs button.p{background:#1e1b4b;color:#fff;border-color:#1e1b4b}\n#dqs button.d{background:#fee2e2;border-color:#fecaca;color:#b91c1c}\n#dqs button:disabled{opacity:.4}\n#dqs label{display:flex;align-items:center;gap:6px}\n#dqs input[type=number]{width:62px;padding:7px;border:1px solid #d9dcf3;border-radius:8px}\n#dqs input[type=color]{width:34px;height:34px;padding:0;border:1px solid #d9dcf3;border-radius:8px;background:none}\n#dqs input[type=range]{width:90px}\n#dqs .s{color:#64748b;font-size:12px}\nhtml.dqs-on [data-dqs-hover]{outline:2px dashed #6366f1!important;outline-offset:1px}\nhtml.dqs-on .dqs-sel{outline:3px solid #6366f1!important;outline-offset:1px}\nhtml.dqs-on [contenteditable=true]{outline:3px solid #16a34a!important;cursor:text}\nhtml.dqs-on .dqs-ghost{display:revert!important;opacity:.35!important}\n";
;

/* ===== dq-studio ===== */
/* DQ Studio — canlı sayt redaktoru: hamıya qaydaları tətbiq edir, yalnız admin üçün redaktə rejimi açır */
(function(){"use strict";
var COL="sitecms",UI="#dqs,#dqs-fab,#dqs-h",SKIP="html,body,head,script,style,#dqs,#dqs-fab,#dqs-h,#dqs *,input,textarea,select",SELSKIP="html,body,head,script,style,#dqs,#dqs-fab,#dqs-h,#dqs *";
var S={id:null,rules:{},on:false,sel:null,undo:[],redo:[],timer:0,ready:false,mv:true,dragged:false,grp:(function(){try{return localStorage.getItem("dqs_grp")==="1"}catch(e){return false}})()};
var $=function(q,r){return(r||document).querySelector(q)};
var admin=function(){return window.__dqAuthed===true};
function key(el){var p=[],n=el;while(n&&n.nodeType===1&&n!==document.body){if(n.id&&!/\d{5,}/.test(n.id)){p.unshift("#"+n.id);break}
  p.unshift(n.tagName.toLowerCase()+":nth-child("+(Array.prototype.indexOf.call(n.parentNode.children,n)+1)+")");n=n.parentNode}return p.join(">")}
function find(k){try{return document.querySelector(k)}catch(e){return null}}
function put(el,css){Object.keys(css).forEach(function(p){var v=css[p];v===""||v==null?el.style.removeProperty(p):el.style.setProperty(p,v,"important")})}
function paint(el,r){
  r.css&&put(el,r.css);
  if(r.hide)el.style.setProperty("display",S.on?"":"none","important"),el.classList.toggle("dqs-ghost",!!S.on);
  else{el.classList.remove("dqs-ghost");r.css&&r.css.display||el.style.removeProperty("display")}
  if(r.text!=null&&!el.children.length){el.setAttribute("data-dqs","1");el.textContent!==r.text&&(el.textContent=r.text)}
  if(r.ph!=null&&/^(INPUT|TEXTAREA)$/.test(el.tagName)&&el.placeholder!==r.ph)el.placeholder=r.ph;
  if(r.src&&el.tagName==="IMG"&&el.getAttribute("src")!==r.src){el.removeAttribute("srcset");el.src=r.src}
  if(r.bg&&el.tagName!=="IMG"){el.style.setProperty("background-image","url("+r.bg+")","important");el.style.setProperty("background-size","cover","important")}
  if(r.pos!=null&&el.parentNode){var par=el.parentNode,cur=Array.prototype.indexOf.call(par.children,el);
    if(cur!==r.pos&&r.pos<par.children.length)par.insertBefore(el,par.children[r.pos>cur?r.pos+1:r.pos])}}
function applyAll(){Object.keys(S.rules).forEach(function(k){var el=find(k);el&&!el.matches(UI)&&paint(el,S.rules[k])})}
async function load(){try{var l=await V2.list(COL);if(l&&l[0]){S.id=l[0]._id;S.rules=l[0].rules||{}}}catch(e){}S.ready=true;applyAll()}
function save(){clearTimeout(S.timer);status("Saxlanır…");S.timer=setTimeout(async function(){try{await V2.put(COL,{rules:S.rules,t:Date.now()},S.id);if(!S.id){var l=await V2.list(COL);S.id=l[0]&&l[0]._id}status("Saxlanıldı ✓")}catch(e){status("Xəta: saxlanmadı")}},500)}
function snap(){S.undo.push(JSON.stringify(S.rules));S.undo.length>60&&S.undo.shift();S.redo=[]}
function group(el){var p=el&&el.parentNode;if(!p||!p.children)return[el];var c=String(el.className||"").split(/\s+/).filter(function(x){return x&&x.indexOf("dqs-")!==0})[0];var l=Array.prototype.filter.call(p.children,function(x){return x.tagName===el.tagName&&(!c||x.classList.contains(c))&&!x.matches(SELSKIP)});return l.length?l:[el]}
function rule(el){var k=key(el);return S.rules[k]||(S.rules[k]={})}
function edit(el,fn){snap();var r=rule(el);fn(r);paint(el,r);save();render()}
function restore(js){S.rules=JSON.parse(js);location.reload()}
function status(t){var s=$("#dqs .s");s&&(s.textContent=t)}
function img(file,cb){var fr=new FileReader();fr.onload=function(){var i=new Image();i.onload=function(){var m=1000,k=Math.min(1,m/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=i.width*k;c.height=i.height*k;c.getContext("2d").drawImage(i,0,0,c.width,c.height);cb(c.toDataURL(file.type==="image/png"?"image/png":"image/jpeg",.82))};i.src=fr.result};fr.readAsDataURL(file)}
function pick(){var f=document.createElement("input");f.type="file";f.accept="image/*";return new Promise(function(ok){f.onchange=function(){f.files[0]&&img(f.files[0],ok)};f.click()})}
function css(el,p){return el.style.getPropertyValue(p)||getComputedStyle(el).getPropertyValue(p)}
function hex(c){var m=String(c).match(/\d+/g);return m?"#"+m.slice(0,3).map(function(n){return(+n).toString(16).padStart(2,"0")}).join(""):"#000000"}
function render(){var d=$("#dqs");if(!d)return;var el=S.sel,hid=Object.keys(S.rules).filter(function(k){return S.rules[k].hide});
  var h='<div class="r"><span class="t">🎨 Dizayn Studiyası</span><button data-a="un" '+(S.undo.length?"":"disabled")+'>↶</button><button data-a="re" '+(S.redo.length?"":"disabled")+'>↷</button><button data-a="q">📝 Suallar</button><button class="p" data-a="off">Bitir</button><button class="d" data-a="out">Çıxış</button></div><div class="r"><button class="d" data-a="all">⟲ Bütün dəyişiklikləri sıfırla (başlanğıc vəziyyət)</button></div><div class="s">'+(S.status||"")+'</div>'+modeRow();
  if(!el)h+='<div class="s">Redaktə etmək üçün səhifədə istənilən yazıya və ya şəklə toxunun. Yazını dəyişmək üçün iki dəfə toxunun.</div>';
  else{var leaf=!el.children.length,im=el.tagName==="IMG",cs=getComputedStyle(el);
    h+='<div class="r s">Seçilmiş: &lt;'+el.tagName.toLowerCase()+"&gt;"+(leaf?" · "+(el.textContent||"").trim().slice(0,28):"")+'</div><div class="r">'
    +(leaf&&!im?'<button data-a="txt">✏️ Mətn</button>':"")+'<button data-a="img">🖼 Şəkil</button><button data-a="up">⬆</button><button data-a="dn">⬇</button><button data-a="par">⤴ Üst blok</button><button data-a="hide">'+((S.rules[key(el)]||{}).hide?"👁 Göstər":"🙈 Gizlət")+'</button><button class="d" data-a="del">🗑 Sil</button><button data-a="rst">Sıfırla</button></div>'
    +'<div class="r"><label>Rəng<input type="color" data-p="color" value="'+hex(cs.color)+'"></label><label>Fon<input type="color" data-p="background-color" value="'+hex(cs.backgroundColor)+'"></label><label>Ölçü<input type="number" min="8" max="96" data-p="font-size" value="'+parseInt(cs.fontSize)+'"></label><label>Künc<input type="number" min="0" max="80" data-p="border-radius" value="'+(parseInt(cs.borderRadius)||0)+'"></label><label>Şəffaflıq<input type="range" min="0" max="1" step=".05" data-p="opacity" value="'+cs.opacity+'"></label></div>'
    +'<div class="r"><button data-a="b">B</button><button data-a="l">⟸</button><button data-a="c">≡</button><button data-a="rt">⟹</button></div>'+moveRow(el)}
  if(hid.length)h+='<div class="r s">Gizlədilənlər: '+hid.map(function(k,i){var x=find(k),t=x?String(x.textContent||x.placeholder||"").trim().replace(/[<>&"]/g,"").slice(0,14):"";return'<button data-a="show" data-k="'+i+'">↺ '+(t||i+1)+"</button>"}).join("")+"</div>";
  d.innerHTML=h;d.__hid=hid}
function setSel(el){S.sel&&S.sel.classList.remove("dqs-sel");S.sel=el;el&&el.classList.add("dqs-sel");render()}
function startText(el){el.setAttribute("data-dqs","1");el.contentEditable="true";el.focus();el.onblur=function(){el.contentEditable="false";el.onblur=null;var t=el.textContent;t!==(S.rules[key(el)]||{}).text&&edit(el,function(r){r.text=t})}}
function onClick(e){if(!S.on||e.target.closest(UI))return;if(S.dragged){e.preventDefault();e.stopPropagation();return}e.preventDefault();e.stopPropagation();var el=e.target;if(el.matches(SELSKIP))return;
  if(el.isContentEditable)return;setSel(el)}
function onDbl(e){if(!S.on||e.target.closest(UI))return;var el=e.target;if(!el.children.length&&!el.matches("img,"+SKIP)){e.preventDefault();setSel(el);startText(el)}}
function onOver(e){if(!S.on)return;var o=$("[data-dqs-hover]");o&&o.removeAttribute("data-dqs-hover");var t=e.target;t.closest&&!t.closest(UI)&&!t.matches(SELSKIP)&&t.setAttribute("data-dqs-hover","")}
function onPanel(e){var b=e.target.closest("button");if(!b)return;var a=b.dataset.a,el=S.sel;
  if(a==="off")return toggle(false);
  if(a==="all"){if(!Object.keys(S.rules).length&&!S.undo.length){status("Sıfırlanacaq dəyişiklik yoxdur");return}
    if(!confirm("Bütün dizayn dəyişiklikləri (yer, ölçü, rəng, mətn, şəkil, gizlədilənlər) silinsin və sayt başlanğıc vəziyyətinə qayıtsın?\nBu əməliyyat geri qaytarılmır."))return;
    clearTimeout(S.timer);status("Sıfırlanır…");
    Promise.resolve(V2.put(COL,{rules:{},t:Date.now()},S.id)).then(function(){S.rules={};S.undo=[];S.redo=[];location.reload()},function(){status("Xəta: sıfırlanmadı")});return}
  if(a==="q")return window.DQStudio.liveEdit();
  if(a==="out"){try{localStorage.removeItem("dq_adm_tok");localStorage.removeItem("dq_admin_logged")}catch(e){}return location.reload()}
  if(a==="un"||a==="re"){var from=a==="un"?S.undo:S.redo,to=a==="un"?S.redo:S.undo;if(!from.length)return;to.push(JSON.stringify(S.rules));S.rules=JSON.parse(from.pop());save();setTimeout(function(){location.reload()},700);return}
  if(a==="show"){var k=d().__hid[+b.dataset.k];snap();delete S.rules[k].hide;var x=find(k);x&&(x.style.removeProperty("display"),x.classList.remove("dqs-ghost"));save();render();return}
  if(a==="grp"){S.grp=!S.grp;try{localStorage.setItem("dqs_grp",S.grp?"1":"0")}catch(e){}return render()}
  if(a==="svc"){var se=svcEl();if(!se)return;snap();var sr=rule(se);if(sr.hide)delete sr.hide;else sr.hide=true;paint(se,sr);save();render();return}
  if(a==="mv"){S.mv=!S.mv;document.documentElement.classList.toggle("dqs-mv",S.on&&S.mv);return render()}
