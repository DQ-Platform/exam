        <div id="sx-rev-${m}" style="display:none"><h5 id="sx-cnt-${m}" class="mb-2"></h5><div id="sx-list-${m}"></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap" class="mt-3"><button class="btn btn-primary" style="flex:1;min-width:200px" onclick="SX.preview('${m}',0)">👁 Ön baxış — istifadəçi necə görəcək</button><button class="btn btn-success" style="flex:1;min-width:200px" onclick="SX.save('${m}')">🚀 Hamısını Bazaya Yüklə</button></div></div>`,$("mod-pdfauto").after(box)})}async function load(file,prog){const pages=[];if(file.type==="application/pdf"){const pdf=await pdfjsLib.getDocument(new Uint8Array(await file.arrayBuffer())).promise;for(let i=1;i<=pdf.numPages;i++){prog(`Səhifə ${i}/${pdf.numPages} hazırlanır...`,i/pdf.numPages*.4);const pg=await pdf.getPage(i),vp=pg.getViewport({scale:2.5}),cv=document.createElement("canvas");cv.width=vp.width,cv.height=vp.height,await pg.render({canvasContext:cv.getContext("2d"),viewport:vp}).promise;const words=(await pg.getTextContent()).items.filter(t=>t.str.trim()).map(t=>{const m=pdfjsLib.Util.transform(vp.transform,t.transform),h=Math.hypot(m[2],m[3]);return{str:t.str,x:m[4],y:m[5]-h,w:t.width*2.5,h}});pages.push({cv,words})}}else{const img=new Image;img.src=URL.createObjectURL(file),await img.decode();const cv=document.createElement("canvas");cv.width=img.naturalWidth,cv.height=img.naturalHeight,cv.getContext("2d").drawImage(img,0,0),pages.push({cv,words:[]})}for(let i=0;i<pages.length;i++){if(pages[i].words.length>=15)continue;prog(`Skan səhifə OCR ilə oxunur (${i+1}/${pages.length})...`,.4+i/pages.length*.5);const c0=pages[i].cv,k=c0.width<1800?2:1;let src=c0;if(k>1){src=document.createElement("canvas"),src.width=c0.width*k,src.height=c0.height*k;const cx=src.getContext("2d");cx.fillStyle="#fff",cx.fillRect(0,0,src.width,src.height),cx.drawImage(c0,0,0,src.width,src.height)}const r=await Tesseract.recognize(src,"aze+eng");pages[i].words=r.data.words.filter(w=>w.text.trim()).map(w=>({str:w.text,x:w.bbox.x0/k,y:w.bbox.y0/k,w:(w.bbox.x1-w.bbox.x0)/k,h:(w.bbox.y1-w.bbox.y0)/k}))}return pages}const toLines=words=>{const L=