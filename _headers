# DQ Platform — keşləmə qaydaları (Cloudflare static assets, Brotli/gzip avtomatik).
# Skriptlər index.html-də ?v=N ilə çağırılır: fayl dəyişəndə N-i artırın.
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/service-worker.js
  Cache-Control: no-cache
/worker.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: public, max-age=86400
